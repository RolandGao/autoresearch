# Input-conditioned head at BS 125 and 500 on the tuned SGD configs: a seed-0
# global_neighbour_seeds search of the four LRs and momenta plus the head's
# damping, then 8 runs of its optimum on held-out seeds 100-107. The head starts
# from baseline_bs2000_head_input_conditioned, its LR scaled by the tuned SGD head
# LR relative to BS 2000's (1300).
for batch_size in (125, 500):
    config = copy.deepcopy(RUN_CONFIGS[f"seeded_best_bs{batch_size}_sgd"])
    head = config["param_groups"]["head"]
    head_lr = round_hparam(10000 * head["lr_scheduler"][0][1] / 1300)
    config["param_groups"]["head"] = dict(
        algorithm="input_conditioned",
        lr_scheduler=scale_lr_schedule(head["lr_scheduler"], head_lr),
        momentum=0.8, nesterov=True, svd_mean_percentage_damping=0.01,
        input_conditioner_momentum=0.0, gradient_momentum_before_conditioning=False,
    )
    config = seeded_search(config, [0], ())
    config["hparam_tuning"]["params"]["head.svd_mean_percentage_damping"] = dict(
        initial=0.01, choices=None, mult=0.6
    )
    RUN_CONFIGS[f"seeds1_bs{batch_size}_input_conditioned"] = config

# interval2: interval search of conv LR and momentum whose cooldown searches one
# multiplier applied to every group's LR (searched groups: their main-interval LR;
# others: their mean LR over the main interval), held constant in the cooldown.
# Bases: the best held-out configs per BS. interval_best_* reruns the original
# interval search on the same bases as a control (BS 2000's base is unchanged).
INTERVAL_BASES = {
    2000: "baseline_bs2000", 500: "seeded_best_bs500_sgd", 125: "seeded_best_bs125_adam",
}
for batch_size, base_name in INTERVAL_BASES.items():
    for algorithm, prefix in (("interval2", "interval2"), ("interval", "interval_best")):
        if algorithm == "interval" and batch_size == 2000:
            continue
        for interval_fraction, cooldown_fraction in ((5, 5), (5, 20), (20, 20)):
            config = copy.deepcopy(RUN_CONFIGS[base_name])
            conv = config["param_groups"]["conv"]
            total = conv["lr_scheduler"][0][0]
            interval_steps = total // interval_fraction
            cooldown_steps = total // cooldown_fraction
            config["hparam_tuning"] = dict(
                algorithm=algorithm,
                metric="tta_val_acc",
                max_side_steps=20,
                initial_dropoff_margin=0.02,
                interval_steps=interval_steps,
                cooldown_steps=cooldown_steps,
                params={
                    "conv.initial_lr": dict(
                        initial=conv["lr_scheduler"][0][1], choices=None, mult=0.6
                    ),
                    "conv.momentum": dict(
                        initial=conv["momentum"], choices=list(MOMENTUM_CHOICES)
                    ),
                },
            )
            if algorithm == "interval2":
                config["hparam_tuning"]["cooldown_lr_mult"] = dict(initial=1.0, mult=0.6)
            RUN_CONFIGS[
                f"{prefix}_bs{batch_size}_interval{interval_steps}_cooldown{cooldown_steps}"
            ] = config

# Overfit mode at BS 2000: 20 or 10 steps on one fixed batch, scored by its
# training loss (neg_train_loss). overfit_bs2000[_steps10] is baseline_bs2000
# squeezed into those steps (whitening bias for the first 3/8). The original interval
# search (conv LR and momentum) runs every interval 1-4 x cooldown 0-4 steps.
for steps, suffix in ((20, ""), (10, "_steps10")):
    config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
    config.update(num_epochs=steps, overfit=True)
    for name, group in config["param_groups"].items():
        lr = group["lr_scheduler"][0][1]
        group["lr_scheduler"] = [(steps, lr, 0.0)] if lr else [(steps, 0.0)]
    bias_steps = 3 * steps // 8
    config["param_groups"]["whiten_bias"]["lr_scheduler"] = [
        (bias_steps, 36, 0.0), (steps - bias_steps, 0.0)
    ]
    RUN_CONFIGS[f"overfit_bs2000{suffix}"] = config
    for interval_steps, cooldown_steps in product(range(1, 5), range(0, 5)):
        config = copy.deepcopy(RUN_CONFIGS[f"overfit_bs2000{suffix}"])
        conv = config["param_groups"]["conv"]
        config["hparam_tuning"] = dict(
            algorithm="interval",
            metric="neg_train_loss",
            max_side_steps=20,
            initial_dropoff_margin=0.02,
            interval_steps=interval_steps,
            cooldown_steps=cooldown_steps,
            params={
                "conv.initial_lr": dict(
                    initial=conv["lr_scheduler"][0][1], choices=None, mult=0.6
                ),
                "conv.momentum": dict(initial=conv["momentum"], choices=list(MOMENTUM_CHOICES)),
            },
        )
        RUN_CONFIGS[
            f"overfit_interval_bs2000{suffix}_interval{interval_steps}_cooldown{cooldown_steps}"
        ] = config

# The same 10-step overfit grid, also searching the head and both bias LRs (head,
# norm_bias, whiten_bias) alongside conv LR and momentum. Searched LRs are constant
# within each interval, replacing those groups' decaying schedules.
for interval_steps, cooldown_steps in product(range(1, 5), range(0, 5)):
    config = copy.deepcopy(
        RUN_CONFIGS[
            f"overfit_interval_bs2000_steps10_interval{interval_steps}_cooldown{cooldown_steps}"
        ]
    )
    for name in ("head", "norm_bias", "whiten_bias"):
        config["hparam_tuning"]["params"][f"{name}.initial_lr"] = dict(
            initial=config["param_groups"][name]["lr_scheduler"][0][1], choices=None, mult=0.6
        )
    RUN_CONFIGS[
        f"overfit_interval_lrs_bs2000_steps10_interval{interval_steps}_cooldown{cooldown_steps}"
    ] = config

# LR-only searches at BS 2000 (no momentum): the conv LR alone (*_conv_lr) or all four
# trained LRs (*_lrs: conv, head, norm_bias, whiten_bias). interval_* uses 20%/20%
# intervals and cooldowns (40/40 steps), holding searched LRs constant per segment;
# global_neighbour_* scales each searched group's configured schedule over the full run.
for algorithm in ("interval", "global_neighbour"):
    for suffix, names in (("conv_lr", ("conv",)), ("lrs", ("conv", "head", "norm_bias", "whiten_bias"))):
        config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
        groups = config["param_groups"]
        config["hparam_tuning"] = dict(
            algorithm=algorithm,
            metric="tta_val_acc",
            max_side_steps=20,
            params={
                f"{name}.initial_lr": dict(
                    initial=groups[name]["lr_scheduler"][0][1], choices=None, mult=0.6
                )
                for name in names
            },
        )
        if algorithm == "interval":
            interval_steps = groups["conv"]["lr_scheduler"][0][0] // 5
            config["hparam_tuning"].update(
                initial_dropoff_margin=0.02,
                interval_steps=interval_steps,
                cooldown_steps=interval_steps,
            )
        RUN_CONFIGS[f"{algorithm}_{suffix}_bs2000"] = config

# global_interval from the schedules the 20%/20% LR-only interval searches committed
# (seed 0, logs/cifar_baseline_20261015_214346_039816Z_194098.log and
# ..._214347_043157Z_194170.log): five 40-step constant intervals per searched group,
# so 10 neighbours per group. Unsearched groups keep their baseline schedules.
GLOBAL_INTERVAL_STARTS = {
    "conv_lr": dict(conv=(0.13, 0.13, 0.078, 0.078, 0.017)),
    "lrs": dict(
        conv=(0.13, 0.13, 0.078, 0.047, 0.01),
        head=(2100, 2100, 2100, 2100, 1300),
        norm_bias=(770, 770, 770, 460, 280),
        whiten_bias=(460, 460, 280, 280, 280),
    ),
}
for suffix, start in GLOBAL_INTERVAL_STARTS.items():
    config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
    for name, lrs in start.items():
        config["param_groups"][name]["lr_scheduler"] = [(40, lr) for lr in lrs]
    config["hparam_tuning"] = dict(
        algorithm="global_interval",
        metric="tta_val_acc",
        params={f"{name}.lr_scheduler": dict(mult=0.6) for name in start},
    )
    RUN_CONFIGS[f"global_interval_{suffix}_bs2000"] = config

# Plain runs (no search) of the interval-wise schedules: the 20%/20% interval-search
# starts above (interval_*) and the best global_interval schedules found from them
# (global_interval_*; logs/cifar_baseline_20261016_020523_059746Z_244331.log and
# ..._020524_076790Z_244401.log), for held-out seeds 100-107.
GLOBAL_INTERVAL_BESTS = {
    "conv_lr": dict(conv=(0.22, 0.13, 0.078, 0.078, 0.017)),
    "lrs": dict(
        conv=(0.22, 0.13, 0.078, 0.047, 0.01),
        head=(2100, 2100, 2100, 1300, 1300),
        norm_bias=(770, 770, 770, 460, 280),
        whiten_bias=(460, 460, 280, 280, 170),
    ),
}
for source, schedules in (("interval", GLOBAL_INTERVAL_STARTS),
                          ("global_interval", GLOBAL_INTERVAL_BESTS)):
    for suffix, start in schedules.items():
        config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
        for name, lrs in start.items():
            config["param_groups"][name]["lr_scheduler"] = [(40, lr) for lr in lrs]
        RUN_CONFIGS[f"schedule_{source}_{suffix}_bs2000"] = config

# Which non-conv interval schedules help (held-out seeds 100-107): conv fixed at the
# four-LR interval search's schedule (mix_c4_*) with no / one other group on its searched
# intervals (the others on the baseline), and the baseline linear conv with all three
# other groups on their searched intervals (mix_lin_others).
SEARCHED_OTHERS = {g: v for g, v in GLOBAL_INTERVAL_STARTS["lrs"].items() if g != "conv"}
for suffix, conv_intervals, others in (
    ("c4_ctl", True, ()),
    *((f"c4_{g}", True, (g,)) for g in SEARCHED_OTHERS),
    ("lin_others", False, tuple(SEARCHED_OTHERS)),
):
    config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
    if conv_intervals:
        config["param_groups"]["conv"]["lr_scheduler"] = [(40, lr) for lr in GLOBAL_INTERVAL_STARTS["lrs"]["conv"]]
    for name in others:
        config["param_groups"][name]["lr_scheduler"] = [(40, lr) for lr in SEARCHED_OTHERS[name]]
    RUN_CONFIGS[f"mix_{suffix}_bs2000"] = config

# auto search (run_auto_search) studies, research/ and interval_search_writeup.txt.
# Scenario A ("a"): a good baseline; search the conv LR (from its baseline initial value)
# with the other groups on their baseline schedules. Scenario B ("b"): from scratch; all
# four trained LRs start at 1.0 with a coarse x10 climb in the first interval. Transforms
# (applied to the searched groups) make the best specified schedule non-linear.
HELDOUT_SEEDS = list(range(100, 108))
LR_TRANSFORMS = {
    "ramp": dict(kind="ramp", factor=4.0),
    "wave": dict(kind="wave", factor=2.0, phase=0.0),
    "rampdown": dict(kind="ramp", factor=0.25),  # The reverse ramp: x4 -> x0.25.
    # Held back while ICS was developed (a generality check of the final algorithm, Experiment 31):
    "waveinv": dict(kind="wave", factor=2.0, phase=0.5),  # The wave inverted: down first, then up.
    "ramp8": dict(kind="ramp", factor=8.0),  # A steeper ramp: x1/8 -> x8.
}
TRAINED_LR_GROUPS = ("conv", "head", "norm_bias", "whiten_bias")


def auto_config(batch_size, scenario, transform, searched, **overrides):
    config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
    groups = config["param_groups"]
    if searched is None:
        searched = ("conv",) if scenario == "a" else TRAINED_LR_GROUPS
    tuning = dict(
        algorithm="auto", metric="tta_val_acc",
        params={
            f"{name}.initial_lr": dict(
                initial=groups[name]["lr_scheduler"][0][1] if scenario == "a" else 1.0,
                mult=0.6,
            )
            for name in searched
        },
        interval_fraction=5, cooldown_fraction=5, cooldown_searched=0.36,
        cooldown_others="continue", move_margin=0.0, max_side_steps=20,
        heldout_seeds=HELDOUT_SEEDS,
    )
    if scenario == "b":
        tuning["coarse_mult"] = 0.1
    tuning.update(overrides)
    config["hparam_tuning"] = tuning
    if transform is not None:
        for name in searched:
            groups[name]["lr_transform"] = copy.deepcopy(LR_TRANSFORMS[transform])
    return config


AUTO_COOLDOWNS = {  # name: (cooldown_searched, cooldown_others, cooldown_fraction)
