def normalize_config(value, key):
    """Round hyperparameters, preserving step counts, batch sizes, and Adam beta2."""
    # Adam beta2=0.999 must not round to 1, including in tuning specifications.
    if key == "beta2" or (isinstance(key, str) and key.endswith(".beta2")):
        return copy.deepcopy(value)
    if key in (
        "batch_size",
        "num_epochs",
        "interval_steps",
        "cooldown_steps",
        "max_side_steps",
        "kfac_probes",
        "seeds",
        "heldout_seeds",
        "interval_fraction",
        "cooldown_fraction",
    ):
        return copy.deepcopy(value)
    if key == "lr_scheduler":
        return normalize_schedule(value, total_steps=None, name="lr_scheduler")
    if isinstance(value, dict):
        return {name: normalize_config(item, name) for name, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [normalize_config(item, key=None) for item in value]
    return round_hparam(value)


def make_optimizer(model, param_groups):
    for group in param_groups.values():
        GroupOptimizer.validate_group(group, runtime=False)
    parameters = dict(
        whiten_bias=[model.whiten.bias],
        norm_bias=[m.bias for m in model.modules() if isinstance(m, BatchNorm)],
        head=[model.head.weight],
        whiten_weight=[model.whiten.weight],
        norm_weight=[m.weight for m in model.modules() if isinstance(m, BatchNorm)],
        conv=[
            p
            for p in model.parameters()
            if p.ndim == 4 and p.requires_grad and p is not model.whiten.weight
        ],
    )
    require_fields(param_groups, set(parameters), "param_groups")
    optimizer = GroupOptimizer(
        [
            dict(
                name=name,
                params=params,
                lr=hparam_at_step(param_groups[name]["lr_scheduler"], 0),
                **{
                    key: value
                    for key, value in param_groups[name].items()
                    if key != "lr_scheduler"
                },
            )
            for name, params in parameters.items()
        ]
    )
    optimizer.bind_input_layers(model)
    optimizer.bind_kfac_layers(model)
    return optimizer


def get_hparam(config, path):
    """Read shared options, excluding frozen groups for all.initial_lr/decay."""
    if path in ("batch_size", "num_epochs", "overfit"):
        return config[path]
    parts = path.split(".")
    if len(parts) == 2 and parts[0] == "all":
        field = parts[1]
        values = [
            get_hparam(config, f"{name}.{field}")
            for name, group in config["param_groups"].items()
            if field not in ("initial_lr", "decay") or not is_zero_lr_schedule(group["lr_scheduler"])
        ]
        if not values and config["param_groups"] and field in ("initial_lr", "decay"):
            return 0.0 if field == "initial_lr" else "constant"
        if not values or any(value != values[0] for value in values[1:]):
            raise ValueError(f"{path}: all parameter groups must share the same value")
        return values[0]
    if len(parts) == 2 and parts[0] in config["param_groups"]:
        group = config["param_groups"][parts[0]]
        field = parts[1]
        if field in group and field != "lr_scheduler":
            return group[field]
        if field == "initial_lr":
            return group["lr_scheduler"][0][1]
        if field == "decay":
            lines = group["lr_scheduler"]
            if all(len(line) == 2 and line[1] == lines[0][1] for line in lines):
                return "constant"
            if len(lines) == 1 and len(lines[0]) == 3 and lines[0][2] == 0:
                return "linear_decay"
            raise ValueError(
                f"{path}: decay search requires a constant or single linear-to-zero schedule"
            )
    raise ValueError(f"Unknown hyperparameter: {path!r}")


def with_hparam(config, path, value):
    get_hparam(config, path)  # Validate the path before modifying anything.
    updated = copy.deepcopy(config)
    value = normalize_config(value, path.rsplit(".", 1)[-1])
    if "." not in path:
        updated[path] = value
    else:
        name, field = path.split(".")
        names = list(updated["param_groups"]) if name == "all" else [name]
        for group_name in names:
            group = updated["param_groups"][group_name]
            if name == "all" and field in ("initial_lr", "decay") and is_zero_lr_schedule(group["lr_scheduler"]):
                continue
            if field in group:
                group[field] = value
            elif field == "decay":
                lines = group["lr_scheduler"]
                group["lr_scheduler"] = lr_decay_schedule(
                    sum(line[0] for line in lines), lines[0][1], value
                )
            else:
                group["lr_scheduler"] = scale_lr_schedule(group["lr_scheduler"], value)
    return updated


def validate_tuning_config(tuning):
    if "algorithm" not in tuning or tuning["algorithm"] not in (
        "grid",
        "coordinate",
        "interval",
        "global_neighbour",
        "global_neighbour_seeds",
        "interval2",
        "global_interval",
        "auto",
        "global_family",
        "noisy_family",
        "guided_family",
        "ics",
    ):
        raise ValueError("hparam_tuning requires a known algorithm")
    if tuning["algorithm"] in ("auto", "global_family", "noisy_family", "guided_family", "ics"):
        return  # These searches validate their own fields.
    required = {"algorithm", "metric", "params"}
    if tuning["algorithm"] in (
        "interval", "interval2", "global_neighbour", "global_neighbour_seeds"
    ):
        required.add("max_side_steps")
    if tuning["algorithm"] == "global_neighbour_seeds":
        required.add("seeds")
    if tuning["algorithm"] in ("interval", "interval2"):
        required |= {"interval_steps", "cooldown_steps", "initial_dropoff_margin"}
    if tuning["algorithm"] == "interval2":
        required.add("cooldown_lr_mult")
    require_fields({k: v for k, v in tuning.items() if k != "heldout_seeds"}, required,
                   "hparam_tuning")


def tuning_params(config):
    """Read explicit search specs without changing the baseline parameter groups."""
    tuning = config["hparam_tuning"]
    if "params" not in tuning or "parameters" in tuning:
        raise ValueError(
            "hparam_tuning requires params with explicit initial/choices entries"
        )
    parameters = tuning["params"]
    if not isinstance(parameters, dict) or not parameters:
        raise ValueError("hparam_tuning.params must be a nonempty mapping")
    specs = {}
    for path, spec in parameters.items():
        if path.startswith("all."):
            if tuning["algorithm"] not in (
                "grid", "coordinate", "global_neighbour", "global_neighbour_seeds"
            ):
                raise ValueError(
                    "Shared all.<field> searches require grid, coordinate, "
                    "global_neighbour or global_neighbour_seeds"
                )
            field = path.split(".", 1)[1]
            if any(f"{name}.{field}" in parameters for name in config["param_groups"]):
                raise ValueError(f"{path}: cannot also search this field for an individual group")
        get_hparam(config, path)
        if not isinstance(spec, dict):
            raise ValueError(f"{path}: specify initial and choices explicitly")
        required = {"initial", "choices"}
        if "choices" in spec and spec["choices"] is None:
            required.add("mult")
        require_fields(spec, required, path)
        if "mult" in spec:
            mult = spec["mult"]
            if (
                isinstance(mult, bool)
                or not isinstance(mult, (int, float))
                or not isfinite(mult)
                or not 0 < mult < 1
            ):
                raise ValueError(
                    f"{path}: mult must be a finite number between 0 and 1"
                )
        specs[path] = dict(spec)
    return specs


def lr_grid_index(value, mult):
    """Choose the nearest integer exponent in logarithmic LR space."""
    return round(log(value) / log(mult))


def snap_lr_to_grid(value, mult):
    return round_hparam(mult ** lr_grid_index(value, mult))


def interval_search_space(config):
    """Validate searchable fields and snap multiplicative LR starts to their grids."""
    choices, initial = {}, {}
    for path, spec in tuning_params(config).items():
        value = normalize_config(spec["initial"], path.rsplit(".", 1)[-1])
        values = spec["choices"]
        parts = path.split(".")
        if len(parts) != 2:
            raise ValueError(f"Unsupported interval search parameter: {path}")
        name, field = parts
        groups = (
            list(config["param_groups"].values()) if name == "all"
            else [config["param_groups"][name]]
        )
        if field == "decay":
            if config["hparam_tuning"]["algorithm"] not in (
                "global_neighbour", "global_neighbour_seeds"
            ):
                raise ValueError("decay search requires global_neighbour(_seeds)")
            allowed = ("constant", "linear_decay")
            if (
                not isinstance(values, list)
                or not values
                or any(v not in allowed for v in values)
                or value not in values
            ):
                raise ValueError(
                    f"{path}: initial and choices must specify constant or linear_decay"
                )
            choices[path], initial[path] = list(dict.fromkeys(values)), value
            continue
        if any(
            field
            not in {"initial_lr", "momentum"} | ALGORITHM_FIELDS[group["algorithm"]]
            for group in groups
        ):
            raise ValueError(f"Unsupported interval search parameter: {path}")
        if (
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not isfinite(value)
            or value < 0
        ):
            raise ValueError(f"{path}: initial must be a nonnegative finite number")
        if values is None:
            if field not in MULTIPLICATIVE_SEARCH_FIELDS or value <= 0:
                raise ValueError(
                    f"{path}: multiplicative search needs a positive initial LR or damping"
                )
            value = snap_lr_to_grid(value, spec["mult"])
        else:
            if (
                not isinstance(values, list)
                or not values
                or any(
                    isinstance(v, bool)
                    or not isinstance(v, (int, float))
                    or not isfinite(v)
                    or v < 0
                    for v in values
                )
            ):
                raise ValueError(f"{path}: choices must be nonnegative finite numbers")
            values = sorted({normalize_config(v, field) for v in values})
            if field != "initial_lr":
                for candidate in [value, *values]:
                    for group in groups:
                        GroupOptimizer.validate_group(
                            dict(group, **{field: candidate}), runtime=False
                        )
        choices[path], initial[path] = values, value
    return choices, initial


def directional_search(
    initial,
    choices,
    score,
    *,
    initial_lr_search,
    factors,
    max_side_steps,
    dropoff_margin,
    on_event,
):
    """Snap LR starts to the fixed, unit-anchored grid and probe adjacent exponents."""
    cache = {}

    def emit(event, point, **fields):
        if on_event is not None:
            on_event(event, dict(point), **fields)

    def evaluate_point(point):
        key = tuple(point[path] for path in choices)
        if key not in cache:
            emit("candidate_start", point)
            value = score(dict(point))
            cache[key] = value if isfinite(value) else float("-inf")
            emit("candidate_result", point, score=cache[key])
        return cache[key]

    def neighbors(path, center, direction):
        values = choices[path]
        seen = {center}
        if values is None:
            mult = factors[path]

            def grid_lr(index):
                return round_hparam(1.0 * mult**index)

            index = lr_grid_index(center, mult)
        for distance in range(1, max_side_steps + 1):
            if values is None:
                value = grid_lr(index - direction * distance)
                if not isfinite(value) or value <= 0:
                    break
            else:
                # An explicit start (e.g. momentum=0.85) need not be in the choices.
                if isinstance(center, str):
                    index = values.index(center) + direction * distance
                else:
                    index = (
                        bisect_left(values, center) - distance
                        if direction < 0
                        else bisect_right(values, center) + distance - 1
                    )
                if not 0 <= index < len(values):
                    break
                value = values[index]
            if value not in seen:
                seen.add(value)
                yield value

    current = dict(initial)
    for path, values in choices.items():
        if values is None:
            current[path] = snap_lr_to_grid(current[path], factors[path])
    current_score = evaluate_point(current)
    emit("search_path", current, score=current_score, reason="initial")
    while True:
        changed = False
        for path in choices:
            is_lr = path.endswith(".initial_lr")
            if initial_lr_search and is_lr:
                probes = [(dict(current), current_score)]
                best_score = current_score
                for direction in (1, -1):
                    for value in neighbors(path, current[path], direction):
                        candidate = dict(current, **{path: value})
                        candidate_score = evaluate_point(candidate)
                        probes.append((candidate, candidate_score))
                        if (
                            not isfinite(candidate_score)
                            or candidate_score < best_score - dropoff_margin
                        ):
                            break
                        best_score = max(best_score, candidate_score)
                acceptable = [
                    (point, value)
                    for point, value in probes
                    if isfinite(value) and value >= best_score - dropoff_margin
                ]
                if acceptable:
                    previous = current
                    current, current_score = max(
                        acceptable, key=lambda item: item[0][path]
                    )
                    if current != previous:
                        emit(
                            "search_path",
                            current,
                            score=current_score,
                            parameter=path,
                            reason="largest_lr_within_margin",
                        )
                continue

            # Smaller values first; stop a direction once it gets worse.
            for direction in (-1, 1):
                best, best_score = current, current_score
                flat_steps = 0
                for value in neighbors(path, current[path], direction):
                    candidate = dict(current, **{path: value})
                    candidate_score = evaluate_point(candidate)
                    if not isfinite(candidate_score) or candidate_score < best_score:
                        break
                    if candidate_score > best_score:
                        best, best_score, flat_steps = candidate, candidate_score, 0
                    else:
                        flat_steps += 1
                        if is_lr and direction < 0 and flat_steps >= 3:
                            break
                if best_score > current_score:
                    current, current_score = best, best_score
                    emit(
                        "search_path",
                        current,
                        score=current_score,
                        parameter=path,
                        reason="improved",
                    )
                    changed = True
                    break
        if initial_lr_search or not changed:
            return current, current_score


COOLDOWN_LR_MULT = "cooldown.lr_mult"


def cooldown_lr_values(base_schedules, main_values, lr_mult, start_step, main_steps):
    """interval2's cooldown: every group's LR is constant at lr_mult times its LR in
    the main interval: the searched (constant) value, or for groups not searched
    there the mean of their scheduled LR over the main interval's steps. Other
    searched fields keep their main-interval values."""
    values = dict(main_values)
    for path, lines in base_schedules.items():
        if not path.endswith(".initial_lr"):
            continue
        if path in main_values:
            main_lr = main_values[path]
        else:
            main_lr = sum(
                schedule_value_at_step(lines, step)
                for step in range(start_step, start_step + main_steps)
            ) / main_steps
        values[path] = main_lr * lr_mult
    return values


class SegmentTrainer:
    """One training run that can be snapshotted, restored and continued under any
    full-run schedules (path -> segments covering every step), the shared machinery of
    online searches and probe experiments. Uses the current TRAINING_SEED."""

    def __init__(self, model, config):
        self.model = model
        self.config = config
        set_training_seed()
        self.test_loader = CifarLoader(
            "cifar10", train=False, batch_size=2000, aug=dict(flip=False, translate=0)
        )
        train_loader = CifarLoader(
            "cifar10", train=True, batch_size=config["batch_size"],
            aug=dict(flip=True, translate=2),
        )
        self.total_steps = config["num_epochs"] * (1 if config["overfit"] else len(train_loader))
        self.base_schedules = configured_hparam_schedules(config["param_groups"], self.total_steps)
        self.device = next(model.parameters()).device
        self.optimizer = make_optimizer(model, config["param_groups"])
        self.forward = training_forward(
            model, config["batch_size"], config["param_groups"], False, self.device
        )
        model.reset()
        fixed_batch = next(iter(train_loader)) if config["overfit"] else None
        if fixed_batch is not None:
            self.test_loader = FixedBatchLoader(*fixed_batch)
        model.init_whiten(
            fixed_batch[0] if fixed_batch is not None
            else train_loader.normalized_images()[:5000],
            eps=0.0005,
        )
        self.stream = TrainingBatchStream(train_loader, fixed_batch)
        self.step = 0
        self.train_steps = 0  # Every trained step, including discarded probes.

    def snapshot(self):
        return dict(
            model=copy.deepcopy(self.model.state_dict()),
            optimizer=copy.deepcopy(self.optimizer.state_dict()),
            stream=self.stream.state_dict(),
            rng=torch.random.get_rng_state(),
            cuda_rng=torch.cuda.get_rng_state_all() if self.device.type == "cuda" else None,
            step=self.step,
        )

    def restore(self, state):
        self.model.load_state_dict(state["model"])
        # Each trial needs its own momentum tensors (load_state_dict may reuse them).
        self.optimizer.load_state_dict(copy.deepcopy(state["optimizer"]))
        self.optimizer.zero_grad(set_to_none=True)
        self.stream.load_state_dict(state["stream"])
        torch.random.set_rng_state(state["rng"])
        if state["cuda_rng"] is not None:
            torch.cuda.set_rng_state_all(state["cuda_rng"])
        self.step = state["step"]

    def train(self, schedules, steps):
        """Train steps updates from self.step under full-run schedules; False on divergence."""
        self.model.train()
        for _ in range(steps):
            apply_hparam_schedules(self.optimizer, schedules, self.step)
            inputs, labels = self.stream.next_batch()
            outputs = self.forward(inputs)
            loss = F.cross_entropy(outputs, labels, label_smoothing=0.2, reduction="mean")
            if not isfinite(loss.item()):
                return False
            self.optimizer.prepare_kfac(outputs)
            loss.backward()
            self.optimizer.step()
            self.optimizer.zero_grad(set_to_none=True)
            self.step += 1
            self.train_steps += 1
        return True

    def score(self, metric):
        if metric == "neg_train_loss":
            return -batch_loss(self.model, self.test_loader)
        return evaluate(self.model, self.test_loader, tta_level=2 if metric == "tta_val_acc" else 0)


def constant_window(lines, start, steps, value):
    """lines with [start, start + steps) replaced by a constant value."""
    total = sum(line[0] for line in lines)
    return (slice_schedule(lines, 0, start) + [(steps, value)]
            + slice_schedule(lines, start + steps, total))


def linear_window(lines, start, steps, first, last):
    """lines with [start, start + steps) replaced by a line from first to last."""
    total = sum(line[0] for line in lines)
    return (slice_schedule(lines, 0, start) + [(steps, first, last)]
            + slice_schedule(lines, start + steps, total))


def segments_window(lines, start, segments):
    """lines with [start, start + their total) replaced by segments."""
    total = sum(line[0] for line in lines)
    end = start + sum(segment[0] for segment in segments)
    return slice_schedule(lines, 0, start) + list(segments) + slice_schedule(lines, end, total)


def geometric_lookahead(value, ratio, steps, interval):
    """Segments through knots value * ratio**j every interval steps; the last decays to 0."""
    segments, knot, left = [], value, steps
    while left > 0:
        length = min(interval, left)
        left -= length
        following = 0.0 if left == 0 else knot * ratio
        segments.append((length, knot, following))
        knot = following
    return segments


def plan_end_value(lines, step):
    """A schedule's value reached at step (a segment end exactly at step wins)."""
    offset = 0
    for line in lines:
        offset += line[0]
        if offset == step:
            return line[-1]
    return schedule_value_at_step(lines, step)


def window_mean(lines, start, steps):
    return sum(schedule_value_at_step(lines, s) for s in range(start, start + steps)) / steps


class MultiTrainer:
    """SegmentTrainer's interface over several seeds' runs of one shared model: each run's
    live state is swapped in for training and scoring; score() is the mean over seeds."""

    def __init__(self, model, config, seeds):
        self.trainers, self.live = [], []
        for seed in seeds:
            trainer = segment_trainer_with_seed(model, config, seed)
            self.trainers.append(trainer)
            self.live.append(trainer.snapshot())  # Before the next one resets the model.
        first = self.trainers[0]
        self.total_steps, self.base_schedules, self.device = (
            first.total_steps, first.base_schedules, first.device)

    @property
    def step(self):
        return self.live[0]["step"]

    @property
    def train_steps(self):
        return sum(trainer.train_steps for trainer in self.trainers)

    def snapshot(self):
        return list(self.live)

    def restore(self, states):
        self.live = list(states)

    def train(self, schedules, steps):
        ok = True
        for i, trainer in enumerate(self.trainers):
            trainer.restore(self.live[i])
            ok = trainer.train(schedules, steps) and ok
            self.live[i] = trainer.snapshot()
        return ok

    def score(self, metric):
        values = []
        for i, trainer in enumerate(self.trainers):
            trainer.restore(self.live[i])
            values.append(trainer.score(metric))
        return sum(values) / len(values)


def segment_trainer_with_seed(model, config, seed):
    """A SegmentTrainer whose run uses TRAINING_SEED = seed (restored afterwards)."""
    global TRAINING_SEED
    previous, TRAINING_SEED = TRAINING_SEED, seed
    try:
        return SegmentTrainer(model, config)
    finally:
        TRAINING_SEED = previous


def run_interval_search(run, model, config, debug):
    """Choose each committed interval using replayed main/cooldown training probes.

    seconds includes setup, training probes, evaluation, checkpoint copies and logging.
    Search logs distinguish lookahead scores from committed scores.
    """
    run_start = time.perf_counter()
    config = normalize_config(config, key=None)
    tuning = config["hparam_tuning"]
    validate_tuning_config(tuning)
    if tuning["algorithm"] not in ("interval", "interval2", "global_neighbour"):
        raise ValueError(f"Unknown interval algorithm: {tuning['algorithm']!r}")
    global_search = tuning["algorithm"] == "global_neighbour"
    # interval2 searches one cooldown multiplier on every group's main-interval LR.
    shared_cooldown = tuning["algorithm"] == "interval2"
    choices, current = interval_search_space(config)
    factors = {
        path: spec["mult"]
        for path, spec in tuning_params(config).items()
        if "mult" in spec
    }
    if shared_cooldown:
        spec = tuning["cooldown_lr_mult"]
        require_fields(spec, {"initial", "mult"}, "cooldown_lr_mult")
        for name in ("initial", "mult"):
            value = spec[name]
            if isinstance(value, bool) or not isinstance(value, (int, float)) or not isfinite(value):
                raise ValueError(f"cooldown_lr_mult.{name} must be a finite number")
        if spec["initial"] <= 0 or not 0 < spec["mult"] < 1:
            raise ValueError("cooldown_lr_mult needs initial > 0 and 0 < mult < 1")
        factors[COOLDOWN_LR_MULT] = spec["mult"]
    interval_steps = None if global_search else tuning["interval_steps"]
    cooldown_steps = 0 if global_search else tuning["cooldown_steps"]
    max_side_steps = tuning["max_side_steps"]
    margin = None if global_search else tuning["initial_dropoff_margin"]
    metric = tuning["metric"]
    counts = [
        ("max_side_steps", max_side_steps, 1),
        ("num_epochs", config["num_epochs"], 1),
    ]
    if not global_search:
        counts += [
            ("interval_steps", interval_steps, 1),
            ("cooldown_steps", cooldown_steps, 0),
        ]
    for name, value, minimum in counts:
        if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
            raise ValueError(f"{name} must be an integer >= {minimum}")
    if not global_search and (not isfinite(margin) or margin < 0):
        raise ValueError("initial_dropoff_margin must be nonnegative and finite")
    if metric is not None and metric not in ("val_acc", "tta_val_acc", "neg_train_loss"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")
    if metric == "neg_train_loss" and not config["overfit"]:
        raise ValueError("neg_train_loss scores the fixed batch and requires overfit=True")
    set_training_seed()
    test_loader = CifarLoader(
        "cifar10", train=False, batch_size=2000, aug=dict(flip=False, translate=0)
    )
    train_loader = CifarLoader(
        "cifar10",
        train=True,
        batch_size=config["batch_size"],
        aug=dict(flip=True, translate=2),
    )
    if len(train_loader) == 0:
        raise ValueError("batch_size must not exceed the training dataset size")
    steps_per_epoch = 1 if config["overfit"] else len(train_loader)
    total_steps = config["num_epochs"] * steps_per_epoch
    if global_search:
        interval_steps = total_steps
    # Log effective settings, including the single full-run interval in global mode.
    tuning.update(
        interval_steps=interval_steps,
        cooldown_steps=cooldown_steps,
        max_side_steps=max_side_steps,
        metric=metric,
    )
    log_config(run, config, label="base_config")
    base_schedules = configured_hparam_schedules(config["param_groups"], total_steps)
    optimizer = make_optimizer(model, config["param_groups"])
    forward = training_forward(
        model, config["batch_size"], config["param_groups"], debug,
        next(model.parameters()).device,
    )
    model.reset()
    fixed_batch = next(iter(train_loader)) if config["overfit"] else None
    if fixed_batch is not None:
        test_loader = FixedBatchLoader(*fixed_batch)  # Overfit mode scores the fixed batch.
    model.init_whiten(
        fixed_batch[0]
        if fixed_batch is not None
        else train_loader.normalized_images()[:5000],
        eps=0.0005,
    )
    stream = TrainingBatchStream(train_loader, fixed_batch)
    device = next(model.parameters()).device
    completed = 0
    evaluations = 0
    history = []
    cooldown_values = {}
    recorder = SpectrumRecorder(run, model, debug_kfac_factors) if debug else None

    def snapshot():
        return dict(
            model=copy.deepcopy(model.state_dict()),
            optimizer=copy.deepcopy(optimizer.state_dict()),
            stream=stream.state_dict(),
            rng=torch.random.get_rng_state(),
            cuda_rng=torch.cuda.get_rng_state_all() if device.type == "cuda" else None,
        )

    def restore(state):
        model.load_state_dict(state["model"])
        # load_state_dict may reuse momentum tensors: each trial needs its own copy
        # so optimizer.step() cannot mutate the saved main/cooldown checkpoint.
        optimizer.load_state_dict(copy.deepcopy(state["optimizer"]))
        optimizer.zero_grad(set_to_none=True)
        stream.load_state_dict(state["stream"])
        torch.random.set_rng_state(state["rng"])
        if state["cuda_rng"] is not None:
            torch.cuda.set_rng_state_all(state["cuda_rng"])

    def train_segment(values, steps, start_step, commit):
        nonlocal completed
        schedules = segment_hparam_schedules(
            base_schedules, values, start_step, steps, global_search=global_search
        )
        valid = True
        model.train()
        for local_step in range(steps):
            apply_hparam_schedules(optimizer, schedules, start_step + local_step)
            inputs, labels = stream.next_batch()
            if commit and recorder is not None:
                recorder.before_step()
            outputs = forward(inputs)
            loss = F.cross_entropy(
                outputs, labels, label_smoothing=0.2, reduction="mean"
            )
            if not isfinite(loss.item()):
                valid = False
                break
            optimizer.prepare_kfac(outputs)
            loss.backward()
            optimizer.step()
            if commit and recorder is not None:
                recorder.after_step(start_step + local_step, optimizer)
            optimizer.zero_grad(set_to_none=True)
            if commit:
                completed += 1
        return valid

    def score():
        if metric == "neg_train_loss":
            # The search maximizes, so it scores the negated fixed-batch loss.
            return -batch_loss(model, test_loader)
        return evaluate(
            model, test_loader, tta_level=2 if metric == "tta_val_acc" else 0
        )

    def search(values, space, evaluate_point, phase, initial, main_values, cooldown):
        log_event("search", run=run, interval=len(history), phase=phase, metric=metric)
        if main_values is not None:
            print(f"main hparams: {hparam_text(main_values)}", flush=True)
        if cooldown is not None:
            print(f"cooldown hparams: {hparam_text(cooldown)}", flush=True)
        search_path = []

        def on_event(event, point, **fields):
            if event == "candidate_result":
                value = format_log_value(fields["score"])
                if phase == "cooldown":
                    print(f"{hparam_text(point)} -> {metric}={value}", flush=True)
                else:
                    score_name = "main" if cooldown is None else "best_cooldown"
                    print(
                        f"main hparams: {hparam_text(point)} {score_name}={value}",
                        flush=True,
                    )
            elif event == "search_path":
                search_path.append((point, fields["score"]))

        best, best_score = directional_search(
            values,
            space,
            evaluate_point,
            initial_lr_search=initial,
            factors=factors,
            max_side_steps=max_side_steps,
            dropoff_margin=margin,
            on_event=on_event,
        )
        for step, (point, value) in enumerate(search_path):
            print(
                f"search_path step={step} {hparam_text(point)} "
                f"{metric}={format_log_value(value)}",
                flush=True,
            )
        return best, best_score

    while completed < total_steps:
        start_step = completed
        main_steps = min(interval_steps, total_steps - completed)
        lookahead_steps = min(cooldown_steps, total_steps - completed - main_steps)
        start_state = snapshot()

        def cooldown_segment(main_values, cooldown):
            if not shared_cooldown:
                return dict(main_values, **cooldown)
            values = cooldown_lr_values(
                base_schedules, main_values, cooldown[COOLDOWN_LR_MULT], start_step, main_steps
            )
            print(
                "cooldown lrs: " + hparam_text(
                    {p: round_hparam(v) for p, v in values.items() if p.endswith(".initial_lr")}
                ),
                flush=True,
            )
            return values

        def main_score(values, cooldown):
            nonlocal evaluations
            evaluations += 1
            restore(start_state)
            if not train_segment(values, main_steps, start_step, commit=False):
                return float("-inf")
            if cooldown is not None and lookahead_steps:
                if not train_segment(
                    cooldown_segment(values, cooldown),
                    lookahead_steps,
                    start_step + main_steps,
                    commit=False,
                ):
                    return float("-inf")
            return score()

        if start_step == 0 or not lookahead_steps:
            current, selected_score = search(
                current,
                choices,
                lambda values: main_score(values, None),
                initial=start_step == 0 and not global_search,
                phase="main",
                main_values=None,
                cooldown=None,
            )
        else:
            current, selected_score = search(
                current,
                {},
                lambda values: main_score(values, None),
                phase="baseline",
                initial=False,
                main_values=None,
                cooldown=None,
            )
        selected_cooldown = None
        while lookahead_steps:
            restore(start_state)
            if not train_segment(current, main_steps, start_step, commit=False):
                break
            cooldown_start = snapshot()
            if shared_cooldown:
                cooldown_choices = {COOLDOWN_LR_MULT: None}
                seed = {
                    COOLDOWN_LR_MULT: cooldown_values.get(
                        COOLDOWN_LR_MULT, tuning["cooldown_lr_mult"]["initial"]
                    )
                }
            else:
                cooldown_choices = {
                    path: values
                    for path, values in choices.items()
                    if path.endswith(".initial_lr")
                }
                seed = {
                    path: cooldown_values.get(path, current[path])
                    for path in cooldown_choices
                }

            def cooldown_score(values):
                nonlocal evaluations
                evaluations += 1
                restore(cooldown_start)
                if not train_segment(
                    cooldown_segment(current, values),
                    lookahead_steps,
                    start_step + main_steps,
                    commit=False,
                ):
                    return float("-inf")
                return score()

            candidate_cooldown, candidate_score = search(
                seed,
                cooldown_choices,
                cooldown_score,
                phase="cooldown",
                main_values=current,
                initial=False,
                cooldown=None,
            )
            if candidate_score <= selected_score:
                break
            cooldown_values = selected_cooldown = candidate_cooldown
            selected_score = candidate_score
            candidate, candidate_score = search(
                current,
                choices,
                lambda values: main_score(values, selected_cooldown),
                cooldown=selected_cooldown,
                phase="main",
                initial=False,
                main_values=None,
            )
            if candidate_score <= selected_score:
                break
            current, selected_score = candidate, candidate_score

        if not isfinite(selected_score):
            raise RuntimeError(
                f"No finite candidate found at training step {start_step}"
            )
        log_event(
            "train_hparams",
            run=run,
            interval=len(history),
            start_step=start_step,
            completed_steps=main_steps,
            total_steps=total_steps,
            **current,
        )
        selected_schedules = segment_hparam_schedules(
            base_schedules, current, start_step, main_steps, global_search=global_search
        )
        log_event("train_schedules", run=run, interval=len(history))
        for path, lines in selected_schedules.items():
            print(f"  {path}: {json.dumps(lines)}", flush=True)
        restore(start_state)
        if not train_segment(current, main_steps, start_step, commit=True):
            raise RuntimeError(
                f"Selected training interval diverged at step {start_step}"
            )
        committed_score = score()
        log_event(
            "interval_boundary_eval",
            run=run,
            interval=len(history),
            step=completed,
            total_steps=total_steps,
            **{metric: committed_score},
        )
        history.append(
            dict(
                start_step=start_step,
                steps=main_steps,
                main_hparams=dict(current),
                cooldown_hparams=selected_cooldown,
                cooldown_steps=lookahead_steps,
                score=selected_score,
                hparam_schedules=selected_schedules,
            )
        )
        base_schedules = selected_schedules

    val_acc = evaluate(model, test_loader, tta_level=0)
    tta_val_acc = evaluate(model, test_loader, tta_level=2)
    train_loss = batch_loss(model, test_loader) if config["overfit"] else None
    if device.type == "cuda":
        torch.cuda.synchronize(device)
    seconds = time.perf_counter() - run_start
    if train_loss is not None:
        log_event("fixed_batch_loss", run=run, train_loss=train_loss)
    log_final_eval(val_acc, tta_val_acc, seconds)
    if recorder is not None:
        recorder.finish()
    return dict(
        val_acc=val_acc,
        tta_val_acc=tta_val_acc,
        train_loss=train_loss,
        seconds=seconds,
        batch_size=config["batch_size"],
        num_epochs=config["num_epochs"],
        overfit=config["overfit"],
        intervals=history,
        evaluations=evaluations,
        hparam_schedules=base_schedules,
        **{f"{group['name']}_lr": group["lr"] for group in optimizer.param_groups},
    )


def run_seeded(run, model, config, seed, debug):
    """One full training run of config with TRAINING_SEED = seed."""
    global TRAINING_SEED
    previous, TRAINING_SEED = TRAINING_SEED, seed
    try:
        return main(run, model, **config, _log_config=False, debug=debug)
    finally:
        TRAINING_SEED = previous


def run_seeded_neighbour_search(run, model, config):
    """global_neighbour scored by the mean metric of full runs over several seeds.

    Every candidate trains once per seed in hparam_tuning.seeds (the same seeds for
    all candidates) and scores the mean. Neighbour moves, grids and caching follow
    directional_search, as in the single-seed global_neighbour search.
    """
    tuning = config["hparam_tuning"]
    seeds = tuning["seeds"]
    if (
        not isinstance(seeds, list)
        or not seeds
        or any(isinstance(s, bool) or not isinstance(s, int) for s in seeds)
        or len(set(seeds)) != len(seeds)
    ):
        raise ValueError("hparam_tuning.seeds must be a nonempty list of distinct integers")
    max_side_steps = tuning["max_side_steps"]
    if isinstance(max_side_steps, bool) or not isinstance(max_side_steps, int) or max_side_steps < 1:
        raise ValueError("max_side_steps must be an integer >= 1")
    metric = tuning["metric"]
    if metric not in ("val_acc", "tta_val_acc"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")
    choices, initial = interval_search_space(config)
    factors = {
        path: spec["mult"] for path, spec in tuning_params(config).items() if "mult" in spec
    }
    base = dict(config, hparam_tuning=None)
    log_config(run, config, label="base_config")
    trials = []

    def candidate_config(values):
        candidate = base
        for path, value in values.items():
            candidate = with_hparam(candidate, path, value)
        return candidate

    def score(values):
        candidate = candidate_config(values)
        trial_run = f"{run}.{len(trials)}"
        results = [
            run_seeded(f"{trial_run}.seed{seed}", model, candidate, seed, debug=False)
            for seed in seeds
        ]
        mean = {
            key: sum(r[key] for r in results) / len(results)
            for key in ("val_acc", "tta_val_acc")
        }
        spread = (
            sum((r[metric] - mean[metric]) ** 2 for r in results) / (len(results) - 1)
        ) ** 0.5 if len(results) > 1 else 0.0
        log_event(
            "seeds_result",
            run=trial_run,
            **values,
            **{f"{metric}_mean": mean[metric], f"{metric}_std": spread},
            per_seed=[r[metric] for r in results],
        )
        trials.append(dict(run=trial_run, values=dict(values), config=candidate,
                           result=mean, per_seed=results))
        return mean[metric]

    def on_event(event, point, **fields):
        if event == "search_path":
            log_event("search_path", run=run, **point, **fields)

    best_values, best_score = directional_search(
        initial,
        choices,
        score,
        initial_lr_search=False,
        factors=factors,
        max_side_steps=max_side_steps,
        dropoff_margin=None,
        on_event=on_event,
    )
    best = next(t for t in trials if t["values"] == best_values)
    log_event("search_best", run=run, trial=best["run"], **best_values, **{metric: best_score})
    log_changes("changes", flatten_config(base), flatten_config(best["config"]))
    if debug:
        log_event("debug_final_run", run=run, trial=best["run"], seed=seeds[0])
        run_seeded(f"{run}.final", model, best["config"], seeds[0], debug=True)
    return dict(best_config=best["config"], best_result=best["result"], trials=trials)


def global_interval_neighbours(lines, mult):
    """(interval, schedule) pairs: one nonzero segment moved one LR grid step up or down.

    A segment's reference value (its start, or its end if the start is 0) moves to the
    adjacent grid value round2(mult**k); a linear segment's other end scales with it.
    All-zero segments are frozen intervals and are not searched. Higher LR first.
    """
    neighbours = []
    for index, line in enumerate(lines):
        steps, *values = line
        reference = next((value for value in values if value), 0)
        if not reference:
            continue
        grid = lr_grid_index(reference, mult)
        for direction in (-1, 1):
            target = round_hparam(mult ** (grid + direction))
            moved = (steps, *(round_hparam(value * target / reference) for value in values))
            neighbours.append((index, lines[:index] + [moved] + lines[index + 1:]))
    return neighbours


def run_global_interval_search(run, model, config):
    """Steepest-ascent search over interval-wise LR schedules, scored by full runs.

    hparam_tuning.params maps "<group>.lr_scheduler" to dict(mult=...); each segment of
    that group's configured lr_scheduler is one interval. A neighbour moves one interval
    of one group one LR grid step up or down (global_interval_neighbours), so 5 intervals
    give 10 neighbours per group. Every round trains all neighbours of the current
    schedules (cached) and moves to the best one if it beats the current score; the
    search stops when no neighbour does. The search score is the result (no replay).
    """
    tuning = config["hparam_tuning"]
    metric = tuning["metric"]
    if metric not in ("val_acc", "tta_val_acc"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")
    params = tuning["params"]
    if not isinstance(params, dict) or not params:
        raise ValueError("hparam_tuning.params must be a nonempty mapping")
    mults = {}
    for path, spec in params.items():
        name, _, field = path.partition(".")
        if field != "lr_scheduler" or name not in config["param_groups"]:
            raise ValueError(f"global_interval searches <group>.lr_scheduler, got {path}")
        if not isinstance(spec, dict) or set(spec) != {"mult"}:
            raise ValueError(f"{path}: specify exactly dict(mult=...)")
        mult = spec["mult"]
        if isinstance(mult, bool) or not isinstance(mult, (int, float)) or not 0 < mult < 1:
            raise ValueError(f"{path}: mult must be a number between 0 and 1")
        if is_zero_lr_schedule(config["param_groups"][name]["lr_scheduler"]):
            raise ValueError(f"{path}: an all-zero schedule has no intervals to search")
        mults[name] = mult
    base = dict(config, hparam_tuning=None)
    log_config(run, config, label="base_config")
    trials, cache = [], {}

    def evaluate_config(candidate):
        key = json.dumps(candidate["param_groups"], sort_keys=True)
        if key not in cache:
            trial_run = f"{run}.{len(trials)}"
            log_config_diff(trial_run, run, base, candidate)
            result = main(trial_run, model, **candidate, _log_config=False, debug=False)
            trials.append(dict(run=trial_run, config=candidate, result=result))
            value = result[metric] if isfinite(result[metric]) else float("-inf")
            cache[key] = (value, trials[-1])
        return cache[key]

    def schedule_text(candidate):
        return " ".join(
            f"{name}={json.dumps(candidate['param_groups'][name]['lr_scheduler'])}"
            for name in mults
        )

    current = base
    current_score, current_trial = evaluate_config(current)
    log_event("search_path", run=run, round=0, **{metric: current_score})
    print(f"  schedules: {schedule_text(current)}", flush=True)
    round_index = 0
    while True:
        round_index += 1
        best = None
        for name, mult in mults.items():
            lines = [tuple(line) for line in current["param_groups"][name]["lr_scheduler"]]
            for index, lines_moved in global_interval_neighbours(lines, mult):
                candidate = copy.deepcopy(current)
                candidate["param_groups"][name]["lr_scheduler"] = lines_moved
                value, trial = evaluate_config(candidate)
                old, new = lines[index][1:], lines_moved[index][1:]
                log_event(
                    "neighbour", run=run, round=round_index, trial=trial["run"],
                    group=name, interval=index, lr=f"{old} -> {new}", **{metric: value},
                )
                # Strictly better only: ties keep the earlier neighbour (and the incumbent).
                if best is None or value > best[0]:
                    best = (value, trial, candidate, name, index, old, new)
        if best is None or best[0] <= current_score:
            break
        current_score, current_trial, current, name, index, old, new = best
        log_event(
            "search_path", run=run, round=round_index, group=name, interval=index,
            lr=f"{old} -> {new}", **{metric: current_score},
        )
        print(f"  schedules: {schedule_text(current)}", flush=True)
    log_event("search_best", run=run, trial=current_trial["run"], **{metric: current_score})
    log_changes("changes", flatten_config(base), flatten_config(current))
    if debug:
        log_event("debug_final_run", run=run, trial=current_trial["run"])
        main(f"{run}.final", model, **current, _log_config=False, debug=True)
    return dict(best_config=current, best_result=current_trial["result"], trials=trials)


AUTO_REQUIRED = {
    "algorithm", "metric", "params", "interval_fraction", "cooldown_fraction",
    "cooldown_searched", "cooldown_others", "move_margin", "max_side_steps",
}
AUTO_OPTIONAL = {"coarse_mult", "heldout_seeds", "revisit", "larger_within", "shape",
                 "final_anneal", "coarse_scan", "polish_rounds", "polish_margin",
                 "polish_scale_first", "alternate",
                 "scan_lookahead", "polish_steps", "freeze_threshold", "first_knot",
                 "passes", "reseed", "pass_seeds", "plan_tail"}


def grid_neighbour(value, mult, direction, cap):
    """The adjacent value round2(mult**k) above (direction=+1) or below (-1) value."""
    if value <= 0:
        return None
    result = round_hparam(mult ** (lr_grid_index(value, mult) - direction))
    if cap is not None and result > cap:
        return None
    return result


def run_auto_search(run, model, config):
    """Online interval search of LR schedules with a constant-LR lookahead cooldown.

    hparam_tuning:
      params: {"<group>.initial_lr": dict(initial=v, mult=0.6)}, the searched groups.
        Searched LRs are constant within each main interval (total // interval_fraction
        steps); non-searched groups keep their configured schedules.
      cooldown_fraction: lookahead length total // cooldown_fraction (0 = none).
      cooldown_searched: lookahead LR of searched groups = mult x main LR; a number,
        or "search" (one mult shared by the searched groups, searched every interval
        on the x0.6 grid capped at 1, starting from the previous interval's value),
        "linear" (main LR decaying linearly to 0 over the lookahead), "linear_search"
        (from a searched mult x main LR, capped at 1, linearly to 0), "plan" (from a
        searched absolute level per searched group, carried between intervals, linearly
        to 0), "geometric" (knots main LR x ratio**j one interval apart, the last decaying
        to 0; ratio searched each interval on a x0.8 grid capped at 1, from 0.64), or "max"
        (the better of the linear and geometric lookaheads; ~2x the lookahead cost).
        cooldown_fraction=1 makes the lookahead the rest of the run.
      cooldown_others: non-searched groups in the lookahead: "continue" (their schedule),
        a number m (constant m x their mean LR over the main interval), "shared" (the
        searched groups' mult) or "search" (their own searched mult).
      move_margin: a neighbour must beat the incumbent by more than this to move.
      max_side_steps: most grid steps one direction may move in one climb.
      coarse_mult (optional): in the first interval, first climb each LR on this grid
        (e.g. 0.1), then refine on params' grid.
      coarse_scan (optional, default 0): in the first interval, evaluate each LR at
        x10**k for k in [-coarse_scan, coarse_scan] (others fixed) and keep the best
        before refining; robust where a greedy coarse climb stalls on a flat, noisy LR.
      polish_rounds (optional, default 0; shape="linear" only): after the online pass,
        coordinate-search the schedule's knots (+-1 grid step each) with full runs from
        the initial state, moving when a run beats the best by more than polish_margin.
      polish_steps (optional, default [1]): knot moves tried, in grid steps (e.g. [1, 2]
        also tries two-step moves when one-step moves fail; larger effects beat the noise).
      polish_scale_first (optional, default False): per group, first try scaling its whole
        schedule one grid step; polish its knots only if that changes the score by at least
        2 x polish_margin (skips insensitive groups).
      scan_lookahead (optional, default 0 = the search's lookahead): the coarse scan's
        lookahead is total // scan_lookahead steps (cheaper; x10 steps tolerate the bias).
      passes (optional, default 1; shape="linear"): repeat the online search from the
        initial state; later passes start each interval at the previous pass's knot and use
        the previous pass's schedule as the lookahead (joined from the candidate's value),
        so late, reliable decisions correct the lookahead of early ones.
      reseed (optional, default False): later passes and every polish round use a fresh
        training seed and re-score the incumbent on it, so an incumbent selected for a lucky
        score on one seed does not lock out its neighbours (winner's curse).
      pass_seeds (optional, default 1): later passes score every candidate by the mean
        over this many fresh seeds (MultiTrainer; ~pass_seeds x the cost of those passes).
      plan_tail (optional, default False): in later passes a candidate for an interval's
        end knot scales the plan's whole remaining schedule by candidate / plan value (a
        larger, more detectable move), and the committed choice keeps that scaled tail.
      first_knot (optional, default False; shape="linear"): in the first interval also
        search each LR's start value (the first segment need not be flat).
      freeze_threshold (optional, default 0): after the coarse scan, an LR whose best
        scan score beats the mean of its one-decade neighbours by less than this is frozen
        at its scanned value (no later searching; insensitive groups cost nothing).
      alternate (optional, default 0): after the main search, up to this many rounds of
        re-searching the lookahead (for the chosen main LRs) and then the main LRs.
      revisit (optional, default True): repeat coordinate passes until none moves.
      shape (optional, default "constant"): "linear" makes each searched value the LR
        at the end of its interval, reached linearly from the previous interval's end
        value (piecewise-linear schedules; the first interval is flat).
      final_anneal (optional, default "none"): "linear" makes the final interval decay
        linearly from its searched value to 0; "search" also climbs that annealed form
        and keeps whichever of constant / annealed scores higher.
      larger_within (optional, default 0): after each LR climb, move up the grid while
        the score stays within this of the climb's best (counters short-horizon bias).
      heldout_seeds (optional): after the search, train the committed schedule from
        scratch on these seeds (evaluation only; not part of the search cost).
    Each interval: search the cooldown mults (if searched) given the incumbent main LRs,
    then climb each searched LR in turn; commit the main interval; repeat. The search
    result is the committed run's own final score.
    """
    run_start = time.perf_counter()
    tuning = config["hparam_tuning"]
    missing = AUTO_REQUIRED - tuning.keys()
    extra = tuning.keys() - AUTO_REQUIRED - AUTO_OPTIONAL
    if missing or extra:
        raise ValueError(f"auto: missing {sorted(missing)}; unexpected {sorted(extra)}")
    metric = tuning["metric"]
    params = tuning["params"]
    if not isinstance(params, dict) or not params:
        raise ValueError("auto: params must be a nonempty mapping")
    for path, spec in params.items():
        name, _, field = path.partition(".")
        if field != "initial_lr" or name not in config["param_groups"]:
            raise ValueError(f"auto searches <group>.initial_lr, got {path}")
        require_fields(spec, {"initial", "mult"}, path)
        if not spec["initial"] > 0 or not 0 < spec["mult"] < 1:
            raise ValueError(f"{path}: needs initial > 0 and 0 < mult < 1")
    searched_mode, others_mode = tuning["cooldown_searched"], tuning["cooldown_others"]
    if not (searched_mode in ("search", "linear", "linear_search", "plan", "geometric", "max")
            or isinstance(searched_mode, (int, float))):
        raise ValueError("cooldown_searched must be a number, search, linear, linear_search or plan")
    if not (others_mode in ("continue", "shared", "search") or isinstance(others_mode, (int, float))):
        raise ValueError("cooldown_others must be continue, shared, search or a number")
    margin, max_side = tuning["move_margin"], tuning["max_side_steps"]
    coarse = tuning.get("coarse_mult")
    scan = tuning.get("coarse_scan", 0)
    alternate = tuning.get("alternate", 0)
    scan_lookahead = tuning.get("scan_lookahead", 0)
    freeze_threshold = tuning.get("freeze_threshold", 0.0)
    first_knot = tuning.get("first_knot", False)
    passes = tuning.get("passes", 1)
    reseed = tuning.get("reseed", False)
    pass_seeds = tuning.get("pass_seeds", 1)
    plan_tail = tuning.get("plan_tail", False)
    revisit = tuning.get("revisit", True)
    larger_within = tuning.get("larger_within", 0.0)
    shape = tuning.get("shape", "constant")
    final_anneal = tuning.get("final_anneal", "none")
    if final_anneal not in ("none", "linear", "search"):
        raise ValueError("final_anneal must be none, linear or search")
    if shape not in ("constant", "linear"):
        raise ValueError("shape must be constant or linear")
    if first_knot and shape != "linear":
        raise ValueError("first_knot requires shape='linear'")
    if passes > 1 and shape != "linear":
        raise ValueError("passes > 1 requires shape='linear'")
    log_config(run, config, label="base_config")

    trainer = SegmentTrainer(model, config)
    initial_state = trainer.snapshot()
    total = trainer.total_steps
    interval_steps = total // tuning["interval_fraction"]
    cooldown_steps = total // tuning["cooldown_fraction"] if tuning["cooldown_fraction"] else 0
    committed = copy.deepcopy(trainer.base_schedules)
    current = {path: snap_lr_to_grid(spec["initial"], spec["mult"]) for path, spec in params.items()}
    mults = {
        "searched": (1.0 if searched_mode in ("search", "linear", "linear_search", "plan",
                                              "geometric", "max")
                     else float(searched_mode)),
        "others": (1.0 if others_mode == "search"
                   else None if others_mode in ("continue", "shared") else float(others_mode)),
    }
    if searched_mode in ("geometric", "max"):  # Lookahead knots decay by a searched ratio.
        mults["ratio"] = 0.64
    if searched_mode == "plan":  # Absolute lookahead start level per searched group.
        mults.update({f"plan:{path}": value for path, value in current.items()})
    other_paths = [
        path for path, lines in trainer.base_schedules.items()
        if path.endswith(".initial_lr") and path not in params and not is_zero_lr_schedule(lines)
    ]
    evaluations = 0
    history = []
    knots = {}  # shape="linear": each searched LR at the end of the last committed interval

    anneal_now = False  # The final interval decays to 0 (final_anneal).
    look_override = None  # The coarse scan's own (shorter) lookahead.
    frozen = set()  # LRs found insensitive by the coarse scan (freeze_threshold).

    def main_window(lines, path, start, steps, value, first_override):
        first = (first_override if first_override is not None
                 else knots.get(path, value) if shape == "linear" else value)
        if anneal_now:
            return linear_window(lines, start, steps, first, 0.0)
        if shape == "linear":
            return linear_window(lines, start, steps, first, value)
        return constant_window(lines, start, steps, value)

    plan = None  # passes > 1: the previous pass's committed schedules of searched LRs
    for pass_index in range(passes):
        if pass_index:
            plan = {path: list(committed[path]) for path in params}
            if pass_seeds > 1:  # Score later passes by the mean over fresh seeds.
                trainer = MultiTrainer(model, config, [
                    TRAINING_SEED + 1000 * pass_index + j for j in range(pass_seeds)])
                initial_state = trainer.snapshot()
            elif reseed:  # A fresh seed: the plan's own (selected, lucky) score is not reused.
                trainer = segment_trainer_with_seed(model, config, TRAINING_SEED + 1000 * pass_index)
                initial_state = trainer.snapshot()
            trainer.restore(initial_state)
            committed = copy.deepcopy(trainer.base_schedules)
            knots.clear()
            log_event("auto_pass", run=run, pass_index=pass_index, evaluations=evaluations)
        while trainer.step < total:
            start = trainer.step
            main_steps = min(interval_steps, total - start)
            # Later passes follow the plan to the end of the run (it includes the anneal).
            look = (min(cooldown_steps, total - start - main_steps) if plan is None
                    else total - start - main_steps)
            state = trainer.snapshot()
            cache = {}
            if plan is not None:
                current = {path: plan_end_value(plan[path], start + main_steps) for path in params}

            def evaluate(values, cool):
                nonlocal evaluations
                look_eff = look if look_override is None else look_override
                key = (tuple(sorted(values.items())), tuple(sorted(cool.items())), anneal_now, look_eff)
                if key in cache:
                    return cache[key]
                trainer.restore(state)
                sched = dict(committed)
                for path, value in values.items():
                    if path.endswith("@start"):
                        continue
                    sched[path] = main_window(committed[path], path, start, main_steps, value,
                                              values.get(path + "@start"))
                ok = trainer.train(sched, main_steps)
                if ok and look_eff and plan is not None:
                    # Follow the previous pass's schedule, joined from the candidate's value.
                    cool_start = start + main_steps
                    for path, value in values.items():
                        if path.endswith("@start"):
                            continue
                        rest = slice_schedule(plan[path], cool_start, cool_start + look_eff)
                        if plan_tail and rest[0][1] > 0:  # Scale the plan's whole tail.
                            factor = value / rest[0][1]
                            rest = [(seg[0], *(v * factor for v in seg[1:])) for seg in rest]
                        rest[0] = (rest[0][0], value, rest[0][-1])
                        sched[path] = segments_window(sched[path], cool_start, rest)
                    ok = trainer.train(sched, look_eff)
                if ok and look_eff and plan is None and searched_mode == "max":
                    # The better of a linear (to 0) and a geometric (searched ratio) lookahead.
                    cool_start = start + main_steps
                    main_state = trainer.snapshot()
                    results = []
                    for kind in ("linear", "geometric"):
                        trainer.restore(main_state)
                        cool_sched = dict(sched)
                        for path, value in values.items():
                            if path.endswith("@start"):
                                continue
                            cool_sched[path] = (
                                linear_window(sched[path], cool_start, look_eff, value, 0.0)
                                if kind == "linear" else
                                segments_window(sched[path], cool_start, geometric_lookahead(
                                    value, cool["ratio"], look_eff, interval_steps)))
                        results.append(trainer.score(metric) if trainer.train(cool_sched, look_eff)
                                       else float("-inf"))
                    value = max(results)
                    value = value if isfinite(value) else float("-inf")
                    evaluations += 1
                    cache[key] = value
                    print(f"  eval {hparam_text(values)} cooldown={hparam_text(cool)} "
                          f"linear={format_log_value(results[0])} geometric={format_log_value(results[1])} "
                          f"{metric}={format_log_value(value)}", flush=True)
                    return value
                if ok and look_eff and plan is None:
                    cool_start = start + main_steps
                    for path, value in values.items():
                        if path.endswith("@start"):
                            continue
                        if searched_mode == "geometric":
                            sched[path] = segments_window(sched[path], cool_start, geometric_lookahead(
                                value, cool["ratio"], look_eff, interval_steps))
                        elif searched_mode == "plan":
                            sched[path] = linear_window(sched[path], cool_start, look_eff,
                                                        cool[f"plan:{path}"], 0.0)
                        elif searched_mode in ("linear", "linear_search"):
                            sched[path] = linear_window(sched[path], cool_start, look_eff,
                                                        cool["searched"] * value, 0.0)
                        else:
                            sched[path] = constant_window(sched[path], cool_start, look_eff,
                                                          cool["searched"] * value)
                    others = cool["searched"] if others_mode == "shared" else cool["others"]
                    if others is not None:
                        for path in other_paths:
                            sched[path] = constant_window(
                                committed[path], cool_start, look_eff,
                                others * window_mean(committed[path], start, main_steps))
                    ok = trainer.train(sched, look_eff)
                value = trainer.score(metric) if ok else float("-inf")
                value = value if isfinite(value) else float("-inf")
                evaluations += 1
                cache[key] = value
                print(f"  eval {hparam_text(values)} cooldown={hparam_text(cool)} "
                      f"{metric}={format_log_value(value)}", flush=True)
                return value

            def climb(point, key, score_of, neighbour):
                """Move one coordinate while a neighbour beats the incumbent by > margin."""
                best = score_of(point)
                for direction in (1, -1):
                    incumbent, incumbent_score, steps = point, best, 0
                    while steps < max_side:
                        value = neighbour(incumbent[key], direction)
                        if value is None:
                            break
                        candidate = dict(incumbent, **{key: value})
                        candidate_score = score_of(candidate)
                        if candidate_score <= incumbent_score + margin:
                            break
                        incumbent, incumbent_score, steps = candidate, candidate_score, steps + 1
                    if steps:
                        return incumbent, incumbent_score, True
                return point, best, False

            def search_mults():
                nonlocal mults
                keys = [k for k, mode in (("searched", searched_mode), ("others", others_mode))
                        if mode in ("search", "linear_search") and (k == "searched" or other_paths)]
                if searched_mode == "plan":
                    keys = [key for key in mults if key.startswith("plan:")]
                if searched_mode in ("geometric", "max"):
                    keys = ["ratio"]
                def capped_grid(cap):
                    return lambda v, d: grid_neighbour(v, 0.6, d, cap)

                def ratio_grid(v, d):
                    return grid_neighbour(v, 0.8, d, 1.0)

                for key in keys:
                    mults, _, _ = climb(mults, key, lambda m: evaluate(current, m),
                                        ratio_grid if key == "ratio"
                                        else capped_grid(None if key.startswith("plan:") else 1.0))

            def search_main(grid_of):
                nonlocal current

                def neighbour_on_grid(path):
                    return lambda v, d: grid_neighbour(v, grid_of(path.split("@")[0]), d, None)

                for _ in range(10 if revisit else 1):
                    moved_any = False
                    for path in [p for p in current if p.split("@")[0] not in frozen]:
                        current, best, moved = climb(
                            current, path, lambda values: evaluate(values, mults),
                            neighbour_on_grid(path))
                        # Short lookaheads favour small LRs: take the largest LR within
                        # larger_within of the best (upward neighbours are mostly cached).
                        while larger_within:
                            value = grid_neighbour(current[path], grid_of(path.split("@")[0]), 1,
                                                   None)
                            candidate = dict(current, **{path: value})
                            if evaluate(candidate, mults) < best - larger_within:
                                break
                            current, moved = candidate, True
                        moved_any |= moved
                    if not moved_any:
                        break

            before = evaluations
            if look and plan is None:
                search_mults()
            if start == 0 and scan and plan is None:
                # Scan each LR over x10 steps (+-scan decades), keep the best, then refine.
                if scan_lookahead:
                    look_override = min(total // scan_lookahead, total - main_steps)
                for path in params:
                    values = [round_hparam(current[path] * 10.0 ** k) for k in range(-scan, scan + 1)]
                    scores = {v: evaluate(dict(current, **{path: v}), mults) for v in values}
                    best = max(values, key=lambda v: scores[v])
                    current = dict(current, **{path: best})
                    # Flat around the best (one decade either side): freeze this LR.
                    i = values.index(best)
                    sides = [scores[values[j]] for j in (i - 1, i + 1) if 0 <= j < len(values)]
                    if freeze_threshold and scores[best] - sum(sides) / len(sides) < freeze_threshold:
                        frozen.add(path)
                        print(f"  frozen {path}={best}", flush=True)
                look_override = None
                current = {path: snap_lr_to_grid(v, params[path]["mult"]) for path, v in current.items()}
            if start == 0 and coarse and plan is None:
                search_main(lambda path: coarse)
                current = {path: snap_lr_to_grid(v, params[path]["mult"]) for path, v in current.items()}
            if start == 0 and first_knot:
                current.update({f"{path}@start": plan[path][0][1] if plan else current[path]
                                for path in params})
            final = start + main_steps == total
            anneal_now = final and final_anneal == "linear"
            search_main(lambda path: params[path]["mult"])
            # Re-search the lookahead for the chosen main LRs, then the main LRs, until stable.
            for _ in range(alternate if look else 0):
                before_round = (dict(current), dict(mults))
                search_mults()
                search_main(lambda path: params[path]["mult"])
                if (dict(current), dict(mults)) == before_round:
                    break
            if final and final_anneal == "search":
                constant_values, constant_score = dict(current), evaluate(current, mults)
                anneal_now = True
                search_main(lambda path: params[path]["mult"])
                if evaluate(current, mults) <= constant_score:
                    anneal_now, current = False, constant_values
            selected = evaluate(current, mults)
            trainer.restore(state)
            for path, value in current.items():
                if path.endswith("@start"):
                    continue
                committed[path] = main_window(committed[path], path, start, main_steps, value,
                                              current.get(path + "@start"))
                knots[path] = value
            if plan is not None and plan_tail:  # Keep the scaled tail for later intervals.
                end = start + main_steps
                for path, value in current.items():
                    if path.endswith("@start") or end >= total:
                        continue
                    old = plan_end_value(plan[path], end)
                    if old > 0:
                        tail = [(seg[0], *(v * value / old for v in seg[1:]))
                                for seg in slice_schedule(plan[path], end, total)]
                        plan[path] = slice_schedule(plan[path], 0, end) + tail
            start_knots = {p: v for p, v in current.items() if p.endswith("@start")}
            current = {p: v for p, v in current.items() if not p.endswith("@start")}
            if not trainer.train(committed, main_steps):
                raise RuntimeError(f"Committed interval diverged at step {start}")
            history.append(dict(start_step=start, steps=main_steps, lookahead=look,
                                main=dict(current, **start_knots), mults=dict(mults), score=selected,
                                evaluations=evaluations - before))
            log_event("auto_interval", run=run, interval=len(history) - 1, start_step=start,
                      annealed=anneal_now,
                      evaluations=evaluations - before, **{metric: selected}, **current, **start_knots,
                      **{f"cooldown.{k}": v for k, v in mults.items() if v is not None})

    polish_rounds = tuning.get("polish_rounds", 0)
    if polish_rounds:
        if shape != "linear":
            raise ValueError("polish_rounds requires shape='linear'")
        polish_margin = tuning.get("polish_margin", 0.0)
        polish_scale_first = tuning.get("polish_scale_first", False)
        polish_steps = tuning.get("polish_steps", [1])
        knots_of = {
            path: [committed[path][0][1]] + [line[2] for line in committed[path]]
            for path in params
        }
        lengths = {path: [line[0] for line in committed[path]] for path in params}
        polish_cache = {}

        def full_run(knot_values):
            nonlocal evaluations
            key = tuple((path, tuple(k)) for path, k in sorted(knot_values.items()))
            if key in polish_cache:
                return polish_cache[key]
            trainer.restore(initial_state)
            sched = dict(committed)
            for path, k in knot_values.items():
                sched[path] = [(n, a, b) for n, a, b in zip(lengths[path], k, k[1:])]
            ok = trainer.train(sched, total)
            value = trainer.score(metric) if ok else float("-inf")
            value = value if isfinite(value) else float("-inf")
            evaluations += 1
            polish_cache[key] = value
            print(f"  polish {json.dumps(knot_values)} {metric}={format_log_value(value)}", flush=True)
            return value

        best_knots = copy.deepcopy(knots_of)
        best_score = full_run(best_knots)
        # An accepted candidate was never evaluated before (the best only rises), so the
        # trainer holds its final state: keep it as the result (no replay).
        accepted_state = trainer.snapshot()
        for round_index in range(polish_rounds):
            if reseed:  # Re-score the incumbent on a fresh seed every round.
                trainer = segment_trainer_with_seed(
                    model, config, TRAINING_SEED + 1000 * (passes + round_index))
                initial_state = trainer.snapshot()
                polish_cache.clear()
                best_score = full_run(best_knots)
                accepted_state = trainer.snapshot()
            moved = False
            for path in params:
                # Whole-schedule scale moves first; knot moves only for groups where a
                # scale step changes the score by >= 2 x polish_margin (sensitive groups).
                sensitive = not polish_scale_first
                if polish_scale_first:
                    for direction in (1, -1):
                        candidate = copy.deepcopy(best_knots)
                        candidate[path] = [
                            grid_neighbour(k, params[path]["mult"], direction, None) or k
                            for k in best_knots[path]]
                        score = full_run(candidate)
                        if score > best_score + polish_margin:
                            best_knots, best_score, moved = candidate, score, True
                            accepted_state = trainer.snapshot()
                            sensitive = True
                            break
                        sensitive |= best_score - score >= 2 * polish_margin
                if not sensitive:
                    continue
                for index in range(len(best_knots[path])):
                    for direction in [sign * step for step in polish_steps for sign in (1, -1)]:
                        knot = best_knots[path][index]
                        value = (round_hparam(params[path]["mult"] ** (
                            lr_grid_index(knot, params[path]["mult"]) - direction))
                            if knot > 0 else None)
                        if value is None:
                            continue
                        candidate = copy.deepcopy(best_knots)
                        candidate[path][index] = value
                        score = full_run(candidate)
                        if score > best_score + polish_margin:
                            best_knots, best_score, moved = candidate, score, True
                            accepted_state = trainer.snapshot()
                            break
            log_event("auto_polish_round", run=run, round=round_index, evaluations=evaluations,
                      **{metric: best_score})
            if not moved:
                break
        for path, k in best_knots.items():
            committed[path] = [(n, a, b) for n, a, b in zip(lengths[path], k, k[1:])]
        trainer.restore(accepted_state)

    val_acc = trainer.score("val_acc")
    tta_val_acc = trainer.score("tta_val_acc")
    if trainer.device.type == "cuda":
        torch.cuda.synchronize(trainer.device)
    seconds = time.perf_counter() - run_start
    log_event("auto_result", run=run, val_acc=val_acc, tta_val_acc=tta_val_acc,
              search_seconds=seconds, evaluations=evaluations, train_steps=trainer.train_steps)
    log_final_eval(val_acc, tta_val_acc, seconds)
    final = copy.deepcopy(dict(config, hparam_tuning=None))
    for path in params:
        name = path.split(".", 1)[0]
        final["param_groups"][name]["lr_scheduler"] = [list(line) for line in committed[path]]
    for name in params:
        print(f"  final {name}: {json.dumps(committed[name])}", flush=True)
    result = dict(val_acc=val_acc, tta_val_acc=tta_val_acc, seconds=seconds,
                  evaluations=evaluations, intervals=history)
    heldout = tuning.get("heldout_seeds")
    if heldout:
        held_start = time.perf_counter()
        scores = [run_seeded(f"{run}.heldout{seed}", model, final, seed, debug=False)
                  for seed in heldout]
        values = [s["tta_val_acc"] for s in scores]
        mean = sum(values) / len(values)
        sd = (sum((v - mean) ** 2 for v in values) / (len(values) - 1)) ** 0.5 if len(values) > 1 else 0.0
        log_event("heldout_result", run=run, seeds=heldout, tta_val_acc_mean=mean,
                  tta_val_acc_std=sd, per_seed=values, seconds=time.perf_counter() - held_start)
        result.update(heldout_mean=mean, heldout_std=sd, heldout=values)
    return dict(best_config=final, best_result=result, trials=[dict(run=run, config=final, result=result)])


def family_schedule(family, values, total):
    """One group's lr_scheduler from a parameterized family (see run_global_family_search)."""
    kind = family["kind"]
    if kind == "intervals":
        n = family["n"]
        bounds = [total * i // n for i in range(n + 1)]
        return [(b - a, values[f"v{i}"]) for i, (a, b) in enumerate(zip(bounds, bounds[1:]))]
    if kind == "linear":
        return [(total, values["lr"], 0.0)]
    if kind == "power":
        return [(1, values["lr"] * (1 - step / total) ** values["power"]) for step in range(total)]
    if kind == "knots":
        steps = [round(total * x) for x in family["positions"]] + [total]
        levels = [values[f"k{i}"] for i in range(len(family["positions"]))] + [0.0]
        return [(b - a, va, vb) for a, b, va, vb in zip(steps, steps[1:], levels, levels[1:])]
    raise ValueError(f"unknown schedule family {kind!r}")


def family_initial(family, group, total):
    """Start values: the oracle spec (the configured schedule divided by the group's
    lr_transform, if any) projected onto the family: interval means / knot values on the LR
    grid; linear and power start at the configured initial LR with power 1."""
    lines = group["lr_scheduler"]
    transform = group.get("lr_transform")

    def oracle(step):
        value = schedule_value_at_step(lines, min(step, total - 1))
        return value / lr_transform_factor(transform, step, total) if transform else value

    kind = family["kind"]
    if kind == "intervals":
        n = family["n"]
        bounds = [total * i // n for i in range(n + 1)]
        return {f"v{i}": sum(oracle(t) for t in range(a, b)) / (b - a)
                for i, (a, b) in enumerate(zip(bounds, bounds[1:]))}
    if kind in ("linear", "power"):
        start = {"lr": lines[0][1]}
        if kind == "power":
            start["power"] = 1.0
        return start
    return {f"k{i}": oracle(round(total * x)) for i, x in enumerate(family["positions"])}


def run_global_family_search(run, model, config):
    """Generalized global_neighbour search over a parameterized schedule family for one group.

    hparam_tuning: group (the searched group), family (kind "intervals" with n equal constant
    intervals, "linear" decay to 0, "power" lr * (1 - t)^power, or "knots" at fractional
    positions, linear in between and 0 at the end), metric, max_side_steps, heldout_seeds.
    Every family parameter is searched on a multiplicative grid (LR values x0.6, power x0.8)
    by directional_search (coordinate moves while the score improves), each candidate a full
    training run on the current seed from the same initial state. The start (the oracle
    projected onto the family, family_initial) and the best schedule are then retrained on the
    held-out seeds (evaluation only).
    """
    run_start = time.perf_counter()
    tuning = config["hparam_tuning"]
    require_fields(tuning, {"algorithm", "metric", "group", "family", "max_side_steps",
                            "heldout_seeds"}, "hparam_tuning")
    name = tuning["group"]
    family = tuning["family"]
    group = config["param_groups"][name]
    log_config(run, config, label="base_config")
    trainer = SegmentTrainer(model, config)
    initial_state = trainer.snapshot()
    total = trainer.total_steps
    start = family_initial(family, group, total)
    factors = {key: (0.8 if key == "power" else 0.6) for key in start}
    choices = {key: None for key in start}
    evaluations = 0

    def score(values):
        nonlocal evaluations
        trainer.restore(initial_state)
        sched = dict(trainer.base_schedules)
        sched[f"{name}.initial_lr"] = family_schedule(family, values, total)
        ok = trainer.train(sched, total)
        value = trainer.score(tuning["metric"]) if ok else float("-inf")
        evaluations += 1
        print(f"  family_eval {hparam_text(values)} {tuning['metric']}={format_log_value(value)}",
              flush=True)
        return value

    snapped = {key: snap_lr_to_grid(v, factors[key]) for key, v in start.items()}

    def on_event(event, point, **fields):
        if event == "search_path":
            log_event("search_path", run=run, **point, **fields)

    best, best_score = directional_search(
        snapped, choices, score, initial_lr_search=False, factors=factors,
        max_side_steps=tuning["max_side_steps"], dropoff_margin=None, on_event=on_event)
    seconds = time.perf_counter() - run_start
    log_event("auto_result", run=run, val_acc=0.0, tta_val_acc=best_score, search_seconds=seconds,
              evaluations=evaluations, train_steps=trainer.train_steps)
    for label, values in (("start", snapped), ("final", best)):
        lines = family_schedule(family, values, total)
        print(f"  {label} {name}.initial_lr: {json.dumps(values)}", flush=True)
        candidate = copy.deepcopy(dict(config, hparam_tuning=None))
        candidate["param_groups"][name]["lr_scheduler"] = [list(line) for line in lines]
        held_start = time.perf_counter()
        scores = [run_seeded(f"{run}.{label}{seed}", model, candidate, seed, debug=False)["tta_val_acc"]
                  for seed in tuning["heldout_seeds"]]
        mean = sum(scores) / len(scores)
        sd = (sum((v - mean) ** 2 for v in scores) / (len(scores) - 1)) ** 0.5 if len(scores) > 1 else 0.0
        log_event("heldout_result" if label == "final" else "start_heldout_result", run=run,
                  seeds=tuning["heldout_seeds"], tta_val_acc_mean=mean, tta_val_acc_std=sd,
                  per_seed=scores, seconds=time.perf_counter() - held_start)
    result = dict(val_acc=0.0, tta_val_acc=best_score, seconds=seconds, evaluations=evaluations,
                  best=best, start=snapped)
    return dict(best_config=config, best_result=result, trials=[dict(run=run, config=config, result=result)])


def run_noisy_family_search(run, model, config):
    """Noise-aware global_neighbour search over a parameterized schedule family for one group.

    hparam_tuning: group, family (as in run_global_family_search), metric, noise_sd (the SD of
    one run's metric across seeds), confidence, max_seeds, heldout_seeds. Each round compares the
    current schedule with all of its neighbours (every family parameter one grid step up or
    down; LR values x0.6, power x0.8), each scored by its mean metric over full training runs on
    search seeds 0, 1, ... A neighbour is better when the lower confidence bound of (its mean -
    the current mean) is above 0, and cannot be better when the upper bound is below 0; the
    standard error is noise_sd * sqrt(1/n_neighbour + 1/n_current) and the bounds are one-sided
    at confidence, Bonferroni-corrected over the neighbours. If some neighbours are better, move
    to the one with the highest mean. Otherwise run one more seed on the current schedule and on
    every neighbour that may still be better, and repeat; stop when no neighbour may be better,
    or when they all reached max_seeds (undecided neighbours then count as not better). The
    start (family_initial) and the final schedule are then retrained on the held-out seeds.
    """
    run_start = time.perf_counter()
    tuning = config["hparam_tuning"]
    require_fields(tuning, {"algorithm", "metric", "group", "family", "noise_sd", "confidence",
                            "max_seeds", "heldout_seeds"}, "hparam_tuning")
    name = tuning["group"]
    family = tuning["family"]
    sigma = tuning["noise_sd"]
    max_seeds = tuning["max_seeds"]
    total = config["param_groups"][name]["lr_scheduler"]
    total = sum(int(line[0]) for line in total)
    log_config(run, config, label="base_config")
    start = family_initial(family, config["param_groups"][name], total)
    factors = {key: (0.8 if key == "power" else 0.6) for key in start}
    current = {key: snap_lr_to_grid(v, factors[key]) for key, v in start.items()}
    snapped = dict(current)
    scores = {}

    def key_of(values):
        return tuple(values[k] for k in factors)

    def ensure(values, n):
        runs = scores.setdefault(key_of(values), [])
        while len(runs) < min(n, max_seeds):
            seed = len(runs)
            candidate = copy.deepcopy(dict(config, hparam_tuning=None))
            candidate["param_groups"][name]["lr_scheduler"] = [
                list(line) for line in family_schedule(family, values, total)]
            value = run_seeded(f"{run}.s{seed}", model, candidate, seed, debug=False)[tuning["metric"]]
            runs.append(value if isfinite(value) else 0.0)
            print(f"  family_eval {hparam_text(values)} seed={seed} {tuning['metric']}={format_log_value(runs[-1])}",
                  flush=True)
        return runs

    def mean(values):
        runs = scores[key_of(values)]
        return sum(runs) / len(runs), len(runs)

    def neighbours(values):
        out = []
        for k, f in factors.items():
            index = lr_grid_index(values[k], f)
            for step in (1, -1):
                value = round_hparam(f ** (index - step))
                if isfinite(value) and value > 0 and value != values[k]:
                    out.append(dict(values, **{k: value}))
        return out

    ensure(current, 1)
    moves = 0
    while True:
        nbrs = neighbours(current)
        z = NormalDist().inv_cdf(1 - (1 - tuning["confidence"]) / len(nbrs))
        for y in nbrs:
            ensure(y, 1)
        open_set = list(nbrs)
        while True:
            m_x, n_x = mean(current)
            stats = []
            for y in nbrs:
                m_y, n_y = mean(y)
                se = sigma * (1 / n_x + 1 / n_y) ** 0.5
                stats.append((y, m_y - m_x, se, n_y))
            better = [(y, d) for y, d, se, _ in stats if d - z * se > 0]
            open_set = [y for y, d, se, _ in stats if d + z * se >= 0]
            log_event("noisy_round", run=run, **current, mean=m_x, seeds=n_x, z=z,
                      better=len(better), open=len(open_set))
            if better:
                y = max(better, key=lambda item: mean(item[0])[0])[0]
                current, moves = y, moves + 1
                m, n = mean(current)
                log_event("search_path", run=run, **current, score=m, seeds=n, reason="better")
                break
            if not open_set:
                reason = "none_can_be_better"
                break
            added = len(scores[key_of(current)])
            ensure(current, n_x + 1)
            for y in open_set:
                ensure(y, mean(y)[1] + 1)
            if len(scores[key_of(current)]) == added and all(mean(y)[1] >= max_seeds for y in open_set):
                reason = "max_seeds"
                break
        if not better:
            break
    m, n = mean(current)
    evaluations = sum(len(v) for v in scores.values())
    seconds = time.perf_counter() - run_start
    log_event("search_stop", run=run, reason=reason, moves=moves)
    log_event("auto_result", run=run, val_acc=0.0, tta_val_acc=m, search_seconds=seconds,
              evaluations=evaluations, train_steps=evaluations * total, search_seeds=n)
    for label, values in (("start", snapped), ("final", current)):
        print(f"  {label} {name}.initial_lr: {json.dumps(values)}", flush=True)
        candidate = copy.deepcopy(dict(config, hparam_tuning=None))
        candidate["param_groups"][name]["lr_scheduler"] = [list(line) for line in family_schedule(family, values, total)]
        held_start = time.perf_counter()
        held = [run_seeded(f"{run}.{label}{seed}", model, candidate, seed, debug=False)["tta_val_acc"]
                for seed in tuning["heldout_seeds"]]
        avg = sum(held) / len(held)
        sd = (sum((v - avg) ** 2 for v in held) / (len(held) - 1)) ** 0.5 if len(held) > 1 else 0.0
        log_event("heldout_result" if label == "final" else "start_heldout_result", run=run,
                  seeds=tuning["heldout_seeds"], tta_val_acc_mean=avg, tta_val_acc_std=sd, per_seed=held,
                  seconds=time.perf_counter() - held_start)
    result = dict(val_acc=0.0, tta_val_acc=m, seconds=seconds, evaluations=evaluations, best=current,
                  start=snapped)
    return dict(best_config=config, best_result=result, trials=[dict(run=run, config=config, result=result)])


def run_guided_family_search(run, model, config):
    """Guided global_neighbour search over a parameterized schedule family for one group:
    cheap deep exploration, a smooth fit along each parameter, and a significance gate on fresh
    seeds.

    hparam_tuning: group, family (as in run_global_family_search), metric, noise_sd (the SD of
    one run's metric across seeds), confidence, max_depth, max_candidates, max_seeds,
    selection ("raw" or "lcb"), heldout_seeds. Each round, from the current schedule (the anchor):
      1. Explore: along each family parameter and direction, step the parameter one grid step
         at a time (LR values x0.6, power x0.8), one run each on seed 0, while the run is not
         clearly worse than the best run on that line (score >= best - z * noise_sd * sqrt(2),
         z one-sided at confidence), up to max_depth steps.
      2. Fit: along each parameter, a least-squares quadratic in the grid offset through all of
         that line's seed-0 runs (the anchor's included); the predicted gain of an offset is the
         fit there minus the fit at the anchor.
      3. Propose: each parameter moved alone to its best fitted offset, and the joint move of
         every parameter with a positive predicted gain (predicted gain = their sum); keep the
         max_candidates largest predicted gains.
         With selection = "lcb" (Experiment 11) instead: each parameter's offset (other than the
         anchor's) maximizes the fit's lower confidence bound, gain - z * SE (SE from the
         regression with noise_sd per run), single-parameter moves with a positive gain are
         ranked by that bound, the joint move only combines parameters whose bound is above 0,
         and it is verified only if none of the max_candidates best single moves proves better.
      4. Verify on fresh seeds 1, 2, ...: as in run_noisy_family_search, a candidate is better
         when the lower confidence bound of (its mean - the anchor's mean) is above 0 and is
         ruled out when the upper bound is below 0 (Bonferroni over the candidates); otherwise
         one more seed for the anchor and the undecided candidates, up to max_seeds.
    Move to the better candidate with the highest mean; stop when no candidate is predicted to
    gain or none proves better. The start (family_initial) and the final schedule are then
    retrained on the held-out seeds.
    """
    run_start = time.perf_counter()
    tuning = config["hparam_tuning"]
    require_fields(tuning, {"algorithm", "metric", "group", "family", "noise_sd", "confidence", "max_depth",
                            "max_candidates", "max_seeds", "selection", "heldout_seeds"}, "hparam_tuning")
    name = tuning["group"]
    family = tuning["family"]
    sigma = tuning["noise_sd"]
    max_seeds = tuning["max_seeds"]
    total = sum(int(line[0]) for line in config["param_groups"][name]["lr_scheduler"])
    log_config(run, config, label="base_config")
    start = family_initial(family, config["param_groups"][name], total)
    factors = {key: (0.8 if key == "power" else 0.6) for key in start}
    anchor = {key: snap_lr_to_grid(v, factors[key]) for key, v in start.items()}
    snapped = dict(anchor)
    runs = {}  # (point key, seed) -> metric
    z_line = NormalDist().inv_cdf(tuning["confidence"])

    def key_of(values):
        return tuple(values[k] for k in factors)

    def score(values, seed):
        cache_key = (key_of(values), seed)
        if cache_key not in runs:
            candidate = copy.deepcopy(dict(config, hparam_tuning=None))
            candidate["param_groups"][name]["lr_scheduler"] = [
                list(line) for line in family_schedule(family, values, total)]
            value = run_seeded(f"{run}.s{seed}", model, candidate, seed, debug=False)[tuning["metric"]]
            runs[cache_key] = value if isfinite(value) else 0.0
            print(f"  family_eval {hparam_text(values)} seed={seed} {tuning['metric']}={format_log_value(runs[cache_key])}",
                  flush=True)
        return runs[cache_key]

    def verified(values):
        out = [runs[(key_of(values), seed)] for seed in range(1, max_seeds + 1) if (key_of(values), seed) in runs]
        return sum(out) / len(out) if out else float("-inf"), len(out)

    def verify(values, n):
        for seed in range(1, min(n, max_seeds) + 1):
            score(values, seed)

    def moved(values, k, offset):
        return dict(values, **{k: round_hparam(factors[k] ** (lr_grid_index(values[k], factors[k]) - offset))})

    def race(candidates, stage):
        """Verify candidates against the anchor on fresh seeds; return those proven better."""
        z = NormalDist().inv_cdf(1 - (1 - tuning["confidence"]) / len(candidates))
        points = [point for _, point in candidates]
        verify(anchor, 1)
        for point in points:
            verify(point, 1)
        while True:
            m_a, n_a = verified(anchor)
            stats = []
            for point in points:
                m, n = verified(point)
                stats.append((point, m - m_a, sigma * (1 / n_a + 1 / n) ** 0.5, n))
            better = [point for point, d, se, _ in stats if d - z * se > 0]
            undecided = [point for point, d, se, _ in stats if d + z * se >= 0 and d - z * se <= 0]
            log_event("guided_round", run=run, **anchor, stage=stage, mean=m_a, seeds=n_a, z=z,
                      candidates=len(points), better=len(better), undecided=len(undecided),
                      predicted=[gain for gain, _ in candidates], verified=[d for _, d, _, _ in stats])
            if better or not undecided:
                return better
            if n_a >= max_seeds and all(n >= max_seeds for point, _, _, n in stats if point in undecided):
                return better
            verify(anchor, n_a + 1)
            for point in undecided:
                verify(point, verified(point)[1] + 1)

    if tuning["selection"] not in ("raw", "lcb"):
        raise ValueError("guided_family selection must be raw or lcb")
    lcb = tuning["selection"] == "lcb"
    moves, rounds = 0, 0
    while True:
        rounds += 1
        base = score(anchor, 0)
        singles, positive = [], []
        for k in factors:
            line = {0: base}
            for direction in (1, -1):
                best = base
                for step in range(1, tuning["max_depth"] + 1):
                    point = moved(anchor, k, direction * step)
                    if not (isfinite(point[k]) and point[k] > 0):
                        break
                    value = score(point, 0)
                    line[direction * step] = value
                    if value < best - z_line * sigma * 2 ** 0.5:
                        break
                    best = max(best, value)
            offsets = sorted(line)
            design = np.array([[o * o, o, 1.0] for o in offsets])
            coef = np.linalg.lstsq(design, np.array([line[o] for o in offsets]), rcond=None)[0]
            cov = sigma ** 2 * np.linalg.pinv(design.T @ design)
            gains = {}
            for o in offsets:  # Fit at o minus fit at the anchor, and its standard error.
                c = np.array([o * o, o, 0.0])
                gains[o] = (float(c @ coef), float(max(c @ cov @ c, 0.0)) ** 0.5)
            if lcb:  # The offset with the best lower bound: noisy extrapolations rank low.
                best_offset = max((o for o in offsets if o != 0), key=lambda o: gains[o][0] - z_line * gains[o][1])
            else:
                best_offset = max(offsets, key=lambda o: gains[o][0])
            gain, gain_se = gains[best_offset]
            bound = gain - z_line * gain_se
            log_event("guided_line", run=run, parameter=k, offsets=offsets, seed0=[line[o] for o in offsets],
                      fitted=[gains[o][0] for o in offsets], fitted_se=[gains[o][1] for o in offsets],
                      best_offset=best_offset, predicted_gain=gain, predicted_se=gain_se, lower_bound=bound)
            if best_offset != 0 and gain > 0:
                singles.append((bound if lcb else gain, gain, moved(anchor, k, best_offset)))
                if not lcb or bound > 0:
                    positive.append((k, best_offset, gain))
        joint = None
        if len(positive) >= 2:
            joint_point = dict(anchor)
            for k, offset, _ in positive:
                joint_point = moved(joint_point, k, offset)
            joint = (sum(gain for _, _, gain in positive), joint_point)
        ranked = sorted(singles, key=lambda item: -item[0])
        if lcb:  # Single-parameter moves first; the joint move only if none of them proves better.
            stages = [[(gain, point) for _, gain, point in ranked[:tuning["max_candidates"]]], [joint] if joint else []]
        else:
            pool = [(gain, point) for _, gain, point in ranked] + ([joint] if joint else [])
            stages = [sorted(pool, key=lambda item: -item[0])[:tuning["max_candidates"]]]
        stages = [stage for stage in stages if stage]
        if not stages:
            reason = "no_predicted_gain"
            break
        for stage, candidates in enumerate(stages):
            better = race(candidates, stage)
            if better:
                break
        if not better:
            reason = "none_proved_better"
            break
        anchor, moves = max(better, key=lambda point: verified(point)[0]), moves + 1
        m, n = verified(anchor)
        log_event("search_path", run=run, **anchor, score=m, seeds=n, reason="better")
    m, n = verified(anchor)
    evaluations = len(runs)
    seconds = time.perf_counter() - run_start
    log_event("search_stop", run=run, reason=reason, moves=moves)
    log_event("auto_result", run=run, val_acc=0.0, tta_val_acc=m, search_seconds=seconds,
              evaluations=evaluations, train_steps=evaluations * total, search_seeds=n)
    for label, values in (("start", snapped), ("final", anchor)):
        print(f"  {label} {name}.initial_lr: {json.dumps(values)}", flush=True)
        candidate = copy.deepcopy(dict(config, hparam_tuning=None))
        candidate["param_groups"][name]["lr_scheduler"] = [list(line) for line in family_schedule(family, values, total)]
        held_start = time.perf_counter()
        held = [run_seeded(f"{run}.{label}{seed}", model, candidate, seed, debug=False)["tta_val_acc"]
                for seed in tuning["heldout_seeds"]]
        avg = sum(held) / len(held)
        sd = (sum((v - avg) ** 2 for v in held) / (len(held) - 1)) ** 0.5 if len(held) > 1 else 0.0
        log_event("heldout_result" if label == "final" else "start_heldout_result", run=run,
                  seeds=tuning["heldout_seeds"], tta_val_acc_mean=avg, tta_val_acc_std=sd, per_seed=held,
                  seconds=time.perf_counter() - held_start)
    result = dict(val_acc=0.0, tta_val_acc=m, seconds=seconds, evaluations=evaluations, best=anchor,
                  start=snapped)
    return dict(best_config=config, best_result=result, trials=[dict(run=run, config=config, result=result)])


ICS_REQUIRED = {"algorithm", "metric", "groups", "start", "intervals", "passes", "cooldown_mult", "ratio",
                "level_scan", "level_lookahead", "level_rule", "level_margin", "fine", "tie", "max_side_steps",
                "larger_within", "refine_start", "replicates", "level_refine", "level_joint", "short_fraction",
                "pass_intervals", "refine_side_steps", "final_expand", "level_backoff", "adaptive_reps", "relevel_steps",
                "carry_offset", "plan_shift", "ensemble", "level_individual", "cooldown_mults", "shift_groups",
                "ensemble_scope", "budget_reserve", "share_levels", "final_shape", "relevel_groups", "final_shift",
                "refine_ratio", "level_groups", "trend_start", "budget", "heldout_seeds"}


def midpoint_linear_lines(values, length):
    """Piecewise linear through (interval midpoint, value) for equal intervals of length steps; the
    first and last half-intervals continue the neighbouring slope, clipped at 0. The interval means
    of a linear schedule give it back exactly."""
    if len(values) < 2:
        return [(length, values[0])]
    half, rest = length // 2, length - length // 2
    start = max(0.0, values[0] + (values[0] - values[1]) / 2)
    end = max(0.0, values[-1] - (values[-2] - values[-1]) / 2)
    return ([(half, start, values[0])] + [(length, a, b) for a, b in zip(values, values[1:])]
            + [(rest, values[-1], end)])


def run_ics_search(run, model, config):
    """Interval-cooldown search (ICS): online search of constant-interval LR schedules with a
    cooldown lookahead, within a training-step budget.

    hparam_tuning:
      groups: searched groups; the first is the lead (searched in every interval).
      start: {group: initial LR}; snapped to the x0.6 grid.
      intervals: n; every searched LR is constant within each of n equal intervals (spec values;
        an lr_transform applies on top).
      passes: one lookahead per pass; each pass searches every interval in order from the initial
        state. How a candidate for interval k is scored after training the interval:
        "rest_lin" (the rest of the run, each searched LR decaying linearly from its candidate
        value to 0), "rest_geo" (the rest of the run as constant intervals continuing
        value * ratio**j), "short" (one interval at cooldown_mult x value), or "rest_plan" (the
        rest of the run on the previous pass's schedule, each group's tail scaled by candidate /
        previous value; later passes only), or "rest_fixed" (the same, tail unscaled: a candidate
        changes only its interval), or "short_abs" (like "short", but at cooldown_mult x the value
        the interval's climb started from: the same cooldown for every candidate of the interval). The last interval is scored by the final metric.
        Later passes start each interval's climb at the previous pass's value (with carry_offset,
        times the lead's ratio of this pass's previous interval to the previous pass's: a
        correction found in one interval carries to the next; with plan_shift, the previous pass's
        values except the last interval's are first moved plan_shift x0.6 grid steps, a correction
        for the short cooldown's small-LR bias; shift_groups "lead" shifts only the lead, so tied
        groups keep their scanned levels), and keep the previous
        pass's values (and trained states, at no cost) for the intervals before refine_start.
      pass_intervals: intervals per pass ([] = intervals for every pass); a pass with twice the
        previous pass's intervals starts from its plan expanded: each interval split into halves
        tilted a quarter of the way (in log) toward the neighbouring interval's value, except the
        first refine_start // 2 intervals, kept flat so their trained states can be reused.
      cooldown_mult, ratio: parameters of "short" and "rest_geo" (cooldown_mults, if not empty: one
        cooldown multiplier per interval instead); short_fraction: "short"'s length
        is total // short_fraction steps (5 = a fifth of the run, whatever the interval count).
      replicates: per interval, how many continuations score a candidate in the last pass: the
        first trains on the run's own data stream (its state is the one committed); each other
        restores the pre-interval state, reseeds the data order and augmentation (a fresh epoch)
        and trains interval + lookahead again; the score is their mean (decision noise / sqrt(R)
        at R x the cost; worthwhile late, where lookaheads are short).
      level_scan: groups whose level is first scanned in the first pass's interval 0 on a x7.7
        grid (both neighbours first, then the better side while the score improves), each
        scored after interval 0 plus level_lookahead ("none": right after the interval, or
        "short"). level_rule "best" keeps the best-scoring level; "largest" keeps, for groups other
        than the lead, the largest level scoring within level_margin of the best seen (probing up,
        then down, on the x7.7 grid, then refining upward on the x0.6 grid): a short horizon cannot
        see such LRs' long-horizon effect below their upper edge, where the full run prefers them.
        level_refine: x0.6 steps tried upward after the "largest" rule's x7.7 probes (0 = none).
        level_joint: with "largest", the non-lead groups are first scanned together (one
        multiplier for all of them), then each alone at most level_individual x7.7 steps up from
        there (0: the joint level only).
        final_shape: the committed schedule's form: "constant" intervals, or "linear" through the
          interval midpoints (midpoint_linear_lines); a staircase of a smooth optimum loses up to
          0.14 pp (Experiment 24).
        share_levels: with ensemble_scope "all", later members reuse the first member's scanned
          levels instead of scanning again; the rest of the budget is split evenly among members.
        level_groups: with level_joint, the non-lead groups' joint scan split into these sets, each
          scanned in turn with the same rule ([] = one set of all of them).
        level_backoff: x7.7 steps each non-lead group's level is then lowered (a safety margin: a
        short horizon accepts levels near a long-horizon edge it cannot see).
      refine_ratio: the grid ratio of the climbs from the second pass on (0.6 ** 0.5: a grid twice as
        fine, which contains the x0.6 grid; the x0.6 grid alone costs ~0.09 pp, Experiment 26).
      trend_start: in the first pass, from interval 3 on, the lead's climb starts at the previous value times
        the last two intervals' ratio (clipped to x0.36..x1.67) instead of the previous value: fewer
        evaluations where the schedule keeps falling or rising, and a trend-following value when the
        budget is out (Experiment 28).
      final_shift: x0.6 grid steps each member's result of the last pass is moved up (all but the
        last interval; tied groups keep their level and follow the lead's shifted profile): the
        plan shift for a search whose last pass is the biased short-cooldown pass.
      relevel_groups: the groups relevel_steps tries ([] = every non-lead group); a negative
        relevel_steps tries them higher.
      relevel_steps: with tie, in the last pass's first refined interval, each non-lead group's
        whole remaining profile is also tried relevel_steps x0.6 grid steps lower (one candidate per
        group, scored with the rest-of-run lookahead, its tail lowered too) and kept if it scores
        higher: the long horizon decides what the level scan's short horizon cannot see.
        When level_lookahead is the first pass's lookahead, interval 0's climbs reuse the scan's
        evaluations.
      fine: groups climbed on the x0.6 grid in interval 0.
      tie: groups other than the lead follow the lead's profile after interval 0 (value_k =
        value_0 x lead_k / lead_0); otherwise every group is climbed in every interval.
      max_side_steps: most x0.6 grid steps one climb direction may move in the first pass;
        refine_side_steps: the same in later passes.
      final_expand: the committed schedule is expanded to twice its intervals for the result
        (each interval's halves tilted a quarter of the way, in log, toward its neighbours; the
        last interval's second half continues the decay), at no search cost.
      larger_within: after a climb, move up the grid while the score stays within this of the
        best (counters a lookahead's small-LR bias; 0 = off).
      budget: the search stops evaluating new candidates once its trained steps would exceed
        budget x the run's total steps (every trained step counts, discarded probes included);
        an interval whose committed values were never trained is then trained anyway. With
        adaptive_reps, a candidate whose replicates would exceed the budget gets fewer replicates
        (down to one) before being skipped.
      ensemble: the last pass is run this many times from the same plan, each run (member) after
        the first on its own data order and augmentation from its first searched interval on; the
        result is the members' geometric mean, interval by interval (decision noise averages out).
        ensemble_scope "all" repeats every pass per member instead (independent searches on their own
        data order, each capped at budget / ensemble).
      heldout_seeds: retrain the committed schedule on these seeds (evaluation only).
    Each interval climbs each climbed group in turn (smaller values first, then larger, moving
    while the score improves), commits the best and continues from its trained state. The
    result is the last pass's schedule.
    """
    run_start = time.perf_counter()
    tuning = config["hparam_tuning"]
    require_fields(tuning, ICS_REQUIRED, "hparam_tuning")
    passes = list(tuning["passes"])
    if not passes or any(kind not in ("rest_lin", "rest_geo", "short", "short_abs", "rest_plan", "rest_fixed")
                         for kind in passes):
        raise ValueError("ics passes must be rest_lin, rest_geo, short, short_abs, rest_plan or rest_fixed")
    if passes[0] in ("rest_plan", "rest_fixed"):
        raise ValueError("ics rest_plan needs a previous pass")
    if tuning["level_lookahead"] not in ("none", "short"):
        raise ValueError("ics level_lookahead must be none or short")
    if tuning["level_rule"] not in ("best", "largest"):
        raise ValueError("ics level_rule must be best or largest")
    groups = list(tuning["groups"])
    lead = groups[0]
    metric = tuning["metric"]
    log_config(run, config, label="base_config")
    trainer = SegmentTrainer(model, config)
    base = trainer.base_schedules
    total = trainer.total_steps
    n = tuning["intervals"]
    length = total // n
    limit = {"steps": tuning["budget"] * total}
    initial_state = trainer.snapshot()
    evaluations = 0
    budget_hit = False
    plan = None
    committed = {g: [] for g in groups}

    grid_ratio = {"value": 0.6}  # refine_ratio from the second pass on (after its plan shift).

    def grid(value, steps):
        ratio = grid_ratio["value"]
        return round_hparam(ratio ** (lr_grid_index(value, ratio) - steps))

    def tail(g, value, k, kind):
        remaining = total - (k + 1) * length
        if remaining == 0 or kind == "none":
            return [(remaining, 0.0)] if remaining else []
        if kind == "rest_lin":
            return [(remaining, value, 0.0)]
        if kind == "rest_geo":
            return [(length, value * tuning["ratio"] ** (j + 1)) for j in range(n - 1 - k)]
        if kind in ("rest_plan", "rest_fixed"):
            scale = value / plan[g][k] if plan[g][k] > 0 and kind == "rest_plan" else tail_scale[g]
            return [(length, plan[g][j] * scale) for j in range(k + 1, n)]
        steps = min(short_steps, remaining)
        mult = tuning["cooldown_mults"][k] if tuning["cooldown_mults"] else tuning["cooldown_mult"]
        level = mult * (short_ref[g] if kind == "short_abs" else value)
        return [(steps, level)] + ([(remaining - steps, 0.0)] if remaining > steps else [])

    short_steps = int(total // tuning["short_fraction"])

    short_ref = {}  # short_abs: each group's value when the interval's climb started.

    def lookahead_steps(k, kind):
        remaining = total - (k + 1) * length
        return 0 if kind == "none" else (min(short_steps, remaining) if kind in ("short", "short_abs") else remaining)

    def reserve(k):
        """Steps kept back so the run stays within budget: the rest of this pass at one training per
        interval, plus one full run per later pass of this search (only with budget_reserve)."""
        if not tuning["budget_reserve"]:
            return 0
        return (n - 1 - k) * length + total * member["passes_left"]

    def evaluate(k, values, kind, state, cache):
        """Train interval k at values (group -> LR) from state, then the lookahead; cached."""
        nonlocal evaluations, budget_hit
        key = (kind, tuple(values[g] for g in groups))
        if key in cache:
            return cache[key][0]
        reps = replicates[k]
        cost = reps * (length + lookahead_steps(k, kind))
        while tuning["adaptive_reps"] and reps > 1 and trainer.train_steps + cost + reserve(k) > limit["steps"]:
            reps -= 1
            cost = reps * (length + lookahead_steps(k, kind))
        if trainer.train_steps + cost + reserve(k) > limit["steps"]:
            budget_hit = True
            return None
        sched_head = dict(base)
        sched_full = dict(base)
        for g in groups:
            sched_head[f"{g}.initial_lr"] = [(length, v) for v in committed[g]] + [(length, values[g])] + [
                (length, 0.0)] * (n - 1 - k)
            sched_full[f"{g}.initial_lr"] = ([(length, v) for v in committed[g]] + [(length, values[g])]
                                             + tail(g, values[g], k, kind))
        scores, after = [], None
        for r in range(reps):
            trainer.restore(state)
            if r > 0 or member["index"] > 0:  # Another continuation: reseed data order / augmentation.
                torch.manual_seed(1_000_003 * TRAINING_SEED + 7_919 * k + 104_729 * r + 1_299_709 * member["index"] + 17)
                trainer.stream.images = None
            ok = trainer.train(sched_head, length)
            if r == 0:
                after = trainer.snapshot()
            steps = lookahead_steps(k, kind)
            if ok and steps:
                ok = trainer.train(sched_full, steps)
            scores.append(trainer.score(metric) if ok else float("-inf"))
        value = sum(scores) / len(scores)
        evaluations += 1
        best = cache.get("_best")  # Only the best candidate so far keeps its trained state (memory).
        if best is None or value > cache[best][0]:
            if best is not None:
                cache[best] = (cache[best][0], None)
            cache[key], cache["_best"] = (value, after), key
        else:
            cache[key] = (value, None)
        print(f"  ics_eval interval={k} lookahead={kind} {hparam_text(values)} {metric}={format_log_value(value)} "
              f"train_steps={trainer.train_steps}", flush=True)
        return value

    group_scale = {g: 1.0 for g in groups}  # Relevel factors, from scale_from[g] on.
    scale_from = {g: 0 for g in groups}
    tail_scale = {g: 1.0 for g in groups}  # Temporary, while a relevel candidate is scored.

    def train_interval(k, values, state):
        """Train interval k at values from state (the committed point's state was not kept)."""
        trainer.restore(state)
        if member["index"] > 0:  # The same reseed as the member's r = 0 evaluations.
            torch.manual_seed(1_000_003 * TRAINING_SEED + 7_919 * k + 1_299_709 * member["index"] + 17)
            trainer.stream.images = None
        sched = dict(base)
        for g in groups:
            sched[f"{g}.initial_lr"] = [(length, v) for v in committed[g]] + [(length, values[g])] + [
                (length, 0.0)] * (n - 1 - k)
        trainer.train(sched, length)
        return trainer.snapshot()

    def tied(k, values):
        """With tie, after interval 0 the other groups follow the lead's profile."""
        if not tuning["tie"] or k == 0:
            return values
        return dict(values, **{g: round_hparam(committed[g][0] * (group_scale[g] if k >= scale_from[g] else 1.0)
                                               * values[lead] / committed[lead][0])
                               for g in groups[1:]})

    def climb(k, g, kind, state, cache, factor_steps, start, side_steps):
        """Climb group g's value on its grid (factor_steps grid steps per move) from start."""
        best = tied(k, dict(start))
        best_score = evaluate(k, best, kind, state, cache)
        if best_score is None:
            return best
        directions = (-1, 1)
        if factor_steps > 1:  # Level scan: look both ways first, then climb the better side.
            sides = {d: evaluate(k, tied(k, dict(best, **{g: grid(best[g], d * factor_steps)})), kind, state, cache)
                     for d in (-1, 1)}
            directions = sorted(sides, key=lambda d: -(sides[d] if sides[d] is not None else float("-inf")))
        for direction in directions:
            moved = False
            point = best
            for _ in range(side_steps):
                candidate = tied(k, dict(point, **{g: grid(point[g], direction * factor_steps)}))
                value = evaluate(k, candidate, kind, state, cache)
                if value is None or value <= best_score:
                    break
                best, best_score, point, moved = candidate, value, candidate, True
            if moved:
                break
        if tuning["larger_within"] > 0 and factor_steps == 1:
            point = best
            while True:
                candidate = tied(k, dict(point, **{g: grid(point[g], 1)}))
                value = evaluate(k, candidate, kind, state, cache)
                if value is None or value < best_score - tuning["larger_within"]:
                    break
                point = candidate
            best = point
        return best

    def largest_level(k, g, kind, state, cache, start, max_up):
        """The largest level of g within level_margin of the best probed (x7.7 probes, x0.6 refine);
        g may be a tuple of groups moved together. max_up caps the upward x7.7 probes."""
        margin = tuning["level_margin"]
        moved = g if isinstance(g, tuple) else (g,)

        def step(point, steps):
            return dict(point, **{h: grid(point[h], steps) for h in moved})
        probes = []
        best = None

        def probe(point):
            nonlocal best
            value = evaluate(k, point, kind, state, cache)
            if value is not None:
                probes.append((point, value))
                best = value if best is None else max(best, value)
            return value

        if probe(dict(start)) is None:
            return dict(start)
        for direction in (1, -1):
            if direction == -1 and (len(probes) > 2 or max_up is not None):
                break  # Some larger level was accepted (or only upward moves are wanted).
            point = dict(start)
            for _ in range(tuning["max_side_steps"] if max_up is None or direction == -1 else max_up):
                point = step(point, 4 * direction)
                value = probe(point)
                if value is None or value < best - margin:
                    break
        top = max((pt for pt, v in probes if v >= best - margin), key=lambda pt: pt[moved[0]])
        point = top
        for _ in range(tuning["level_refine"]):  # Refine upward toward the next x7.7 probe.
            point = step(point, 1)
            value = probe(point)
            if value is None or value < best - margin:
                break
            top = point
        return top

    def expand(values, keep):
        """Double the resolution of one group's plan (see pass_intervals)."""
        out = []
        for j, v in enumerate(values):
            if j < keep or v <= 0:
                out += [v, v]
                continue
            left = v * (values[j - 1] / v) ** 0.25 if j > 0 else v
            right = (v * (values[j + 1] / v) ** 0.25 if j < len(values) - 1
                     else v * (v / values[j - 1]) ** 0.25 if j > 0 else v)
            out += [round_hparam(left), round_hparam(right)]
        return out

    pass_counts = list(tuning["pass_intervals"]) or [tuning["intervals"]] * len(passes)
    if len(pass_counts) != len(passes) or pass_counts[-1] != tuning["intervals"]:
        raise ValueError("ics pass_intervals needs one count per pass, the last equal to intervals")
    pass_states = []
    replicates = [1] * n
    prev_length = None
    member = {"index": 0, "passes_left": 0, "level_steps": 0, "levels": None}
    members = []
    scope = tuning["ensemble_scope"]
    if scope not in ("last", "all"):
        raise ValueError("ics ensemble_scope must be last or all")
    whole = scope == "all"
    budget_total = limit["steps"]
    schedule_passes = (list(passes) * tuning["ensemble"] if whole
                       else list(passes[:-1]) + [passes[-1]] * tuning["ensemble"])
    for p_run, pass_kind in enumerate(schedule_passes):
        if whole:  # Each member is a whole search on its own data order, with its share of the budget.
            p, member["index"] = p_run % len(passes), p_run // len(passes)
            if p == 0:
                plan, pass_states, prev_length = None, [], None
                shared = member["level_steps"]  # A shared level scan is paid once, by the first member.
                limit["steps"] = shared + (budget_total - shared) * (member["index"] + 1) / tuning["ensemble"]
        else:
            p = min(p_run, len(passes) - 1)  # Ensemble members are all the last pass.
            member["index"] = p_run - (len(passes) - 1) if p_run >= len(passes) - 1 else 0
        if member["index"] > 0 and not whole:
            plan = {g: list(v) for g, v in plan_before_last.items()}  # Every member starts from the same plan.
        member["passes_left"] = (len(passes) - 1 - p) if whole else (len(schedule_passes) - 1 - p_run)
        for g in groups:  # Relevel factors belong to one run of a pass.
            group_scale[g], scale_from[g] = 1.0, 0
        n = pass_counts[p]
        length = total // n
        if p > 0 and n != len(plan[lead]):
            if n != 2 * len(plan[lead]) or tuning["refine_start"] % 2:
                raise ValueError("ics pass_intervals may only double, with an even refine_start")
            plan = {g: expand(plan[g], tuning["refine_start"] // 2) for g in groups}
        replicates = list(tuning["replicates"]) if p == len(passes) - 1 else [1] * n
        if p == 1 and tuning["plan_shift"] and (member["index"] == 0 or whole):  # Only the first pass is biased.
            if tuning["shift_groups"] not in ("all", "lead"):
                raise ValueError("ics shift_groups must be all or lead")
            plan = {g: ([grid(v, tuning["plan_shift"]) if v > 0 else v for v in plan[g][:-1]] + plan[g][-1:]
                        if g == lead or tuning["shift_groups"] == "all" else plan[g])
                    for g in groups}
        grid_ratio["value"] = tuning["refine_ratio"] if p > 0 else 0.6
        if p == len(passes) - 1 and member["index"] == 0:
            plan_before_last = {g: list(v) for g, v in (plan or {}).items()} if plan else None
        state = initial_state
        committed = {g: [] for g in groups}
        states = []
        current = ({g: snap_lr_to_grid(tuning["start"][g], 0.6) for g in groups} if p == 0
                   else {g: plan[g][0] for g in groups})
        for k in range(n):
            kind = pass_kind if k < n - 1 else "none"
            cache = {}
            if p == 0 and k >= 2 and tuning["trend_start"] and committed[lead][k - 2] > 0:
                # Start the climb where the last two intervals' trend points (at most x0.36 down, x1.67 up).
                trend = min(max(committed[lead][k - 1] / committed[lead][k - 2], 0.36), 1 / 0.6)
                current = dict(current, **{lead: snap_lr_to_grid(current[lead] * trend, 0.6)})
            if p > 0:
                current = {g: plan[g][k] for g in groups}
                if tuning["carry_offset"] and k >= max(tuning["refine_start"], 1) and k > 0 and k < n - 1:
                    ratio = committed[lead][k - 1] / plan[lead][k - 1] if plan[lead][k - 1] > 0 else 1.0
                    current = {g: snap_lr_to_grid(current[g] * ratio, 0.6) for g in groups}
                if k < tuning["refine_start"]:  # Same prefix as the previous pass: reuse its state.
                    boundary = (k + 1) * length
                    if tuning["plan_shift"] and p == 1:  # Shifted values: train the kept interval.
                        current = tied(k, current)
                        saved, limit["steps"] = limit["steps"], float("inf")
                        evaluate(k, current, "none", state, cache)
                        limit["steps"] = saved
                        state = cache[("none", tuple(current[g] for g in groups))][1]
                    else:
                        state = (pass_states[-1][boundary // prev_length - 1] if boundary % prev_length == 0
                                 else None)  # Mid-way through a previous interval: the next kept one ends it.
                    states.append(state)
                    for g in groups:
                        committed[g].append(current[g])
                    log_event("ics_interval", run=run, search_pass=p, interval=k, lookahead="kept",
                              train_steps=trainer.train_steps, **{g: current[g] for g in groups})
                    continue
            if p == 0 and k == 0 and tuning["level_scan"] and member["levels"] is not None:
                current = dict(current, **member["levels"])  # Shared: the first member's scanned levels.
            elif p == 0 and k == 0 and tuning["level_scan"]:
                level_kind = tuning["level_lookahead"] if n > 1 else "none"
                level_cache = cache if level_kind == kind else {}
                others = tuple(g for g in tuning["level_scan"] if g != lead)
                if tuning["level_joint"] and tuning["level_rule"] == "largest" and len(others) > 1:
                    if lead in tuning["level_scan"]:
                        current = climb(k, lead, level_kind, state, level_cache, 4, current, tuning["max_side_steps"])
                    for part in [tuple(part) for part in tuning["level_groups"]] or [others]:
                        current = largest_level(k, part, level_kind, state, level_cache, current, None)
                    for g in others if tuning["level_individual"] else ():
                        current = largest_level(k, g, level_kind, state, level_cache, current,
                                                tuning["level_individual"])
                    for g in others:
                        current[g] = grid(current[g], -4 * tuning["level_backoff"])
                else:
                    for g in tuning["level_scan"]:
                        # x10 = 0.6 ** -4.5: a level step is 4 grid steps (x7.7).
                        if tuning["level_rule"] == "largest" and g != lead:
                            current = largest_level(k, g, level_kind, state, level_cache, current, None)
                        else:
                            current = climb(k, g, level_kind, state, level_cache, 4, current,
                                            tuning["max_side_steps"])
                if tuning["share_levels"] and whole:
                    member["levels"] = {g: current[g] for g in tuning["level_scan"]}
                    member["level_steps"] = trainer.train_steps
                    limit["steps"] = member["level_steps"] + (budget_total - member["level_steps"]) / tuning["ensemble"]
            climbed = tuning["fine"] if k == 0 else (groups if not tuning["tie"] else [lead])
            current = tied(k, current)
            short_ref.update(current)
            side = tuning["max_side_steps"] if p == 0 else tuning["refine_side_steps"]
            for g in climbed:
                current = climb(k, g, kind, state, cache, 1, current, side)
            if (tuning["relevel_steps"] and tuning["tie"] and p == len(passes) - 1 and p > 0
                    and k == max(tuning["refine_start"], 1) and k < n - 1):
                base_key = (kind, tuple(current[g] for g in groups))
                base_score = cache[base_key][0] if base_key in cache else evaluate(k, current, kind, state, cache)
                for g in tuning["relevel_groups"] or groups[1:]:
                    factor = 0.6 ** tuning["relevel_steps"]
                    candidate = dict(current, **{g: round_hparam(current[g] * factor)})
                    tail_scale[g] = factor
                    value = evaluate(k, candidate, kind, state, cache) if base_score is not None else None
                    tail_scale[g] = 1.0
                    log_event("ics_relevel", run=run, interval=k, group=g, factor=factor, base=base_score, score=value)
                    if value is not None and value > base_score:
                        current, base_score = candidate, value
                        group_scale[g] *= factor
                        scale_from[g] = k
                        plan[g] = plan[g][:k] + [v * factor for v in plan[g][k:]]
            key = (kind, tuple(current[g] for g in groups))
            if key not in cache:
                evaluate(k, current, kind, state, cache)
            if key not in cache and tuning["budget_reserve"]:  # Out of budget: train the interval only.
                cache[key] = (None, None)
            if key not in cache:  # Out of budget before this point was trained: train it anyway.
                saved, limit["steps"] = limit["steps"], float("inf")
                evaluate(k, current, kind, state, cache)
                limit["steps"] = saved
            best_score, kept_state = cache[key]
            state = kept_state if kept_state is not None else train_interval(k, current, state)
            states.append(state)
            for g in groups:
                committed[g].append(current[g])
            log_event("ics_interval", run=run, search_pass=p, interval=k, lookahead=kind, score=best_score,
                      train_steps=trainer.train_steps, **{g: current[g] for g in groups})
        if p == len(passes) - 1:
            final = {g: list(committed[g]) for g in groups}
            if tuning["final_shift"]:  # The pass's plan shift, applied to its own result (no further pass).
                final[lead] = ([grid(v, tuning["final_shift"]) if v > 0 else v for v in final[lead][:-1]]
                               + final[lead][-1:])
                for g in groups[1:]:
                    if tuning["tie"]:  # Tied groups keep their level and follow the shifted lead's profile.
                        final[g] = [final[g][0]] + [round_hparam(final[g][0] * v / final[lead][0])
                                                    for v in final[lead][1:]]
                    elif tuning["shift_groups"] == "all":
                        final[g] = ([grid(v, tuning["final_shift"]) if v > 0 else v for v in final[g][:-1]]
                                    + final[g][-1:])
                log_event("ics_final_shift", run=run, member=member["index"], **final)
            members.append((final, state))
        if member["index"] == 0 or whole:
            plan = {g: list(committed[g]) for g in groups}
            pass_states.append(states)
        prev_length = length
    finals = []
    for _, member_state in members:
        trainer.restore(member_state)
        finals.append(trainer.score(metric))
    final = sum(finals) / len(finals)
    if len(members) > 1:
        committed = {g: [round_hparam(prod(m[g][i] for m, _ in members) ** (1 / len(members)))
                         for i in range(len(members[0][0][g]))] for g in groups}
        log_event("ics_ensemble", run=run, members=[{g: m[g] for g in groups} for m, _ in members], finals=finals)
    seconds = time.perf_counter() - run_start
    if tuning["final_expand"]:
        committed = {g: expand(committed[g], 0) for g in groups}
        length = total // len(committed[lead])
    if tuning["final_shape"] == "linear":
        schedule = {g: midpoint_linear_lines(committed[g], length) for g in groups}
    elif tuning["final_shape"] == "constant":
        schedule = {g: [(length, v) for v in committed[g]] for g in groups}
    else:
        raise ValueError("ics final_shape must be constant or linear")
    log_event("auto_result", run=run, val_acc=0.0, tta_val_acc=final, search_seconds=seconds,
              evaluations=evaluations, train_steps=trainer.train_steps,
              budget_factor=trainer.train_steps / total, budget_hit=budget_hit)
    for g in groups:
        print(f"  final {g}.initial_lr: {json.dumps(committed[g])}", flush=True)
    candidate = copy.deepcopy(dict(config, hparam_tuning=None))
    for g in groups:
        candidate["param_groups"][g]["lr_scheduler"] = [list(line) for line in schedule[g]]
    held_start = time.perf_counter()
    held = [run_seeded(f"{run}.final{seed}", model, candidate, seed, debug=False)["tta_val_acc"]
            for seed in tuning["heldout_seeds"]]
    avg = sum(held) / len(held)
    sd = (sum((v - avg) ** 2 for v in held) / (len(held) - 1)) ** 0.5 if len(held) > 1 else 0.0
    log_event("heldout_result", run=run, seeds=tuning["heldout_seeds"], tta_val_acc_mean=avg,
              tta_val_acc_std=sd, per_seed=held, seconds=time.perf_counter() - held_start)
    result = dict(val_acc=0.0, tta_val_acc=final, seconds=seconds, evaluations=evaluations, schedule=schedule)
    return dict(best_config=candidate, best_result=result, trials=[dict(run=run, config=config, result=result)])


def heldout_evaluation(run, model, config, result, seeds):
    """Retrain an interval search's committed LR schedules on held-out seeds. Logs
    search_result (cost) and heldout_result lines in the format of run_auto_search."""
    final = copy.deepcopy(dict(config, hparam_tuning=None))
    for name, group in final["param_groups"].items():
        group["lr_scheduler"] = [list(line) for line in result["hparam_schedules"][f"{name}.initial_lr"]]
        momentum = result["hparam_schedules"][f"{name}.momentum"]
        if len({line[1] for line in momentum}) != 1:
            raise ValueError("held-out evaluation supports LR-only interval searches")
    log_event("auto_result", run=run, val_acc=result["val_acc"], tta_val_acc=result["tta_val_acc"],
              search_seconds=result["seconds"], evaluations=result["evaluations"], train_steps=0)
    for path in [p for p in tuning_params(config)]:
        name = path.split(".", 1)[0]
        print(f"  final {path}: {json.dumps(final['param_groups'][name]['lr_scheduler'])}", flush=True)
    held_start = time.perf_counter()
    scores = [run_seeded(f"{run}.heldout{seed}", model, final, seed, debug=False)["tta_val_acc"]
              for seed in seeds]
    mean = sum(scores) / len(scores)
    sd = (sum((v - mean) ** 2 for v in scores) / (len(scores) - 1)) ** 0.5 if len(scores) > 1 else 0.0
    log_event("heldout_result", run=run, seeds=seeds, tta_val_acc_mean=mean, tta_val_acc_std=sd,
              per_seed=scores, seconds=time.perf_counter() - held_start)


def run_experiment(run, model, config):
    """Run one config or a search; return its best config, result, and trials.

    With the module-level debug switch, the final run records its spectra.
    """
    config = normalize_config(config, key=None)
    require_fields(
        config,
        {"batch_size", "num_epochs", "overfit", "param_groups", "hparam_tuning"},
        "run config",
    )
    for group in config["param_groups"].values():
        GroupOptimizer.validate_group(group, runtime=False)
    tuning = config["hparam_tuning"]
    if tuning is not None:
        validate_tuning_config(tuning)
    if tuning is not None and tuning["algorithm"] == "global_neighbour_seeds":
        return run_seeded_neighbour_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "global_interval":
        return run_global_interval_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "auto":
        return run_auto_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "global_family":
        return run_global_family_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "noisy_family":
        return run_noisy_family_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "guided_family":
        return run_guided_family_search(run, model, config)
    if tuning is not None and tuning["algorithm"] == "ics":
        return run_ics_search(run, model, config)
    if tuning is not None and tuning["algorithm"] in ("interval", "interval2", "global_neighbour"):
        result = run_interval_search(run, model, config, debug=debug)
        if tuning.get("heldout_seeds"):
            heldout_evaluation(run, model, config, result, tuning["heldout_seeds"])
        return dict(
            best_config=config,
            best_result=result,
            trials=[dict(run=run, config=config, result=result)],
        )
    trials = []
    cache = {}
    metric = None if tuning is None else tuning["metric"]
    if metric is not None and metric not in ("val_acc", "tta_val_acc"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")

    def evaluate_config(candidate):
        key = json.dumps(candidate, sort_keys=True)
        if key not in cache:
            trial_run = run if tuning is None else f"{run}.{len(trials)}"
            if tuning is not None:
                log_config_diff(trial_run, run, config, candidate)
            result = main(
                trial_run,
                model,
                **candidate,
                _log_config=tuning is None,
                debug=debug and tuning is None,
            )
            if metric is not None and not isfinite(result[metric]):
                raise ValueError(f"Run {trial_run}: {metric} must be finite")
            trial = dict(run=trial_run, config=candidate, result=result)
            trials.append(trial)
            cache[key] = trial
        return cache[key]

    if tuning is None:
        best = evaluate_config(config)
    else:
        algorithm = tuning["algorithm"]
        if algorithm not in ("grid", "coordinate"):
            raise ValueError(f"Unknown tuning algorithm: {algorithm!r}")
        require_fields(tuning, {"algorithm", "metric", "params"}, "hparam_tuning")
        parameters = tuning_params(config)
        choices = {}
        for path, spec in parameters.items():
            values = spec["choices"]
            if not isinstance(values, (list, tuple)) or not values:
                raise ValueError(f"{path}: choices must be a nonempty list")
            # Values that coincide after rounding represent the same candidate.
            choices[path] = list(dict.fromkeys(values))

        log_config(run, config, label="base_config")
        if algorithm == "grid":
            best = None
            for values in product(*choices.values()):
                candidate = config
                for path, value in zip(choices, values):
                    candidate = with_hparam(candidate, path, value)
                trial = evaluate_config(candidate)
                if best is None or trial["result"][metric] > best["result"][metric]:
                    best = trial
        else:
            # Start inside the search space, preferring the configured values.
            current = config
            for path, values in choices.items():
                spec = parameters[path]
                value = spec["initial"]
                current = with_hparam(current, path, value)
            best = evaluate_config(current)
            locked = set()
            while len(locked) < len(choices):
                for path, values in choices.items():
                    if path in locked:
                        continue
                    previous_value = get_hparam(best["config"], path)
                    candidate_best = best
                    for value in values:
                        candidate = with_hparam(best["config"], path, value)
                        trial = evaluate_config(candidate)
                        # Keeping the incumbent on ties prevents cycling.
                        if trial["result"][metric] > candidate_best["result"][metric]:
                            candidate_best = trial
                    best = candidate_best
                    if get_hparam(best["config"], path) != previous_value:
                        locked.clear()
                    locked.add(path)

        log_event(
            "search_best",
            run=run,
            trial=best["run"],
            **{metric: best["result"][metric]},
        )
        log_changes("changes", flatten_config(config), flatten_config(best["config"]))
        if debug:
            # Search trials are not recorded; replay the selected config as the final run.
            log_event("debug_final_run", run=run, trial=best["run"])
            main(f"{run}.final", model, **best["config"], _log_config=False, debug=True)

    return dict(best_config=best["config"], best_result=best["result"], trials=trials)


HOOKED_ALGORITHMS = KFAC_ALGORITHMS | {"input_conditioned"}


class _TrainingForward(nn.Module):
    """Wraps the model so graphing replaces this wrapper's forward, not the model's."""

    def __init__(self, model):
        super().__init__()
        self.model = model

    def forward(self, inputs):
        return self.model(inputs)


def training_forward(model, batch_size, param_groups, debug, device):
    """The model, or a cached CUDA-graphed forward+backward for this batch size.

    Graphs read the parameters' storage in place, so they stay valid across
    model.reset(), init_whiten() and load_state_dict(). They skip module hooks,
    so hooked algorithms and debug runs use the eager model.
    """
    if (
        not USE_CUDA_GRAPH_TRAINING
        or batch_size > CUDA_GRAPH_TRAINING_MAX_BATCH
        or USE_COMPILED_MODEL
        or debug
        or device.type != "cuda"
        or any(group["algorithm"] in HOOKED_ALGORITHMS for group in param_groups.values())
    ):
        return model
    graphs = model.__dict__.setdefault("_graphed_training_forwards", {})
    if batch_size not in graphs:
        # Capture runs warmup passes; they only touch BatchNorm running stats, which
        # training and evaluation (train-mode BatchNorm) never read, and use no RNG.
        torch.autograd.graph.set_warn_on_accumulate_grad_stream_mismatch(False)
        sample = torch.zeros(batch_size, 3, 32, 32, device=device).to(
            memory_format=torch.channels_last
        )
        graphs[batch_size] = torch.cuda.make_graphed_callables(
            _TrainingForward(model), (sample,)
        )
    return graphs[batch_size]


def main(
    run,
    model,
    batch_size,
    param_groups,
    num_epochs,
    overfit,
    hparam_tuning,
    _log_config,
    debug,
):
    run_start = time.perf_counter()
    config = normalize_config(
        dict(
            batch_size=batch_size,
            num_epochs=num_epochs,
            overfit=overfit,
            param_groups=param_groups,
            hparam_tuning=hparam_tuning,
        ),
        key=None,
    )
    batch_size = config["batch_size"]
    num_epochs = config["num_epochs"]
    param_groups = config["param_groups"]
    if not isinstance(num_epochs, int) or num_epochs <= 0:
        raise ValueError("num_epochs must be a positive integer")
    if _log_config:
        log_config(run, config, label="config")
    set_training_seed()

    test_loader = CifarLoader(
        "cifar10", train=False, batch_size=2000, aug=dict(flip=False, translate=0)
    )
    train_loader = CifarLoader(
        "cifar10", train=True, batch_size=batch_size, aug=dict(flip=True, translate=2)
    )
    steps_per_epoch = 1 if overfit else len(train_loader)
    total_train_steps = num_epochs * steps_per_epoch
    schedules = configured_hparam_schedules(param_groups, total_train_steps)
    initial_lrs = {
        name: hparam_at_step(config["lr_scheduler"], 0)
        for name, config in param_groups.items()
    }

    optimizer = make_optimizer(model, param_groups)
    forward = training_forward(
        model, batch_size, param_groups, debug, next(model.parameters()).device
    )

    model.reset()
    step = 0
    recorder = SpectrumRecorder(run, model, debug_kfac_factors) if debug else None

    # Initialize the whitening layer using training images
    if overfit:
        # Cache the first augmented batch once and reuse exactly these tensors;
        # evaluation scores this batch instead of the test set.
        train_batches = (next(iter(train_loader)),)
        train_images = train_batches[0][0]
        test_loader = FixedBatchLoader(*train_batches[0])
    else:
        train_batches = train_loader
        train_images = train_loader.normalized_images()[:5000]
    model.init_whiten(train_images, eps=0.0005)

    device = next(model.parameters()).device
    for epoch in range(num_epochs):
        ####################
        #     Training     #
        ####################

        model.train()
        for inputs, labels in train_batches:
            if recorder is not None:
                recorder.before_step()
            outputs = forward(inputs)
            loss = F.cross_entropy(
                outputs, labels, label_smoothing=0.2, reduction="mean"
            )
            optimizer.prepare_kfac(outputs)
            loss.backward()
            apply_hparam_schedules(optimizer, schedules, step)
            optimizer.step()
            if recorder is not None:
                recorder.after_step(step, optimizer)
            optimizer.zero_grad(set_to_none=True)
            step += 1
            if step >= total_train_steps:
                break

        ####################
        #    Evaluation    #
        ####################

        val_acc = evaluate(model, test_loader, tta_level=0)

    ####################
    #  TTA Evaluation  #
    ####################

    tta_val_acc = evaluate(model, test_loader, tta_level=2)
    train_loss = batch_loss(model, test_loader) if overfit else None
    if device.type == "cuda":
        torch.cuda.synchronize(device)
    seconds = time.perf_counter() - run_start
    if train_loss is not None:
        log_event("fixed_batch_loss", run=run, train_loss=train_loss)
    log_final_eval(val_acc, tta_val_acc, seconds)
    if recorder is not None:
        recorder.finish()

    return dict(
        val_acc=val_acc,
        tta_val_acc=tta_val_acc,
        train_loss=train_loss,
        seconds=seconds,
        batch_size=batch_size,
        num_epochs=num_epochs,
        overfit=overfit,
        **{f"{name}_lr": lr for name, lr in initial_lrs.items()},
    )


if __name__ == "__main__":
    # Reuse the same model and compiled graphs across all candidates.
    set_training_seed()
    model = CifarNet().cuda().to(memory_format=torch.channels_last)
    if USE_COMPILED_MODEL:
        compile_and_warmup_model(model, [config for _, config in RUNS])
    for name, config in RUNS:
        results = []
        for seed in SEEDS:
            TRAINING_SEED = seed  # Read by set_training_seed() at the start of each run.
            results.append(run_experiment(f"{name}_seed{seed}", model, config)["best_result"])
        log_seed_summary(name, SEEDS, results)


