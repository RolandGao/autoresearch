# snapped baseline values (BS 2000's version, staircase_a_knots_grid_bs2000, scored 93.98).
for batch_size in (500, 125):
    config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
    group = config["param_groups"]["conv"]
    total, lr = group["lr_scheduler"][0][0], group["lr_scheduler"][0][1]
    knots = [round_hparam(0.6 ** round(log(lr * (1 - i / 5)) / log(0.6))) if i < 5 else 0.0
             for i in range(6)]
    group["lr_scheduler"] = [(total // 5, a, b) for a, b in zip(knots, knots[1:])]
    RUN_CONFIGS[f"staircase_a_knots_grid_bs{batch_size}"] = config
# The original interval search (algorithm="interval": 20%/20% intervals, conv LR constant per
# interval, a searched constant cooldown LR, alternating main / cooldown searches), conv LR
# only from its baseline value, with a held-out evaluation, under each transform: the
# reference the auto search is compared with (scenario A).
for batch_size in (2000, 500, 125):
    for transform in (None, "ramp", "wave"):
        suffix = f"_{transform}" if transform else ""
        config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
        conv = config["param_groups"]["conv"]
        steps = conv["lr_scheduler"][0][0] // 5
        config["hparam_tuning"] = dict(
            algorithm="interval", metric="tta_val_acc", max_side_steps=20,
            initial_dropoff_margin=0.02, interval_steps=steps, cooldown_steps=steps,
            params={"conv.initial_lr": dict(initial=conv["lr_scheduler"][0][1], choices=None,
                                            mult=0.6)},
            heldout_seeds=HELDOUT_SEEDS,
        )
        if transform:
            conv["lr_transform"] = copy.deepcopy(LR_TRANSFORMS[transform])
        RUN_CONFIGS[f"auto_a_interval_bs{batch_size}{suffix}"] = config
# Experiment 3 (user-directed): representation quality of schedule families for conv (other
# groups on the baseline) under no transform / ramp / reverse ramp / wave, each searched by the
# generalized global_neighbour search (global_family) from the oracle projected onto the family.
GLOBAL_FAMILIES = {
    "intervals5": dict(kind="intervals", n=5),
    "linear": dict(kind="linear"),
    "power": dict(kind="power"),
    "knots2": dict(kind="knots", positions=[0.0, 0.5]),
    "knots3": dict(kind="knots", positions=[0.0, 1 / 3, 2 / 3]),
    "knots5": dict(kind="knots", positions=[0.0, 0.2, 0.4, 0.6, 0.8]),
}
for transform in (None, "ramp", "rampdown", "wave"):
    suffix = f"_{transform}" if transform else ""
    for family_name, family in GLOBAL_FAMILIES.items():
        config = copy.deepcopy(RUN_CONFIGS["baseline_bs2000"])
        if transform:
            config["param_groups"]["conv"]["lr_transform"] = copy.deepcopy(LR_TRANSFORMS[transform])
        config["hparam_tuning"] = dict(
            algorithm="global_family", metric="tta_val_acc", group="conv",
            family=copy.deepcopy(family), max_side_steps=20, heldout_seeds=HELDOUT_SEEDS)
        RUN_CONFIGS[f"auto_gfam_{family_name}_bs2000{suffix}"] = config
        # Experiment 9: the same, searched by the noise-aware global_neighbour search
        # (noisy_family; noise_sd = the baseline's single-run TTA SD across seeds, Experiment 6).
        config = copy.deepcopy(config)
        config["hparam_tuning"] = dict(
            algorithm="noisy_family", metric="tta_val_acc", group="conv", family=copy.deepcopy(family),
            noise_sd=0.0012, confidence=0.8, max_seeds=8, heldout_seeds=HELDOUT_SEEDS)
        RUN_CONFIGS[f"auto_nfam_{family_name}_bs2000{suffix}"] = config
        # Experiment 10: the guided search (guided_family): deep single-seed exploration along each
        # parameter, a quadratic fit per parameter, joint moves, and a gate on fresh seeds.
        config = copy.deepcopy(config)
        config["hparam_tuning"] = dict(
            algorithm="guided_family", metric="tta_val_acc", group="conv", family=copy.deepcopy(family),
            noise_sd=0.0012, confidence=0.8, max_depth=3, max_candidates=3, max_seeds=8, selection="raw",
            heldout_seeds=HELDOUT_SEEDS)
        RUN_CONFIGS[f"auto_xfam_{family_name}_bs2000{suffix}"] = config
        # Experiment 11: the guided search with uncertainty-aware candidate selection.
        config = copy.deepcopy(config)
        config["hparam_tuning"]["selection"] = "lcb"
        RUN_CONFIGS[f"auto_yfam_{family_name}_bs2000{suffix}"] = config
# Representation of constant intervals (2-day campaign): conv's schedule replaced by n constant
# intervals, each at the oracle spec (the baseline's applied LR divided by the transform) a
# fraction q of the way through the interval (the last interval at min(q, 0.95), since the
# oracle reaches 0 at the end). q = 0.5 is about the interval mean, q = 1 the end value.
for batch_size in (2000, 500, 125):
    for transform in (None, "ramp", "rampdown", "wave"):
        for n in (5, 10):
            for q in (0.5, 0.75, 1.0):
                config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
                group = config["param_groups"]["conv"]
                lines = group["lr_scheduler"]
                total = sum(line[0] for line in lines)
                spec = LR_TRANSFORMS[transform] if transform else None
                values = []
                for i in range(n):
                    frac = min(q, 0.95) if i == n - 1 else q
                    step = min(int(total * (i + frac) / n), total - 1)
                    applied = schedule_value_at_step(lines, step)
                    values.append(round_hparam(applied / (lr_transform_factor(spec, step, total) if spec else 1.0)))
                group["lr_scheduler"] = [(total // n, v) for v in values]
                if spec:
                    group["lr_transform"] = copy.deepcopy(spec)
                RUN_CONFIGS[f"rep_n{n}_q{round(100 * q)}_bs{batch_size}{'_' + transform if transform else ''}"] = config
# ICS (run_ics_search), the 2-day campaign's constant-interval + cooldown search. Scenario a: conv
# searched from its baseline initial LR (other groups on the baseline); scenario b: all four LRs
# from 1.0 (levels scanned on a x7.7 grid in interval 0, conv refined, the others tied to conv's
# profile). Transforms apply to the searched groups.
def ics_config(batch_size, scenario, transform, **overrides):
    config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
    pg = config["param_groups"]
    groups = ["conv"] if scenario == "a" else list(TRAINED_LR_GROUPS)
    tuning = dict(
        algorithm="ics", metric="tta_val_acc", groups=groups,
        start={g: (pg[g]["lr_scheduler"][0][1] if scenario == "a" else 1.0) for g in groups},
        intervals=5, passes=["rest_lin"], cooldown_mult=0.36, ratio=0.6,
        level_scan=[] if scenario == "a" else list(groups), level_lookahead="short", level_rule="best",
        level_margin=0.01, level_refine=3, level_joint=False, short_fraction=5, pass_intervals=[], fine=["conv"],
        refine_start=0, replicates=[1, 1, 1, 1, 1], refine_side_steps=20, final_expand=False, level_backoff=0,
        adaptive_reps=False, relevel_steps=0, carry_offset=False, plan_shift=0, ensemble=1, level_individual=2,
        cooldown_mults=[], shift_groups="all", ensemble_scope="last", budget_reserve=False, share_levels=False,
        final_shape="constant", relevel_groups=[], final_shift=0, refine_ratio=0.6,
        level_groups=[], trend_start=False,
        tie=scenario == "b", max_side_steps=20, larger_within=0.0, budget=20, heldout_seeds=HELDOUT_SEEDS)
    tuning.update(overrides)
    config["hparam_tuning"] = tuning
    if transform is not None:
        for g in groups:
            pg[g]["lr_transform"] = copy.deepcopy(LR_TRANSFORMS[transform])
    return config


