def normalize_config(value, key):
    """Round hyperparameter values, keeping batch sizes and step counts exact."""
    if key in (
        "batch_size",
        "num_epochs",
        "interval_steps",
        "cooldown_steps",
        "max_side_steps",
        "ns_steps",
    ):
        return copy.deepcopy(value)
    if key == "lr_scheduler":
        return normalize_schedule(value, total_steps=None, name="lr_scheduler")
    if isinstance(value, dict):
        return {name: normalize_config(item, name) for name, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [normalize_config(item, key=None) for item in value]
    return round_hparam(value)


def make_optimizer(model, param_groups):
    for group in param_groups.values():
        GroupOptimizer.validate_group(group, runtime=False)
    parameters = dict(
        whiten_bias=[model.whiten.bias],
        norm_bias=[m.bias for m in model.modules() if isinstance(m, BatchNorm)],
        head=[model.head.weight],
        whiten_weight=[model.whiten.weight],
        norm_weight=[m.weight for m in model.modules() if isinstance(m, BatchNorm)],
        conv=[
            p
            for p in model.parameters()
            if p.ndim == 4 and p.requires_grad and p is not model.whiten.weight
        ],
    )
    require_fields(param_groups, set(parameters), "param_groups")
    optimizer = GroupOptimizer(
        [
            dict(
                name=name,
                params=params,
                lr=hparam_at_step(param_groups[name]["lr_scheduler"], 0),
                **{
                    key: value
                    for key, value in param_groups[name].items()
                    if key != "lr_scheduler"
                },
            )
            for name, params in parameters.items()
        ]
    )
    optimizer.bind_input_layers(model)
    return optimizer


def get_hparam(config, path):
    """Read a run setting or a group option such as conv.initial_lr."""
    if path in ("batch_size", "num_epochs", "overfit"):
        return config[path]
    parts = path.split(".")
    if len(parts) == 2 and parts[0] in config["param_groups"]:
        group = config["param_groups"][parts[0]]
        field = parts[1]
        if field in group and field != "lr_scheduler":
            return group[field]
        if field == "initial_lr":
            return group["lr_scheduler"][0][1]
        if field == "decay":
            lines = group["lr_scheduler"]
            if all(len(line) == 2 and line[1] == lines[0][1] for line in lines):
                return "constant"
            if len(lines) == 1 and len(lines[0]) == 3 and lines[0][2] == 0:
                return "linear_decay"
            raise ValueError(
                f"{path}: decay search requires a constant or single linear-to-zero schedule"
            )
    raise ValueError(f"Unknown hyperparameter: {path!r}")


def with_hparam(config, path, value):
    get_hparam(config, path)  # Validate the path before modifying anything.
    updated = copy.deepcopy(config)
    value = value if path in ("batch_size", "num_epochs") else round_hparam(value)
    if "." not in path:
        updated[path] = value
    else:
        name, field = path.split(".")
        group = updated["param_groups"][name]
        if field in group:
            group[field] = value
        elif field == "decay":
            lines = group["lr_scheduler"]
            group["lr_scheduler"] = lr_decay_schedule(
                sum(line[0] for line in lines), lines[0][1], value
            )
        else:
            group["lr_scheduler"] = scale_lr_schedule(group["lr_scheduler"], value)
    return updated


def validate_tuning_config(tuning):
    if "algorithm" not in tuning or tuning["algorithm"] not in (
        "grid",
        "coordinate",
        "interval",
        "global_neighbour",
    ):
        raise ValueError("hparam_tuning requires a known algorithm")
    required = {"algorithm", "metric", "params"}
    if tuning["algorithm"] in ("interval", "global_neighbour"):
        required.add("max_side_steps")
    if tuning["algorithm"] == "interval":
        required |= {"interval_steps", "cooldown_steps", "initial_dropoff_margin"}
    require_fields(tuning, required, "hparam_tuning")


def tuning_params(config):
    """Read explicit search specs without changing the baseline parameter groups."""
    tuning = config["hparam_tuning"]
    if "params" not in tuning or "parameters" in tuning:
        raise ValueError(
            "hparam_tuning requires params with explicit initial/choices entries"
        )
    parameters = tuning["params"]
    if not isinstance(parameters, dict) or not parameters:
        raise ValueError("hparam_tuning.params must be a nonempty mapping")
    specs = {}
    for path, spec in parameters.items():
        get_hparam(config, path)
        if not isinstance(spec, dict):
            raise ValueError(f"{path}: specify initial and choices explicitly")
        required = {"initial", "choices"}
        if (
            path.endswith(".initial_lr")
            and "choices" in spec
            and spec["choices"] is None
        ):
            required.add("mult")
        require_fields(spec, required, path)
        if "mult" in spec:
            mult = spec["mult"]
            if (
                isinstance(mult, bool)
                or not isinstance(mult, (int, float))
                or not isfinite(mult)
                or not 0 < mult < 1
            ):
                raise ValueError(
                    f"{path}: mult must be a finite number between 0 and 1"
                )
        specs[path] = dict(spec)
    return specs


def lr_grid_index(value, mult):
    """Choose the nearest integer exponent in logarithmic LR space."""
    return round(log(value) / log(mult))


def snap_lr_to_grid(value, mult):
    return round_hparam(mult ** lr_grid_index(value, mult))


def interval_search_space(config):
    """Validate searchable fields and snap multiplicative LR starts to their grids."""
    choices, initial = {}, {}
    for path, spec in tuning_params(config).items():
        value, values = round_hparam(spec["initial"]), spec["choices"]
        parts = path.split(".")
        if len(parts) != 2:
            raise ValueError(f"Unsupported interval search parameter: {path}")
        name, field = parts
        group = config["param_groups"][name]
        if field == "decay":
            if config["hparam_tuning"]["algorithm"] != "global_neighbour":
                raise ValueError("decay search requires global_neighbour")
            allowed = ("constant", "linear_decay")
            if (
                not isinstance(values, list)
                or not values
                or any(v not in allowed for v in values)
                or value not in values
            ):
                raise ValueError(
                    f"{path}: initial and choices must specify constant or linear_decay"
                )
            choices[path], initial[path] = list(dict.fromkeys(values)), value
            continue
        if (
            field
            not in {"initial_lr", "momentum"} | ALGORITHM_FIELDS[group["algorithm"]]
        ):
            raise ValueError(f"Unsupported interval search parameter: {path}")
        if (
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not isfinite(value)
            or value < 0
        ):
            raise ValueError(f"{path}: initial must be a nonnegative finite number")
        if values is None:
            if field != "initial_lr" or value <= 0:
                raise ValueError(
                    f"{path}: multiplicative search needs a positive initial LR"
                )
            value = snap_lr_to_grid(value, spec["mult"])
        else:
            if (
                not isinstance(values, list)
                or not values
                or any(
                    isinstance(v, bool)
                    or not isinstance(v, (int, float))
                    or not isfinite(v)
                    or v < 0
                    for v in values
                )
            ):
                raise ValueError(f"{path}: choices must be nonnegative finite numbers")
            values = sorted({round_hparam(v) for v in values})
            if (
                field == "momentum"
                and group["algorithm"] in ("sgd", "input_conditioned")
                and group["nesterov"]
            ):
                # SGD Nesterov requires positive gradient momentum. Covariance EMA
                # momentum is independent and still includes zero.
                values = [v for v in values if v > 0]
                if value == 0:
                    raise ValueError(
                        f"{path}: SGD Nesterov needs positive initial momentum"
                    )
            if not values:
                raise ValueError(
                    f"{path}: no valid choices (Nesterov needs positive momentum)"
                )
            if field != "initial_lr":
                for candidate in [value, *values]:
                    GroupOptimizer.validate_group(
                        dict(group, **{field: candidate}), runtime=False
                    )
        choices[path], initial[path] = values, value
    return choices, initial


def directional_search(
    initial,
    choices,
    score,
    *,
    initial_lr_search,
    factors,
    max_side_steps,
    dropoff_margin,
    on_event,
):
    """Snap LR starts to the fixed, unit-anchored grid and probe adjacent exponents."""
    cache = {}

    def emit(event, point, **fields):
        if on_event is not None:
            on_event(event, dict(point), **fields)

    def evaluate_point(point):
        key = tuple(point[path] for path in choices)
        if key not in cache:
            emit("candidate_start", point)
            value = score(dict(point))
            cache[key] = value if isfinite(value) else float("-inf")
            emit("candidate_result", point, score=cache[key])
        return cache[key]

    def neighbors(path, center, direction):
        values = choices[path]
        seen = {center}
        if values is None:
            mult = factors[path]

            def grid_lr(index):
                return round_hparam(1.0 * mult**index)

            index = lr_grid_index(center, mult)
        for distance in range(1, max_side_steps + 1):
            if values is None:
                value = grid_lr(index - direction * distance)
                if not isfinite(value) or value <= 0:
                    break
            else:
                # An explicit start (e.g. momentum=0.85) need not be in the choices.
                if isinstance(center, str):
                    index = values.index(center) + direction * distance
                else:
                    index = (
                        bisect_left(values, center) - distance
                        if direction < 0
                        else bisect_right(values, center) + distance - 1
                    )
                if not 0 <= index < len(values):
                    break
                value = values[index]
            if value not in seen:
                seen.add(value)
                yield value

    current = dict(initial)
    for path, values in choices.items():
        if values is None:
            current[path] = snap_lr_to_grid(current[path], factors[path])
    current_score = evaluate_point(current)
    emit("search_path", current, score=current_score, reason="initial")
    while True:
        changed = False
        for path in choices:
            is_lr = path.endswith(".initial_lr")
            if initial_lr_search and is_lr:
                probes = [(dict(current), current_score)]
                best_score = current_score
                for direction in (1, -1):
                    for value in neighbors(path, current[path], direction):
                        candidate = dict(current, **{path: value})
                        candidate_score = evaluate_point(candidate)
                        probes.append((candidate, candidate_score))
                        if (
                            not isfinite(candidate_score)
                            or candidate_score < best_score - dropoff_margin
                        ):
                            break
                        best_score = max(best_score, candidate_score)
                acceptable = [
                    (point, value)
                    for point, value in probes
                    if isfinite(value) and value >= best_score - dropoff_margin
                ]
                if acceptable:
                    previous = current
                    current, current_score = max(
                        acceptable, key=lambda item: item[0][path]
                    )
                    if current != previous:
                        emit(
                            "search_path",
                            current,
                            score=current_score,
                            parameter=path,
                            reason="largest_lr_within_margin",
                        )
                continue

            # Smaller values first; stop a direction once it gets worse.
            for direction in (-1, 1):
                best, best_score = current, current_score
                flat_steps = 0
                for value in neighbors(path, current[path], direction):
                    candidate = dict(current, **{path: value})
                    candidate_score = evaluate_point(candidate)
                    if not isfinite(candidate_score) or candidate_score < best_score:
                        break
                    if candidate_score > best_score:
                        best, best_score, flat_steps = candidate, candidate_score, 0
                    else:
                        flat_steps += 1
                        if is_lr and direction < 0 and flat_steps >= 3:
                            break
                if best_score > current_score:
                    current, current_score = best, best_score
                    emit(
                        "search_path",
                        current,
                        score=current_score,
                        parameter=path,
                        reason="improved",
                    )
                    changed = True
                    break
        if initial_lr_search or not changed:
            return current, current_score


def run_interval_search(run, model, config):
    """Choose each committed interval using replayed main/cooldown training probes.

    seconds includes setup, training probes, evaluation, checkpoint copies and logging.
    Search logs distinguish lookahead scores from committed scores.
    """
    run_start = time.perf_counter()
    config = normalize_config(config, key=None)
    tuning = config["hparam_tuning"]
    validate_tuning_config(tuning)
    if tuning["algorithm"] not in ("interval", "global_neighbour"):
        raise ValueError(f"Unknown interval algorithm: {tuning['algorithm']!r}")
    global_search = tuning["algorithm"] == "global_neighbour"
    choices, current = interval_search_space(config)
    factors = {
        path: spec["mult"]
        for path, spec in tuning_params(config).items()
        if "mult" in spec
    }
    interval_steps = None if global_search else tuning["interval_steps"]
    cooldown_steps = 0 if global_search else tuning["cooldown_steps"]
    max_side_steps = tuning["max_side_steps"]
    margin = None if global_search else tuning["initial_dropoff_margin"]
    metric = tuning["metric"]
    counts = [
        ("max_side_steps", max_side_steps, 1),
        ("num_epochs", config["num_epochs"], 1),
    ]
    if not global_search:
        counts += [
            ("interval_steps", interval_steps, 1),
            ("cooldown_steps", cooldown_steps, 0),
        ]
    for name, value, minimum in counts:
        if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
            raise ValueError(f"{name} must be an integer >= {minimum}")
    if not global_search and (not isfinite(margin) or margin < 0):
        raise ValueError("initial_dropoff_margin must be nonnegative and finite")
    if metric is not None and metric not in ("val_acc", "tta_val_acc"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")
    set_training_seed()
    test_loader = CifarLoader(
        "cifar10", train=False, batch_size=2000, aug=dict(flip=False, translate=0)
    )
    train_loader = CifarLoader(
        "cifar10",
        train=True,
        batch_size=config["batch_size"],
        aug=dict(flip=True, translate=2),
    )
    if len(train_loader) == 0:
        raise ValueError("batch_size must not exceed the training dataset size")
    steps_per_epoch = 1 if config["overfit"] else len(train_loader)
    total_steps = config["num_epochs"] * steps_per_epoch
    if global_search:
        interval_steps = total_steps
    # Log effective settings, including the single full-run interval in global mode.
    tuning.update(
        interval_steps=interval_steps,
        cooldown_steps=cooldown_steps,
        max_side_steps=max_side_steps,
        metric=metric,
    )
    log_config(run, config, label="base_config")
    base_schedules = configured_hparam_schedules(config["param_groups"], total_steps)
    optimizer = make_optimizer(model, config["param_groups"])
    model.reset()
    fixed_batch = next(iter(train_loader)) if config["overfit"] else None
    model.init_whiten(
        fixed_batch[0]
        if fixed_batch is not None
        else train_loader.normalized_images()[:5000],
        eps=0.0005,
    )
    stream = TrainingBatchStream(train_loader, fixed_batch)
    device = next(model.parameters()).device
    completed = 0
    history = []
    cooldown_values = {}

    def snapshot():
        return dict(
            model=copy.deepcopy(model.state_dict()),
            optimizer=copy.deepcopy(optimizer.state_dict()),
            stream=stream.state_dict(),
            rng=torch.random.get_rng_state(),
            cuda_rng=torch.cuda.get_rng_state_all() if device.type == "cuda" else None,
        )

    def restore(state):
        model.load_state_dict(state["model"])
        # load_state_dict may reuse momentum tensors: each trial needs its own copy
        # so optimizer.step() cannot mutate the saved main/cooldown checkpoint.
        optimizer.load_state_dict(copy.deepcopy(state["optimizer"]))
        optimizer.zero_grad(set_to_none=True)
        stream.load_state_dict(state["stream"])
        torch.random.set_rng_state(state["rng"])
        if state["cuda_rng"] is not None:
            torch.cuda.set_rng_state_all(state["cuda_rng"])

    def train_segment(values, steps, start_step, commit):
        nonlocal completed
        schedules = segment_hparam_schedules(
            base_schedules, values, start_step, steps, global_search=global_search
        )
        valid = True
        model.train()
        for local_step in range(steps):
            apply_hparam_schedules(optimizer, schedules, start_step + local_step)
            inputs, labels = stream.next_batch()
            loss = F.cross_entropy(
                model(inputs), labels, label_smoothing=0.2, reduction="mean"
            )
            if not isfinite(loss.item()):
                valid = False
                break
            loss.backward()
            optimizer.step()
            optimizer.zero_grad(set_to_none=True)
            if commit:
                completed += 1
        return valid

    def score():
        return evaluate(
            model, test_loader, tta_level=2 if metric == "tta_val_acc" else 0
        )

    def search(values, space, evaluate_point, phase, initial, main_values, cooldown):
        log_event("search", run=run, interval=len(history), phase=phase, metric=metric)
        if main_values is not None:
            print(f"main hparams: {hparam_text(main_values)}", flush=True)
        if cooldown is not None:
            print(f"cooldown hparams: {hparam_text(cooldown)}", flush=True)
        search_path = []

        def on_event(event, point, **fields):
            if event == "candidate_result":
                value = format_log_value(fields["score"])
                if phase == "cooldown":
                    print(f"{hparam_text(point)} -> {metric}={value}", flush=True)
                else:
                    score_name = "main" if cooldown is None else "best_cooldown"
                    print(
                        f"main hparams: {hparam_text(point)} {score_name}={value}",
                        flush=True,
                    )
            elif event == "search_path":
                search_path.append((point, fields["score"]))

        best, best_score = directional_search(
            values,
            space,
            evaluate_point,
            initial_lr_search=initial,
            factors=factors,
            max_side_steps=max_side_steps,
            dropoff_margin=margin,
            on_event=on_event,
        )
        for step, (point, value) in enumerate(search_path):
            print(
                f"search_path step={step} {hparam_text(point)} "
                f"{metric}={format_log_value(value)}",
                flush=True,
            )
        return best, best_score

    while completed < total_steps:
        start_step = completed
        main_steps = min(interval_steps, total_steps - completed)
        lookahead_steps = min(cooldown_steps, total_steps - completed - main_steps)
        start_state = snapshot()

        def main_score(values, cooldown):
            restore(start_state)
            if not train_segment(values, main_steps, start_step, commit=False):
                return float("-inf")
            if cooldown is not None and lookahead_steps:
                if not train_segment(
                    dict(values, **cooldown),
                    lookahead_steps,
                    start_step + main_steps,
                    commit=False,
                ):
                    return float("-inf")
            return score()

        if start_step == 0 or not lookahead_steps:
            current, selected_score = search(
                current,
                choices,
                lambda values: main_score(values, None),
                initial=start_step == 0 and not global_search,
                phase="main",
                main_values=None,
                cooldown=None,
            )
        else:
            current, selected_score = search(
                current,
                {},
                lambda values: main_score(values, None),
                phase="baseline",
                initial=False,
                main_values=None,
                cooldown=None,
            )
        selected_cooldown = None
        while lookahead_steps:
            restore(start_state)
            if not train_segment(current, main_steps, start_step, commit=False):
                break
            cooldown_start = snapshot()
            cooldown_choices = {
                path: values
                for path, values in choices.items()
                if path.endswith(".initial_lr")
            }
            seed = {
                path: cooldown_values.get(path, current[path])
                for path in cooldown_choices
            }

            def cooldown_score(values):
                restore(cooldown_start)
                if not train_segment(
                    dict(current, **values),
                    lookahead_steps,
                    start_step + main_steps,
                    commit=False,
                ):
                    return float("-inf")
                return score()

            candidate_cooldown, candidate_score = search(
                seed,
                cooldown_choices,
                cooldown_score,
                phase="cooldown",
                main_values=current,
                initial=False,
                cooldown=None,
            )
            if candidate_score <= selected_score:
                break
            cooldown_values = selected_cooldown = candidate_cooldown
            selected_score = candidate_score
            candidate, candidate_score = search(
                current,
                choices,
                lambda values: main_score(values, selected_cooldown),
                cooldown=selected_cooldown,
                phase="main",
                initial=False,
                main_values=None,
            )
            if candidate_score <= selected_score:
                break
            current, selected_score = candidate, candidate_score

        if not isfinite(selected_score):
            raise RuntimeError(
                f"No finite candidate found at training step {start_step}"
            )
        log_event(
            "train_hparams",
            run=run,
            interval=len(history),
            start_step=start_step,
            completed_steps=main_steps,
            total_steps=total_steps,
            **current,
        )
        selected_schedules = segment_hparam_schedules(
            base_schedules, current, start_step, main_steps, global_search=global_search
        )
        log_event("train_schedules", run=run, interval=len(history))
        for path, lines in selected_schedules.items():
            print(f"  {path}: {json.dumps(lines)}", flush=True)
        restore(start_state)
        if not train_segment(current, main_steps, start_step, commit=True):
            raise RuntimeError(
                f"Selected training interval diverged at step {start_step}"
            )
        committed_score = score()
        log_event(
            "interval_boundary_eval",
            run=run,
            interval=len(history),
            step=completed,
            total_steps=total_steps,
            **{metric: committed_score},
        )
        history.append(
            dict(
                start_step=start_step,
                steps=main_steps,
                main_hparams=dict(current),
                cooldown_hparams=selected_cooldown,
                cooldown_steps=lookahead_steps,
                score=selected_score,
                hparam_schedules=selected_schedules,
            )
        )
        base_schedules = selected_schedules

    val_acc = evaluate(model, test_loader, tta_level=0)
    tta_val_acc = evaluate(model, test_loader, tta_level=2)
    if device.type == "cuda":
        torch.cuda.synchronize(device)
    seconds = time.perf_counter() - run_start
    log_final_eval(val_acc, tta_val_acc, seconds)
    return dict(
        val_acc=val_acc,
        tta_val_acc=tta_val_acc,
        seconds=seconds,
        batch_size=config["batch_size"],
        num_epochs=config["num_epochs"],
        overfit=config["overfit"],
        intervals=history,
        hparam_schedules=base_schedules,
        **{f"{group['name']}_lr": group["lr"] for group in optimizer.param_groups},
    )


def run_experiment(run, model, config):
    """Run one config or a search; return its best config, result, and trials."""
    config = normalize_config(config, key=None)
    require_fields(
        config,
        {"batch_size", "num_epochs", "overfit", "param_groups", "hparam_tuning"},
        "run config",
    )
    for group in config["param_groups"].values():
        GroupOptimizer.validate_group(group, runtime=False)
    tuning = config["hparam_tuning"]
    if tuning is not None:
        validate_tuning_config(tuning)
    if tuning is not None and tuning["algorithm"] in ("interval", "global_neighbour"):
        result = run_interval_search(run, model, config)
        return dict(
            best_config=config,
            best_result=result,
            trials=[dict(run=run, config=config, result=result)],
        )
    trials = []
    cache = {}
    metric = None if tuning is None else tuning["metric"]
    if metric is not None and metric not in ("val_acc", "tta_val_acc"):
        raise ValueError(f"Unknown tuning metric: {metric!r}")

    def evaluate_config(candidate):
        key = json.dumps(candidate, sort_keys=True)
        if key not in cache:
            trial_run = run if tuning is None else f"{run}.{len(trials)}"
            if tuning is not None:
                log_config_diff(trial_run, run, config, candidate)
            result = main(trial_run, model, **candidate, _log_config=tuning is None)
            if metric is not None and not isfinite(result[metric]):
                raise ValueError(f"Run {trial_run}: {metric} must be finite")
            trial = dict(run=trial_run, config=candidate, result=result)
            trials.append(trial)
            cache[key] = trial
        return cache[key]

    if tuning is None:
        best = evaluate_config(config)
    else:
        algorithm = tuning["algorithm"]
        if algorithm not in ("grid", "coordinate"):
            raise ValueError(f"Unknown tuning algorithm: {algorithm!r}")
        require_fields(tuning, {"algorithm", "metric", "params"}, "hparam_tuning")
        parameters = tuning_params(config)
        choices = {}
        for path, spec in parameters.items():
            values = spec["choices"]
            if not isinstance(values, (list, tuple)) or not values:
                raise ValueError(f"{path}: choices must be a nonempty list")
            # Values that coincide after rounding represent the same candidate.
            choices[path] = list(dict.fromkeys(values))

        log_config(run, config, label="base_config")
        if algorithm == "grid":
            best = None
            for values in product(*choices.values()):
                candidate = config
                for path, value in zip(choices, values):
                    candidate = with_hparam(candidate, path, value)
                trial = evaluate_config(candidate)
                if best is None or trial["result"][metric] > best["result"][metric]:
                    best = trial
        else:
            # Start inside the search space, preferring the configured values.
            current = config
            for path, values in choices.items():
                spec = parameters[path]
                value = spec["initial"]
                current = with_hparam(current, path, value)
            best = evaluate_config(current)
            locked = set()
            while len(locked) < len(choices):
                for path, values in choices.items():
                    if path in locked:
                        continue
                    previous_value = get_hparam(best["config"], path)
                    candidate_best = best
                    for value in values:
                        candidate = with_hparam(best["config"], path, value)
                        trial = evaluate_config(candidate)
                        # Keeping the incumbent on ties prevents cycling.
                        if trial["result"][metric] > candidate_best["result"][metric]:
                            candidate_best = trial
                    best = candidate_best
                    if get_hparam(best["config"], path) != previous_value:
                        locked.clear()
                    locked.add(path)

        log_event(
            "search_best",
            run=run,
            trial=best["run"],
            **{metric: best["result"][metric]},
        )
        log_changes("changes", flatten_config(config), flatten_config(best["config"]))

    return dict(best_config=best["config"], best_result=best["result"], trials=trials)


def main(
    run,
    model,
    batch_size,
    param_groups,
    num_epochs,
    overfit,
    hparam_tuning,
    _log_config,
):
    run_start = time.perf_counter()
    config = normalize_config(
        dict(
            batch_size=batch_size,
            num_epochs=num_epochs,
            overfit=overfit,
            param_groups=param_groups,
            hparam_tuning=hparam_tuning,
        ),
        key=None,
    )
    batch_size = config["batch_size"]
    num_epochs = config["num_epochs"]
    param_groups = config["param_groups"]
    if not isinstance(num_epochs, int) or num_epochs <= 0:
        raise ValueError("num_epochs must be a positive integer")
    if _log_config:
        log_config(run, config, label="config")
    set_training_seed()

    test_loader = CifarLoader(
        "cifar10", train=False, batch_size=2000, aug=dict(flip=False, translate=0)
    )
    train_loader = CifarLoader(
        "cifar10", train=True, batch_size=batch_size, aug=dict(flip=True, translate=2)
    )
    if run == "warmup":
        # The only purpose of the first run is to warmup the compiled model, so we can use dummy data
        train_loader.labels = torch.randint(
            0, 10, size=(len(train_loader.labels),), device=train_loader.labels.device
        )
    steps_per_epoch = 1 if overfit else len(train_loader)
    total_train_steps = num_epochs * steps_per_epoch
    schedules = configured_hparam_schedules(param_groups, total_train_steps)
    initial_lrs = {
        name: hparam_at_step(config["lr_scheduler"], 0)
        for name, config in param_groups.items()
    }

    optimizer = make_optimizer(model, param_groups)

    model.reset()
    step = 0

    # Initialize the whitening layer using training images
    if overfit:
        # Cache the first augmented batch once and reuse exactly these tensors.
        train_batches = (next(iter(train_loader)),)
        train_images = train_batches[0][0]
    else:
        train_batches = train_loader
        train_images = train_loader.normalized_images()[:5000]
    model.init_whiten(train_images, eps=0.0005)

    device = next(model.parameters()).device
    for epoch in range(num_epochs):
        ####################
        #     Training     #
        ####################

        model.train()
        for inputs, labels in train_batches:
            outputs = model(inputs)
            loss = F.cross_entropy(
                outputs, labels, label_smoothing=0.2, reduction="mean"
            )
            loss.backward()
            apply_hparam_schedules(optimizer, schedules, step)
            optimizer.step()
            optimizer.zero_grad(set_to_none=True)
            step += 1
            if step >= total_train_steps:
                break

        ####################
        #    Evaluation    #
        ####################

        val_acc = evaluate(model, test_loader, tta_level=0)

    ####################
    #  TTA Evaluation  #
    ####################

    tta_val_acc = evaluate(model, test_loader, tta_level=2)
    if device.type == "cuda":
        torch.cuda.synchronize(device)
    seconds = time.perf_counter() - run_start
    log_final_eval(val_acc, tta_val_acc, seconds)

    return dict(
        val_acc=val_acc,
        tta_val_acc=tta_val_acc,
        seconds=seconds,
        batch_size=batch_size,
        num_epochs=num_epochs,
        overfit=overfit,
        **{f"{name}_lr": lr for name, lr in initial_lrs.items()},
    )


if __name__ == "__main__":
    # We re-use the compiled model between runs to save the non-data-dependent compilation time
    set_training_seed()
    model = CifarNet().cuda().to(memory_format=torch.channels_last)
    # model.compile(mode="max-autotune")

    # main("warmup", model, **RUN_CONFIGS[0])
    for run, config in RUNS:
        run_experiment(run, model, config)


