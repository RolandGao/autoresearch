def _cuda_capability():
    if not torch.cuda.is_available():
        return (0, 0)
    return torch.cuda.get_device_capability(0)


CUDA_CAPABILITY = _cuda_capability()
IS_AMPERE_OR_NEWER = CUDA_CAPABILITY[0] >= 8
USE_CUDNN_BENCHMARK = False
USE_TF32 = IS_AMPERE_OR_NEWER

torch.backends.cudnn.benchmark = USE_CUDNN_BENCHMARK
torch.backends.cudnn.allow_tf32 = USE_TF32
torch.backends.cuda.matmul.allow_tf32 = USE_TF32

USE_COMPILED_MUON = False
MUON_DTYPE = torch.bfloat16
TRAINING_SEED = 0


def set_training_seed():
    torch.manual_seed(TRAINING_SEED)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(TRAINING_SEED)


def round_hparam(value):
    """Round numeric hyperparameters to two significant figures, preserving types."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return value
    rounded = float(f"{value:.2g}")
    return int(rounded) if isinstance(value, int) else rounded


#############################################
#                Optimizer                  #
#############################################


def zeropower_via_newtonschulz5(G, steps, eps):
    r"""
    Newton-Schulz iteration to compute the zeroth power / orthogonalization of G. We opt to use a
    quintic iteration whose coefficients are selected to maximize the slope at zero. For the purpose
    of minimizing steps, it turns out to be empirically effective to keep increasing the slope at
    zero even beyond the point where the iteration no longer converges all the way to one everywhere
    on the interval. This iteration therefore does not produce UV^T but rather something like US'V^T
    where S' is diagonal with S_{ii}' \sim Uniform(0.5, 1.5), which turns out not to hurt model
    performance at all relative to UV^T, where USV^T = G is the SVD.
    """
    assert len(G.shape) == 2
    a, b, c = (3.4445, -4.7750, 2.0315)
    X = G.to(MUON_DTYPE)
    X /= X.norm() + eps  # ensure top singular value <= 1
    if G.size(0) > G.size(1):
        X = X.T
    for _ in range(steps):
        A = X @ X.T
        B = b * A + c * A @ A
        X = a * X + B @ X
    if G.size(0) > G.size(1):
        X = X.T
    return X


if USE_COMPILED_MUON:
    zeropower_via_newtonschulz5 = torch.compile(zeropower_via_newtonschulz5)


INPUT_CONDITIONER_FIELDS = {
    "svd_mean_percentage_damping",
    "input_conditioner_momentum",
}
ALGORITHM_FIELDS = {
    "sgd": set(),
    "muon": {"ns_steps", "ns_eps"},
    "sgdh": {"normalization_eps"},
    "input_conditioned": INPUT_CONDITIONER_FIELDS,
}


def require_fields(values, required, label):
    missing, extra = required - values.keys(), values.keys() - required
    if missing or extra:
        raise ValueError(
            f"{label}: missing fields {sorted(missing)}; unexpected fields {sorted(extra)}"
        )


def input_conditioner_options(group):
    options = {}
    for name in INPUT_CONDITIONER_FIELDS:
        if name not in group:
            raise ValueError(f"input_conditioned: missing required field {name}")
        value = group[name]
        if (
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not isfinite(value)
        ):
            raise ValueError(f"{name} must be a finite number")
        value = round_hparam(value)
        if name == "input_conditioner_momentum" and not 0 <= value < 1:
            raise ValueError("input_conditioner_momentum must be in [0, 1)")
        if value < 0:
            raise ValueError(f"{name} must be nonnegative")
        options[name] = value
    return options


class GroupOptimizer(torch.optim.Optimizer):
    """Apply SGD, Muon, SGDH, or an input-conditioned update per group."""

    def __init__(self, param_groups):
        for group in param_groups:
            self.validate_group(group, runtime=True)
        super().__init__(param_groups, defaults={})
        self._input_covariances = {}
        for group in self.param_groups:
            group["lr"] = round_hparam(group["lr"])
            group["momentum"] = round_hparam(group["momentum"])
            name = group["name"]
            if group["algorithm"] not in ("sgd", "muon", "sgdh", "input_conditioned"):
                raise ValueError(f"{name}: unknown algorithm {group['algorithm']!r}")
            if group["lr"] < 0:
                raise ValueError(f"{name}: learning rate must be nonnegative")
            if group["momentum"] < 0:
                raise ValueError(f"{name}: momentum must be nonnegative")
            if (
                group["algorithm"] in ("sgd", "input_conditioned")
                and group["nesterov"]
                and group["momentum"] <= 0
            ):
                raise ValueError(f"{name}: Nesterov requires positive momentum")
            if group["algorithm"] in ("muon", "sgdh") and any(
                p.ndim < 2 for p in group["params"]
            ):
                raise ValueError(
                    f"{name}: {group['algorithm']} requires parameters with at least 2 dimensions"
                )
            if group["algorithm"] == "input_conditioned" and any(
                p.ndim != 2 for p in group["params"]
            ):
                raise ValueError(
                    f"{name}: input_conditioned currently supports linear weight matrices"
                )
            if group["algorithm"] == "input_conditioned":
                group.update(input_conditioner_options(group))

    @staticmethod
    def validate_group(group, runtime):
        if "algorithm" not in group or group["algorithm"] not in ALGORITHM_FIELDS:
            raise ValueError("Optimizer group requires a known algorithm")
        required = {"algorithm", "momentum", "nesterov"} | ALGORITHM_FIELDS[
            group["algorithm"]
        ]
        required |= {"name", "params", "lr"} if runtime else {"lr_scheduler"}
        require_fields(group, required, f"{group['algorithm']} group")
        if not isinstance(group["nesterov"], bool):
            raise ValueError("nesterov must be a boolean")
        if (
            group["algorithm"] in ("sgd", "input_conditioned")
            and group["nesterov"]
            and group["momentum"] == 0
        ):
            raise ValueError("Nesterov requires positive momentum")
        fields = ({"lr", "momentum"} if runtime else {"momentum"}) | (
            ALGORITHM_FIELDS[group["algorithm"]] - {"ns_steps"}
        )
        for field in fields:
            value = group[field]
            if (
                isinstance(value, bool)
                or not isinstance(value, (int, float))
                or not isfinite(value)
                or value < 0
            ):
                raise ValueError(f"{field} must be a nonnegative finite number")
        if group["algorithm"] == "muon":
            steps = group["ns_steps"]
            if isinstance(steps, bool) or not isinstance(steps, int) or steps <= 0:
                raise ValueError("ns_steps must be a positive integer")
        if group["algorithm"] == "sgdh" and group["normalization_eps"] <= 0:
            raise ValueError("normalization_eps must be positive")
        if group["algorithm"] == "input_conditioned":
            input_conditioner_options(group)

    @torch.no_grad()
    def record_input(self, parameter, inputs):
        """Record X.T @ X / N for a weight matrix stored as [outputs, inputs]."""
        if (
            inputs.ndim != 2
            or inputs.shape[0] == 0
            or inputs.shape[1] != parameter.shape[1]
        ):
            raise ValueError(
                "input_conditioned expects a nonempty N x D input matching the weight's input dimension"
            )
        dtype = torch.float64 if inputs.dtype == torch.float64 else torch.float32
        with torch.autocast(device_type=inputs.device.type, enabled=False):
            x = inputs.detach().to(dtype)
            self._input_covariances[parameter] = (x.T @ x) / len(x)

    def bind_input_layers(self, model):
        """Attach input capture to selected Linear weights; replace hooks from earlier runs."""
        for handle in getattr(model, "_input_conditioned_hooks", []):
            handle.remove()
        model._input_conditioned_hooks = []
        modules = {
            module.weight: module
            for module in model.modules()
            if isinstance(module, nn.Linear)
        }
        selected = [
            p
            for group in self.param_groups
            if group["algorithm"] == "input_conditioned"
            for p in group["params"]
        ]
        if any(p not in modules for p in selected):
            raise ValueError(
                "input_conditioned input capture currently supports nn.Linear weights only"
            )

        def capture(module, args):
            # Validation also uses model.train(), so check autograd as well.
            if module.training and torch.is_grad_enabled():
                self.record_input(module.weight, args[0])

        for parameter in selected:
            model._input_conditioned_hooks.append(
                modules[parameter].register_forward_pre_hook(capture)
            )

    def zero_grad(self, set_to_none):
        super().zero_grad(set_to_none=set_to_none)
        self._input_covariances.clear()

    def load_state_dict(self, state_dict):
        for group in state_dict["param_groups"]:
            self.validate_group(group, runtime=True)
        result = super().load_state_dict(state_dict)
        # Optimizer loading casts floating state to the parameter dtype. Restore
        # the covariance EMA separately to preserve FP32 with FP16 weights, and
        # give it independent storage so updates cannot modify the checkpoint.
        for group, saved_group in zip(self.param_groups, state_dict["param_groups"]):
            for parameter, index in zip(group["params"], saved_group["params"]):
                covariance = state_dict["state"].get(index, {}).get("input_covariance")
                if covariance is not None:
                    self.state[parameter]["input_covariance"] = covariance.to(
                        parameter.device
                    ).clone()
        # The current batch's covariance is transient; only its EMA is checkpointed.
        self._input_covariances.clear()
        return result

    @torch.no_grad()
    def step(self):
        for group in self.param_groups:
            lr = group["lr"] = round_hparam(group["lr"])
            momentum = group["momentum"]
            if group["algorithm"] == "input_conditioned":
                group.update(input_conditioner_options(group))
            for p in group["params"]:
                g = p.grad
                if g is None:
                    continue
                covariance = None
                if group["algorithm"] == "input_conditioned":
                    covariance = self._input_covariances.pop(p, None)
                    if lr != 0 and covariance is None:
                        raise RuntimeError(
                            "input_conditioned needs inputs from the current training forward"
                        )
                    if covariance is not None:
                        state = self.state[p]
                        if "input_covariance" not in state:
                            state["input_covariance"] = covariance.clone()
                        else:
                            beta = group["input_conditioner_momentum"]
                            state["input_covariance"].mul_(beta).add_(
                                covariance, alpha=1 - beta
                            )
                        covariance = state["input_covariance"]
                if momentum or group["algorithm"] in ("muon", "sgdh"):
                    state = self.state[p]
                    if "momentum_buffer" not in state:
                        state["momentum_buffer"] = g.clone()
                    elif momentum == 0:
                        # Zero momentum uses the raw gradient and clears old history.
                        state["momentum_buffer"].copy_(g)
                    else:
                        state["momentum_buffer"].mul_(momentum).add_(g)
                    buf = state["momentum_buffer"]
                    g = (
                        g.add(buf, alpha=momentum)
                        if group["nesterov"] and momentum
                        else buf
                    )

                # A zero learning rate must leave weights unchanged for every algorithm.
                if lr == 0:
                    self._input_covariances.pop(p, None)
                    continue
                if group["algorithm"] == "muon":
                    p.mul_(len(p) ** 0.5 / p.norm())  # normalize the weight
                    g = zeropower_via_newtonschulz5(
                        g.reshape(len(g), -1),
                        steps=group["ns_steps"],
                        eps=group["ns_eps"],
                    ).view(g.shape)  # whiten the update
                elif group["algorithm"] == "sgdh":
                    # Without Nesterov (or at zero momentum), g aliases the buffer.
                    # Normalize a working copy so future steps retain raw momentum.
                    if g is self.state[p]["momentum_buffer"]:
                        g = g.clone()
                    channel_dims = tuple(range(1, p.ndim))
                    p.div_(
                        p.norm(p=2, dim=channel_dims, keepdim=True).clamp_min_(
                            group["normalization_eps"]
                        )
                    )
                    g.div_(
                        g.norm(p=2, dim=channel_dims, keepdim=True).clamp_min_(
                            group["normalization_eps"]
                        )
                    )
                elif group["algorithm"] == "input_conditioned":
                    with torch.autocast(device_type=p.device.type, enabled=False):
                        alpha = group["svd_mean_percentage_damping"]
                        if alpha == 0:
                            # Explicitly disabling damping retains the pseudoinverse.
                            g = (
                                g.to(covariance.dtype)
                                @ torch.linalg.pinv(covariance, hermitian=True)
                            ).to(g.dtype)
                        else:
                            # alpha is a fraction of the mean covariance eigenvalue.
                            damping = alpha * covariance.diagonal().mean()
                            if damping > 0:
                                damped = covariance.clone()
                                damped.diagonal().add_(damping)
                                g = torch.linalg.solve(
                                    damped, g.to(covariance.dtype).T
                                ).T.to(g.dtype)
                            else:
                                # Zero inputs give zero covariance and zero pseudoinverse.
                                g = torch.zeros_like(g)
                p.add_(g, alpha=-lr)


#############################################
#                DataLoader                 #
#############################################

CIFAR_MEAN = torch.tensor((0.4914, 0.4822, 0.4465))
CIFAR_STD = torch.tensor((0.2470, 0.2435, 0.2616))


def batch_flip_lr(inputs):
    flip_mask = (torch.rand(len(inputs), device=inputs.device) < 0.5).view(-1, 1, 1, 1)
    return torch.where(flip_mask, inputs.flip(-1), inputs)


def batch_crop(images, crop_size):
    r = (images.size(-1) - crop_size) // 2
    shifts = torch.randint(-r, r + 1, size=(len(images), 2), device=images.device)
    y = torch.arange(crop_size, device=images.device).view(1, crop_size, 1)
    x = torch.arange(crop_size, device=images.device).view(1, 1, crop_size)
    y_idx = y + (r + shifts[:, 0]).view(-1, 1, 1)
    x_idx = x + (r + shifts[:, 1]).view(-1, 1, 1)
    gathered_rows = images.gather(
        2, y_idx[:, None, :, :].expand(-1, images.size(1), -1, images.size(-1))
    )
    return gathered_rows.gather(
        3, x_idx[:, None, :, :].expand(-1, images.size(1), crop_size, crop_size)
    )


class CifarLoader:
    def __init__(self, path, train, batch_size, aug):
        data_path = os.path.join(path, "train.pt" if train else "test.pt")
        if not os.path.exists(data_path):
            dset = torchvision.datasets.CIFAR10(path, download=True, train=train)
            images = torch.tensor(dset.data)
            labels = torch.tensor(dset.targets)
            torch.save(
                {"images": images, "labels": labels, "classes": dset.classes}, data_path
            )

        data = torch.load(data_path, map_location=torch.device("cuda"))
        self.images, self.labels, self.classes = (
            data["images"],
            data["labels"],
            data["classes"],
        )
        # It's faster to load+process uint8 data than to load preprocessed data
        self.images = (
            (self.images.float() / 255)
            .permute(0, 3, 1, 2)
            .to(memory_format=torch.channels_last)
        )

        self.normalize = T.Normalize(CIFAR_MEAN, CIFAR_STD)
        self.proc_images = {}  # Saved results of image processing to be done on the first epoch
        self.epoch = 0

        require_fields(aug, {"flip", "translate"}, "augmentation")
        self.aug = aug

        self.batch_size = batch_size
        self.drop_last = train
        self.shuffle = train

    def _ensure_proc_images(self):
        if "norm" in self.proc_images:
            return
        images = self.proc_images["norm"] = self.normalize(self.images)
        if self.aug["flip"]:
            images = self.proc_images["flip"] = batch_flip_lr(images)
        pad = self.aug["translate"]
        if pad > 0:
            self.proc_images["pad"] = F.pad(images, (pad,) * 4, "reflect")

    def normalized_images(self):
        self._ensure_proc_images()
        return self.proc_images["norm"]

    def __len__(self):
        return (
            len(self.images) // self.batch_size
            if self.drop_last
            else ceil(len(self.images) / self.batch_size)
        )

    def prepare_epoch(self):
        if self.epoch == 0:
            self._ensure_proc_images()

        if self.aug["translate"] > 0:
            images = batch_crop(self.proc_images["pad"], self.images.shape[-2])
        elif self.aug["flip"]:
            images = self.proc_images["flip"]
        else:
            images = self.proc_images["norm"]
        # Flip all images together every other epoch. This increases diversity relative to random flipping
        if self.aug["flip"]:
            if self.epoch % 2 == 1:
                images = images.flip(-1)

        self.epoch += 1

        return images

    def epoch_indices(self, images):
        return (torch.randperm if self.shuffle else torch.arange)(
            len(images), device=images.device
        )

    def __iter__(self):
        images = self.prepare_epoch()
        indices = self.epoch_indices(images)
        for i in range(len(self)):
            idxs = indices[i * self.batch_size : (i + 1) * self.batch_size]
            yield (images[idxs], self.labels[idxs])


class TrainingBatchStream:
    """A replayable batch cursor; epoch tensors are immutable and shared by snapshots."""

    def __init__(self, loader, fixed_batch):
        self.loader = loader
        self.fixed_batch = fixed_batch
        self.images = self.indices = None
        self.batch_index = 0

    def next_batch(self):
        if self.fixed_batch is not None:
            return self.fixed_batch
        if self.images is None or self.batch_index == len(self.loader):
            self.images = self.loader.prepare_epoch()
            self.indices = self.loader.epoch_indices(self.images)
            self.batch_index = 0
        start = self.batch_index * self.loader.batch_size
        indices = self.indices[start : start + self.loader.batch_size]
        self.batch_index += 1
        return self.images[indices], self.loader.labels[indices]

    def state_dict(self):
        return self.images, self.indices, self.batch_index, self.loader.epoch

    def load_state_dict(self, state):
        self.images, self.indices, self.batch_index, self.loader.epoch = state


#############################################
#            Network Definition             #
#############################################


# note the use of low BatchNorm stats momentum
class BatchNorm(nn.BatchNorm2d):
    def __init__(self, num_features, momentum, eps):
        super().__init__(num_features, eps=eps, momentum=1 - momentum)
        # Note that PyTorch already initializes the weights to one and bias to zero


class Conv(nn.Conv2d):
    def __init__(self, in_channels, out_channels):
        super().__init__(
            in_channels, out_channels, kernel_size=3, padding="same", bias=False
        )

    def reset_parameters(self):
        super().reset_parameters()
        w = self.weight.data
        torch.nn.init.dirac_(w[: w.size(1)])


class ConvGroup(nn.Module):
    def __init__(self, channels_in, channels_out):
        super().__init__()
        self.conv1 = Conv(channels_in, channels_out)
        self.pool = nn.MaxPool2d(2)
        self.norm1 = BatchNorm(channels_out, momentum=0.6, eps=1e-12)
        self.conv2 = Conv(channels_out, channels_out)
        self.norm2 = BatchNorm(channels_out, momentum=0.6, eps=1e-12)
        self.activ = nn.GELU()

    def forward(self, x):
        x = self.conv1(x)
        x = self.pool(x)
        x = self.norm1(x)
        x = self.activ(x)
        x = self.conv2(x)
        x = self.norm2(x)
        x = self.activ(x)
        return x


class CifarNet(nn.Module):
    def __init__(self):
        super().__init__()
        widths = dict(block1=64, block2=256, block3=256)
        whiten_kernel_size = 2
        whiten_width = 2 * 3 * whiten_kernel_size**2
        self.whiten = nn.Conv2d(
            3, whiten_width, whiten_kernel_size, padding=0, bias=True
        )
        self.layers = nn.Sequential(
            nn.GELU(),
            ConvGroup(whiten_width, widths["block1"]),
            ConvGroup(widths["block1"], widths["block2"]),
            ConvGroup(widths["block2"], widths["block3"]),
            nn.MaxPool2d(3),
        )
        self.head = nn.Linear(widths["block3"], 10, bias=False)
        for mod in self.modules():
            mod.float()

    def reset(self):
        for m in self.modules():
            if type(m) in (nn.Conv2d, Conv, BatchNorm, nn.Linear):
                m.reset_parameters()
        w = self.head.weight.data
        w *= 1 / w.std()

    def init_whiten(self, train_images, eps):
        c, (h, w) = train_images.shape[1], self.whiten.weight.shape[2:]
        patches = (
            train_images.unfold(2, h, 1)
            .unfold(3, w, 1)
            .transpose(1, 3)
            .reshape(-1, c, h, w)
            .float()
        )
        patches_flat = patches.view(len(patches), -1)
        est_patch_covariance = (patches_flat.T @ patches_flat) / len(patches_flat)
        eigenvalues, eigenvectors = torch.linalg.eigh(est_patch_covariance, UPLO="U")
        eigenvectors_scaled = eigenvectors.T.reshape(-1, c, h, w) / torch.sqrt(
            eigenvalues.view(-1, 1, 1, 1) + eps
        )
        self.whiten.weight.data[:] = torch.cat(
            (eigenvectors_scaled, -eigenvectors_scaled)
        )

    def forward(self, x):
        x = self.whiten(x)
        x = self.layers(x)
        x = x.view(len(x), -1)
        return self.head(x) / x.size(-1)


############################################
#                 Logging                  #
############################################


def log_config(run, config, label):
    def compact_json(value):
        return json.dumps(value)

    entries = []
    for name, value in config.items():
        if (
            name in ("param_groups", "hparam_tuning")
            and isinstance(value, dict)
            and value
        ):
            rows = [
                f"    {json.dumps(key)}: {compact_json(item)}"
                for key, item in value.items()
            ]
            formatted = "{\n" + ",\n".join(rows) + "\n  }"
        else:
            formatted = compact_json(value)
        entries.append(f"  {json.dumps(name)}: {formatted}")
    print(f"{label} run={run}", flush=True)
    print("{\n" + ",\n".join(entries) + "\n}", flush=True)


def format_log_value(value):
    if isinstance(value, float):
        return f"{value:.6g}"
    if isinstance(value, (dict, list, tuple, bool)) or value is None:
        return json.dumps(value)
    return str(value)


def log_event(event, **fields):
    print(
        " ".join(
            [
                event,
                *(f"{key}={format_log_value(value)}" for key, value in fields.items()),
            ]
        ),
        flush=True,
    )


def hparam_text(values):
    return " ".join(
        f"{name}={format_log_value(value)}" for name, value in values.items()
    )


def flatten_config(config):
    """Readable group paths, with complete segment lists for scheduler changes."""
    plain = json.loads(json.dumps(config))
    values = {}

    def visit(value, path):
        if isinstance(value, dict) and value:
            for name, item in value.items():
                visit(item, f"{path}.{name}" if path else name)
        else:
            name = path.removeprefix("param_groups.").replace(".lr_scheduler.", ".")
            values[name] = value

    visit(plain, "")
    return values


def log_changes(label, base, current):
    changes = {
        name: (base.get(name, "<unset>"), value)
        for name, value in current.items()
        if base.get(name, "<unset>") != value
    }
    print(f"  {label}:" if changes else f"  {label}: (none)", flush=True)
    for name, (old, new) in changes.items():
        print(
            f"    {name}: {format_log_value(old)} -> {format_log_value(new)}",
            flush=True,
        )


def log_config_diff(run, base_run, base, config):
    log_event("config_diff", run=run, base_run=base_run)
    log_changes("changes", flatten_config(base), flatten_config(config))


def log_final_eval(val_acc, tta_val_acc, seconds):
    print(
        f"val_acc={val_acc:.4f} tta_val_acc={tta_val_acc:.4f} seconds={seconds:.4f}",
        flush=True,
    )


############################################
#               Evaluation                 #
############################################


def infer(model, loader, tta_level):

    # Test-time augmentation strategy (for tta_level=2):
    # 1. Flip/mirror the image left-to-right (50% of the time).
    # 2. Translate the image by one pixel either up-and-left or down-and-right (50% of the time,
    #    i.e. both happen 25% of the time).
    #
    # This creates 6 views per image (left/right times the two translations and no-translation),
    # which we evaluate and then weight according to the given probabilities.

    def infer_basic(inputs, net):
        return net(inputs).clone()

    def infer_mirror(inputs, net):
        return 0.5 * net(inputs) + 0.5 * net(inputs.flip(-1))

    def infer_mirror_translate(inputs, net):
        logits = infer_mirror(inputs, net)
        pad = 1
        padded_inputs = F.pad(inputs, (pad,) * 4, "reflect")
        inputs_translate_list = [
            padded_inputs[:, :, 0:32, 0:32],
            padded_inputs[:, :, 2:34, 2:34],
        ]
        logits_translate_list = [
            infer_mirror(inputs_translate, net)
            for inputs_translate in inputs_translate_list
        ]
        logits_translate = torch.stack(logits_translate_list).mean(0)
        return 0.5 * logits + 0.5 * logits_translate

    model.train()
    test_images = loader.normalized_images()
    infer_fn = [infer_basic, infer_mirror, infer_mirror_translate][tta_level]
    with torch.inference_mode():
        return torch.cat(
            [infer_fn(inputs, model) for inputs in test_images.split(2000)]
        )


def evaluate(model, loader, tta_level):
    logits = infer(model, loader, tta_level)
    return (logits.argmax(1) == loader.labels).float().mean().item()


############################################
#                Training                  #
############################################


def normalize_schedule(lines, total_steps, name):
    """Validate durations without rounding them; round only segment values."""
    if not isinstance(lines, (list, tuple)) or not lines:
        raise ValueError(f"{name}: expected a nonempty list of segments")
    result = []
    for line in lines:
        if not isinstance(line, (list, tuple)) or len(line) not in (2, 3):
            raise ValueError(
                f"{name}: segments must be (num_steps, value) or (num_steps, start, end)"
            )
        steps, *values = line
        if isinstance(steps, bool) or not isinstance(steps, int) or steps <= 0:
            raise ValueError(f"{name}: num_steps must be a positive integer")
        if any(
            isinstance(value, bool)
            or not isinstance(value, (int, float))
            or not isfinite(value)
            or value < 0
            for value in values
        ):
            raise ValueError(
                f"{name}: segment values must be nonnegative finite numbers"
            )
        result.append((steps, *(round_hparam(value) for value in values)))
    duration = sum(line[0] for line in result)
    if total_steps is not None and duration != total_steps:
        raise ValueError(
            f"{name}: segment num_steps sum to {duration}, expected total_steps={total_steps}"
        )
    return result


def hparam_at_step(lines, step):
    """Interpolate a piecewise linear schedule, rounding each applied value."""
    for line in lines:
        steps, start = line[:2]
        if 0 <= step < steps:
            if len(line) == 2:
                return round_hparam(start)
            # Linear endpoints are inclusive; a one-step line uses its end.
            if steps == 1:
                return round_hparam(line[2])
            fraction = step / (steps - 1)
            return round_hparam(start * (1 - fraction) + line[2] * fraction)
        step -= steps
    raise ValueError("Step is outside the hyperparameter schedule")


def configured_hparam_schedules(param_groups, total_steps):
    """Every LR and momentum schedule covers the complete run."""
    schedules = {}
    for name, group in param_groups.items():
        schedules[f"{name}.initial_lr"] = normalize_schedule(
            group["lr_scheduler"], total_steps, f"{name}.lr_scheduler"
        )
        for field in (
            "momentum",
            "nesterov",
            *sorted(ALGORITHM_FIELDS[group["algorithm"]]),
        ):
            schedules[f"{name}.{field}"] = [(total_steps, group[field])]
    return schedules


def slice_schedule(lines, start_step, end_step):
    """Copy a window as duration-based segments; end_step is exclusive."""
    result = []
    offset = 0
    for line in lines:
        steps = line[0]
        start, end = max(start_step, offset), min(end_step, offset + steps)
        if start < end:
            if len(line) == 2:
                result.append((end - start, line[1]))
            else:
                result.append(
                    (
                        end - start,
                        hparam_at_step([line], start - offset),
                        hparam_at_step([line], end - offset - 1),
                    )
                )
        offset += steps
    return result


def scale_lr_schedule(lines, initial):
    """Change the LR amplitude while retaining the explicitly configured shape."""
    previous = lines[0][1]
    if previous:
        return [
            (line[0], *(round_hparam(v * initial / previous) for v in line[1:]))
            for line in lines
        ]
    result = copy.deepcopy(lines)
    result[0] = (result[0][0], initial, *result[0][2:])
    return result


def lr_decay_schedule(steps, initial, decay):
    if decay == "constant":
        return [(steps, initial)]
    if decay == "linear_decay":
        return [(steps, initial, 0.0)]
    raise ValueError(f"Unknown LR decay: {decay!r}")


def segment_hparam_schedules(base_schedules, values, start_step, steps, global_search):
    """Expand search parameters into complete schedules, preserving unsearched fields."""
    schedules = copy.deepcopy(base_schedules)
    for path, lines in schedules.items():
        decay_path = path.removesuffix("initial_lr") + "decay"
        if (
            global_search
            and path.endswith(".initial_lr")
            and (path in values or decay_path in values)
        ):
            if start_step != 0 or steps != sum(line[0] for line in lines):
                raise ValueError("global_neighbour requires one full-run interval")
            initial = values[path] if path in values else lines[0][1]
            schedules[path] = (
                lr_decay_schedule(steps, initial, values[decay_path])
                if decay_path in values
                else scale_lr_schedule(lines, initial)
            )
            continue
        if path in values:
            total_steps = sum(line[0] for line in lines)
            if start_step < 0 or steps <= 0 or start_step + steps > total_steps:
                raise ValueError("Search interval is outside the configured schedule")
            value = round_hparam(values[path])
            line = (steps, value)
            schedules[path] = (
                slice_schedule(lines, 0, start_step)
                + [line]
                + slice_schedule(lines, start_step + steps, total_steps)
            )
    return schedules


def apply_hparam_schedules(optimizer, schedules, step):
    for group in optimizer.param_groups:
        name = group["name"]
        group["lr"] = hparam_at_step(schedules[f"{name}.initial_lr"], step)
        for field in (
            "momentum",
            "nesterov",
            *sorted(ALGORITHM_FIELDS[group["algorithm"]]),
        ):
            group[field] = hparam_at_step(schedules[f"{name}.{field}"], step)


# Set hparam_tuning to, for example:
# dict(algorithm="grid", metric="tta_val_acc", params={
#     "conv.initial_lr": dict(initial=0.04, choices=[0.04, 0.06, 0.08]),
#     "conv.momentum": dict(initial=0.6, choices=[0.6, 0.7, 0.8]),
# })
# Use algorithm="coordinate" to tune parameters in order, revisiting them
# whenever another parameter changes. Specify the selection metric explicitly.
# None runs the config once without tuning. Batch sizes are kept exact.
# For online search, use:
# dict(algorithm="interval", metric="tta_val_acc", max_side_steps=20,
#      initial_dropoff_margin=0.02, interval_steps=40, cooldown_steps=40, params={
#     "conv.initial_lr": dict(initial=1.0, choices=None, mult=0.8),
#     "conv.momentum": dict(initial=0.6, choices=[0.0, 0.1, 0.3, 0.6, 0.9, 0.95, 0.99]),
# })
# Each params entry contains a tuning-only initial value and its choices.
# Every entry must specify initial and choices. Grid evaluates choices exhaustively;
# Coordinate searches start at initial, even when it is not a listed choice.
# Multiplicative LR entries must specify mult; grids use round2(mult**k).
# Multiplicative LR starts snap to k = round(log(initial) / log(mult)).
# Explicit choice lists do not take mult. The legacy parameters shorthand is rejected.
# Interval search holds searched LRs constant within each segment; unsearched
# groups keep their configured schedules. Explicit lists also work for LR choices.
# Use algorithm="global_neighbour" with the same params mapping for one
# full-run interval. LR exposes initial_lr and decay (constant or linear_decay).
# Scalar hyperparameters stay constant throughout the run.
# Unsearched parameters always retain their configured schedules in every algorithm.
# It takes no interval_steps/cooldown_steps and skips the initial LR margin search.
# All schedulers use [(num_steps, value), (num_steps, start, end), ...].
# Linear endpoints include the first and last update; one-step lines use the end.
# Durations must sum to num_epochs * (50000 // batch_size), or num_epochs in overfit mode.
# Change the segment durations when changing the batch size or run length.
# input_conditioned groups accept svd_mean_percentage_damping (0.01 = 1% damping)
# and input_conditioner_momentum (covariance EMA beta; 0 = current batch).
# Both are required. Muon requires ns_steps/ns_eps; SGDH requires normalization_eps.
# Conditioner settings can be searched using explicit choices in hparam_tuning.params.
