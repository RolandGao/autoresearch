        RUN_CONFIGS[f"auto_a_s036_cont_{tag}_bs{batch_size}"] = auto_config(
            batch_size, "a", None, None, larger_within=within)
# Lookahead to the end of the run (cooldown_fraction=1): removes the short-horizon bias in
# the fidelity probe (writeup section 4).
AUTO_REST = {"rest_s013": 0.13, "rest_s022": 0.22, "rest_ssearch": "search", "rest_lin": "linear"}
for batch_size in (2000, 500, 125):
    for name, searched_mult in AUTO_REST.items():
        RUN_CONFIGS[f"auto_a_{name}_bs{batch_size}"] = auto_config(
            batch_size, "a", None, None, cooldown_searched=searched_mult, cooldown_fraction=1)
# Staircase baselines: each group's schedule replaced by n constant steps at the exact mean
# of its configured schedule over each step (grid: snapped to the x0.6 grid). Measures what
# piecewise-constant intervals cost by themselves.
for batch_size in (2000, 500, 125):
    for scenario, names in (("a", ("conv",)), ("b", TRAINED_LR_GROUPS)):
        for n in (5, 10, 20):
            for snap in (False, True):
                config = copy.deepcopy(RUN_CONFIGS[f"baseline_bs{batch_size}"])
                for name in names:
                    lines = config["param_groups"][name]["lr_scheduler"]
                    total = sum(line[0] for line in lines)
                    bounds = [total * i // n for i in range(n + 1)]
                    means = [sum(schedule_value_at_step(lines, s) for s in range(a, b)) / (b - a)
                             for a, b in zip(bounds, bounds[1:])]
                    config["param_groups"][name]["lr_scheduler"] = [
                        (b - a, round_hparam(0.6 ** round(log(m) / log(0.6))) if snap and m
                         else round_hparam(m))
                        for a, b, m in zip(bounds, bounds[1:], means)
                    ]
                RUN_CONFIGS[f"staircase_{scenario}_n{n}{'_grid' if snap else ''}_bs{batch_size}"] = config
# Why 5-step staircases lose: the final anneal or the steps themselves? (conv, BS 2000)
STAIRCASE_TESTS = {
    # Staircase means, but the last interval decays linearly with the same mean (0.045 -> 0).
    "lastlin": [(40, 0.2), (40, 0.15), (40, 0.11), (40, 0.067), (40, 0.045, 0.0)],
    # Staircase means with the baseline's exact last interval (0.044 -> 0).
    "lastexact": [(40, 0.2), (40, 0.15), (40, 0.11), (40, 0.067), (40, 0.044, 0.0)],
    # Staircase means, but a small constant last step (is it the anneal, or the last value?).
    "last001": [(40, 0.2), (40, 0.15), (40, 0.11), (40, 0.067), (40, 0.01)],
    "last00036": [(40, 0.2), (40, 0.15), (40, 0.11), (40, 0.067), (40, 0.0036)],
    # Piecewise linear through grid-snapped knots of the baseline (0.22 .. 0).
    "knots_grid": [(40, 0.22, 0.22), (40, 0.22, 0.13), (40, 0.13, 0.078), (40, 0.078, 0.047),
                   (40, 0.047, 0.0)],
}
