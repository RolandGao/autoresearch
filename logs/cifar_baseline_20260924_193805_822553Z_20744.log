def constant_lr_scheduler(initial_lr):
    initial_lr = round_hparam(initial_lr)

    def schedule(step, steps_per_epoch):
        return initial_lr

    schedule.config = dict(type="constant", initial_lr=initial_lr)
    return schedule


def linear_lr_scheduler(initial_lr, decay_epochs):
    """Return a scheduler(step, steps_per_epoch) that decays to zero."""
    initial_lr = round_hparam(initial_lr)
    decay_epochs = round_hparam(decay_epochs)
    if decay_epochs <= 0:
        raise ValueError("decay_epochs must be positive")

    def schedule(step, steps_per_epoch):
        return round_hparam(
            initial_lr * max(0.0, 1 - step / (decay_epochs * steps_per_epoch))
        )

    schedule.config = dict(type="linear", initial_lr=initial_lr, decay_epochs=decay_epochs)
    return schedule


