# Compare the current interval search with shorter cooldowns and shorter intervals.
INTERVAL_RUN_CONFIGS = []
for base_config in BASE_RUN_CONFIGS:
    if base_config["batch_size"] not in (500, 125):
        continue
    for interval_divisor, cooldown_divisor in ((1, 1), (1, 4), (4, 4)):
        config = copy.deepcopy(base_config)
        config["hparam_tuning"]["interval_steps"] //= interval_divisor
        config["hparam_tuning"]["cooldown_steps"] //= cooldown_divisor
        INTERVAL_RUN_CONFIGS.append(config)

