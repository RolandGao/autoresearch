def _cuda_capability():
    if not torch.cuda.is_available():
        return (0, 0)
    return torch.cuda.get_device_capability(0)


CUDA_CAPABILITY = _cuda_capability()
IS_AMPERE_OR_NEWER = CUDA_CAPABILITY[0] >= 8
USE_CUDNN_BENCHMARK = False
USE_TF32 = IS_AMPERE_OR_NEWER

torch.backends.cudnn.benchmark = USE_CUDNN_BENCHMARK
torch.backends.cudnn.allow_tf32 = USE_TF32
torch.backends.cuda.matmul.allow_tf32 = USE_TF32

USE_COMPILED_MUON = False
MUON_DTYPE = torch.bfloat16
TRAINING_SEED = 0


def set_training_seed():
    torch.manual_seed(TRAINING_SEED)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(TRAINING_SEED)


def round_hparam(value):
    """Round numeric hyperparameters to two significant figures, preserving types."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return value
    rounded = float(f"{value:.2g}")
    return int(rounded) if isinstance(value, int) else rounded


#############################################
#                Optimizer                  #
#############################################


def zeropower_via_newtonschulz5(G, steps=3, eps=0):
    r"""
    Newton-Schulz iteration to compute the zeroth power / orthogonalization of G. We opt to use a
    quintic iteration whose coefficients are selected to maximize the slope at zero. For the purpose
    of minimizing steps, it turns out to be empirically effective to keep increasing the slope at
    zero even beyond the point where the iteration no longer converges all the way to one everywhere
    on the interval. This iteration therefore does not produce UV^T but rather something like US'V^T
    where S' is diagonal with S_{ii}' \sim Uniform(0.5, 1.5), which turns out not to hurt model
    performance at all relative to UV^T, where USV^T = G is the SVD.
    """
    assert len(G.shape) == 2
    a, b, c = (3.4445, -4.7750, 2.0315)
    X = G.to(MUON_DTYPE)
    X /= X.norm() + eps  # ensure top singular value <= 1
    if G.size(0) > G.size(1):
        X = X.T
    for _ in range(steps):
        A = X @ X.T
        B = b * A + c * A @ A
        X = a * X + B @ X
    if G.size(0) > G.size(1):
        X = X.T
    return X


if USE_COMPILED_MUON:
    zeropower_via_newtonschulz5 = torch.compile(zeropower_via_newtonschulz5)


class GroupOptimizer(torch.optim.Optimizer):
    """Apply each parameter group's configured SGD or Muon update."""

    def __init__(self, param_groups):
        super().__init__(param_groups, defaults={})
        for group in self.param_groups:
            group["lr"] = round_hparam(group["lr"])
            group["momentum"] = round_hparam(group["momentum"])
            name = group.get("name", "parameter group")
            if group["algorithm"] not in ("sgd", "muon"):
                raise ValueError(f"{name}: unknown algorithm {group['algorithm']!r}")
            if group["lr"] < 0:
                raise ValueError(f"{name}: learning rate must be nonnegative")
            if group["momentum"] < 0:
                raise ValueError(f"{name}: momentum must be nonnegative")
            if group["algorithm"] == "sgd" and group["nesterov"] and group["momentum"] <= 0:
                raise ValueError(f"{name}: Nesterov requires positive momentum")
            if group["algorithm"] == "muon" and any(
                p.ndim < 2 for p in group["params"]
            ):
                raise ValueError(f"{name}: Muon requires parameters with at least 2 dimensions")

    @torch.no_grad()
    def step(self):
        for group in self.param_groups:
            lr = group["lr"] = round_hparam(group["lr"])
            momentum = group["momentum"]
            for p in group["params"]:
                g = p.grad
                if g is None:
                    continue
                if momentum or group["algorithm"] == "muon":
                    state = self.state[p]
                    if "momentum_buffer" not in state:
                        state["momentum_buffer"] = g.clone()
                    elif momentum == 0:
                        # Zero momentum uses the raw gradient and clears old history.
                        state["momentum_buffer"].copy_(g)
                    else:
                        state["momentum_buffer"].mul_(momentum).add_(g)
                    buf = state["momentum_buffer"]
                    g = g.add(buf, alpha=momentum) if group["nesterov"] and momentum else buf

                # A zero learning rate must leave weights unchanged for either algorithm.
                if lr == 0:
                    continue
                if group["algorithm"] == "muon":
                    p.mul_(len(p) ** 0.5 / p.norm())  # normalize the weight
                    g = zeropower_via_newtonschulz5(g.reshape(len(g), -1)).view(
                        g.shape
                    )  # whiten the update
                p.add_(g, alpha=-lr)


#############################################
#                DataLoader                 #
#############################################

CIFAR_MEAN = torch.tensor((0.4914, 0.4822, 0.4465))
CIFAR_STD = torch.tensor((0.2470, 0.2435, 0.2616))


def batch_flip_lr(inputs):
    flip_mask = (torch.rand(len(inputs), device=inputs.device) < 0.5).view(-1, 1, 1, 1)
    return torch.where(flip_mask, inputs.flip(-1), inputs)


def batch_crop(images, crop_size):
    r = (images.size(-1) - crop_size) // 2
    shifts = torch.randint(-r, r + 1, size=(len(images), 2), device=images.device)
    y = torch.arange(crop_size, device=images.device).view(1, crop_size, 1)
    x = torch.arange(crop_size, device=images.device).view(1, 1, crop_size)
    y_idx = y + (r + shifts[:, 0]).view(-1, 1, 1)
    x_idx = x + (r + shifts[:, 1]).view(-1, 1, 1)
    gathered_rows = images.gather(
        2, y_idx[:, None, :, :].expand(-1, images.size(1), -1, images.size(-1))
    )
    return gathered_rows.gather(
        3, x_idx[:, None, :, :].expand(-1, images.size(1), crop_size, crop_size)
    )


class CifarLoader:
    def __init__(self, path, train=True, batch_size=500, aug=None):
        data_path = os.path.join(path, "train.pt" if train else "test.pt")
        if not os.path.exists(data_path):
            dset = torchvision.datasets.CIFAR10(path, download=True, train=train)
            images = torch.tensor(dset.data)
            labels = torch.tensor(dset.targets)
            torch.save(
                {"images": images, "labels": labels, "classes": dset.classes}, data_path
            )

        data = torch.load(data_path, map_location=torch.device("cuda"))
        self.images, self.labels, self.classes = (
            data["images"],
            data["labels"],
            data["classes"],
        )
        # It's faster to load+process uint8 data than to load preprocessed data
        self.images = (
            (self.images.float() / 255)
            .permute(0, 3, 1, 2)
            .to(memory_format=torch.channels_last)
        )

        self.normalize = T.Normalize(CIFAR_MEAN, CIFAR_STD)
        self.proc_images = {}  # Saved results of image processing to be done on the first epoch
        self.epoch = 0

        self.aug = aug or {}
        for k in self.aug.keys():
            assert k in ["flip", "translate"], "Unrecognized key: %s" % k

        self.batch_size = batch_size
        self.drop_last = train
        self.shuffle = train

    def _ensure_proc_images(self):
        if "norm" in self.proc_images:
            return
        images = self.proc_images["norm"] = self.normalize(self.images)
        if self.aug.get("flip", False):
            images = self.proc_images["flip"] = batch_flip_lr(images)
        pad = self.aug.get("translate", 0)
        if pad > 0:
            self.proc_images["pad"] = F.pad(images, (pad,) * 4, "reflect")

    def normalized_images(self):
        self._ensure_proc_images()
        return self.proc_images["norm"]

    def __len__(self):
        return (
            len(self.images) // self.batch_size
            if self.drop_last
            else ceil(len(self.images) / self.batch_size)
        )

    def prepare_epoch(self):
        if self.epoch == 0:
            self._ensure_proc_images()

        if self.aug.get("translate", 0) > 0:
            images = batch_crop(self.proc_images["pad"], self.images.shape[-2])
        elif self.aug.get("flip", False):
            images = self.proc_images["flip"]
        else:
            images = self.proc_images["norm"]
        # Flip all images together every other epoch. This increases diversity relative to random flipping
        if self.aug.get("flip", False):
            if self.epoch % 2 == 1:
                images = images.flip(-1)

        self.epoch += 1

        return images

    def epoch_indices(self, images):
        return (torch.randperm if self.shuffle else torch.arange)(
            len(images), device=images.device
        )

    def __iter__(self):
        images = self.prepare_epoch()
        indices = self.epoch_indices(images)
        for i in range(len(self)):
            idxs = indices[i * self.batch_size : (i + 1) * self.batch_size]
            yield (images[idxs], self.labels[idxs])


class TrainingBatchStream:
    """A replayable batch cursor; epoch tensors are immutable and shared by snapshots."""

    def __init__(self, loader, fixed_batch=None):
        self.loader = loader
        self.fixed_batch = fixed_batch
        self.images = self.indices = None
        self.batch_index = 0

    def next_batch(self):
        if self.fixed_batch is not None:
            return self.fixed_batch
        if self.images is None or self.batch_index == len(self.loader):
            self.images = self.loader.prepare_epoch()
            self.indices = self.loader.epoch_indices(self.images)
            self.batch_index = 0
        start = self.batch_index * self.loader.batch_size
        indices = self.indices[start:start + self.loader.batch_size]
        self.batch_index += 1
        return self.images[indices], self.loader.labels[indices]

    def state_dict(self):
        return self.images, self.indices, self.batch_index, self.loader.epoch

    def load_state_dict(self, state):
        self.images, self.indices, self.batch_index, self.loader.epoch = state


#############################################
#            Network Definition             #
#############################################


# note the use of low BatchNorm stats momentum
class BatchNorm(nn.BatchNorm2d):
    def __init__(self, num_features, momentum=0.6, eps=1e-12):
        super().__init__(num_features, eps=eps, momentum=1 - momentum)
        # Note that PyTorch already initializes the weights to one and bias to zero


class Conv(nn.Conv2d):
    def __init__(self, in_channels, out_channels):
        super().__init__(
            in_channels, out_channels, kernel_size=3, padding="same", bias=False
        )

    def reset_parameters(self):
        super().reset_parameters()
        w = self.weight.data
        torch.nn.init.dirac_(w[: w.size(1)])


class ConvGroup(nn.Module):
    def __init__(self, channels_in, channels_out):
        super().__init__()
        self.conv1 = Conv(channels_in, channels_out)
        self.pool = nn.MaxPool2d(2)
        self.norm1 = BatchNorm(channels_out)
        self.conv2 = Conv(channels_out, channels_out)
        self.norm2 = BatchNorm(channels_out)
        self.activ = nn.GELU()

    def forward(self, x):
        x = self.conv1(x)
        x = self.pool(x)
        x = self.norm1(x)
        x = self.activ(x)
        x = self.conv2(x)
        x = self.norm2(x)
        x = self.activ(x)
        return x


class CifarNet(nn.Module):
    def __init__(self):
        super().__init__()
        widths = dict(block1=64, block2=256, block3=256)
        whiten_kernel_size = 2
        whiten_width = 2 * 3 * whiten_kernel_size**2
        self.whiten = nn.Conv2d(
            3, whiten_width, whiten_kernel_size, padding=0, bias=True
        )
        self.layers = nn.Sequential(
            nn.GELU(),
            ConvGroup(whiten_width, widths["block1"]),
            ConvGroup(widths["block1"], widths["block2"]),
            ConvGroup(widths["block2"], widths["block3"]),
            nn.MaxPool2d(3),
        )
        self.head = nn.Linear(widths["block3"], 10, bias=False)
        for mod in self.modules():
            mod.float()

    def reset(self):
        for m in self.modules():
            if type(m) in (nn.Conv2d, Conv, BatchNorm, nn.Linear):
                m.reset_parameters()
        w = self.head.weight.data
        w *= 1 / w.std()

    def init_whiten(self, train_images, eps=5e-4):
        c, (h, w) = train_images.shape[1], self.whiten.weight.shape[2:]
        patches = (
            train_images.unfold(2, h, 1)
            .unfold(3, w, 1)
            .transpose(1, 3)
            .reshape(-1, c, h, w)
            .float()
        )
        patches_flat = patches.view(len(patches), -1)
        est_patch_covariance = (patches_flat.T @ patches_flat) / len(patches_flat)
        eigenvalues, eigenvectors = torch.linalg.eigh(est_patch_covariance, UPLO="U")
        eigenvectors_scaled = eigenvectors.T.reshape(-1, c, h, w) / torch.sqrt(
            eigenvalues.view(-1, 1, 1, 1) + eps
        )
        self.whiten.weight.data[:] = torch.cat(
            (eigenvectors_scaled, -eigenvectors_scaled)
        )

    def forward(self, x):
        x = self.whiten(x)
        x = self.layers(x)
        x = x.view(len(x), -1)
        return self.head(x) / x.size(-1)


############################################
#                 Logging                  #
############################################


def log_config(run, config, label="config"):
    def compact_json(value):
        return json.dumps(value, default=lambda schedule: schedule.config)

    entries = []
    for name, value in config.items():
        if name in ("param_groups", "hparam_tuning") and isinstance(value, dict) and value:
            rows = [f"    {json.dumps(key)}: {compact_json(item)}"
                    for key, item in value.items()]
            formatted = "{\n" + ",\n".join(rows) + "\n  }"
        else:
            formatted = compact_json(value)
        entries.append(f"  {json.dumps(name)}: {formatted}")
    print(f"{label} run={run}", flush=True)
    print("{\n" + ",\n".join(entries) + "\n}", flush=True)


def format_log_value(value):
    if isinstance(value, float):
        return f"{value:.6g}"
    if isinstance(value, (dict, list, tuple, bool)) or value is None:
        return json.dumps(value)
    return str(value)


def log_event(event, **fields):
    print(" ".join([event, *(f"{key}={format_log_value(value)}"
                             for key, value in fields.items())]), flush=True)


def hparam_text(values):
    return " ".join(f"{name}={format_log_value(value)}" for name, value in values.items())


def flatten_config(config):
    """Readable paths, including conv.initial_lr instead of scheduler internals."""
    plain = json.loads(json.dumps(config, default=lambda schedule: schedule.config))
    values = {}

    def visit(value, path):
        if isinstance(value, dict) and value:
            for name, item in value.items():
                visit(item, f"{path}.{name}" if path else name)
        else:
            name = path.removeprefix("param_groups.").replace(".lr_scheduler.", ".")
            values[name] = value

    visit(plain, "")
    return values


def log_changes(label, base, current):
    changes = {name: (base.get(name, "<unset>"), value)
               for name, value in current.items() if base.get(name, "<unset>") != value}
    print(f"  {label}:" if changes else f"  {label}: (none)", flush=True)
    for name, (old, new) in changes.items():
        print(f"    {name}: {format_log_value(old)} -> {format_log_value(new)}", flush=True)


def log_config_diff(run, base_run, base, config):
    log_event("config_diff", run=run, base_run=base_run)
    log_changes("changes", flatten_config(base), flatten_config(config))


def log_final_eval(val_acc, tta_val_acc, seconds):
    print(
        f"val_acc={val_acc:.4f} tta_val_acc={tta_val_acc:.4f} seconds={seconds:.4f}",
        flush=True,
    )


############################################
#               Evaluation                 #
############################################


def infer(model, loader, tta_level=0):

    # Test-time augmentation strategy (for tta_level=2):
    # 1. Flip/mirror the image left-to-right (50% of the time).
    # 2. Translate the image by one pixel either up-and-left or down-and-right (50% of the time,
    #    i.e. both happen 25% of the time).
    #
    # This creates 6 views per image (left/right times the two translations and no-translation),
    # which we evaluate and then weight according to the given probabilities.

    def infer_basic(inputs, net):
        return net(inputs).clone()

    def infer_mirror(inputs, net):
        return 0.5 * net(inputs) + 0.5 * net(inputs.flip(-1))

    def infer_mirror_translate(inputs, net):
        logits = infer_mirror(inputs, net)
        pad = 1
        padded_inputs = F.pad(inputs, (pad,) * 4, "reflect")
        inputs_translate_list = [
            padded_inputs[:, :, 0:32, 0:32],
            padded_inputs[:, :, 2:34, 2:34],
        ]
        logits_translate_list = [
            infer_mirror(inputs_translate, net)
            for inputs_translate in inputs_translate_list
        ]
        logits_translate = torch.stack(logits_translate_list).mean(0)
        return 0.5 * logits + 0.5 * logits_translate

    model.train()
    test_images = loader.normalized_images()
    infer_fn = [infer_basic, infer_mirror, infer_mirror_translate][tta_level]
    with torch.inference_mode():
        return torch.cat(
            [infer_fn(inputs, model) for inputs in test_images.split(2000)]
        )


def evaluate(model, loader, tta_level=0):
    logits = infer(model, loader, tta_level)
    return (logits.argmax(1) == loader.labels).float().mean().item()


############################################
#                Training                  #
############################################

def constant_lr_scheduler(initial_lr):
    initial_lr = round_hparam(initial_lr)

    def schedule(step, steps_per_epoch):
        return initial_lr

    schedule.config = dict(type="constant", initial_lr=initial_lr)
    return schedule


def linear_lr_scheduler(initial_lr, decay_epochs):
    """Return a scheduler(step, steps_per_epoch) that decays to zero."""
    initial_lr = round_hparam(initial_lr)
    decay_epochs = round_hparam(decay_epochs)
    if decay_epochs <= 0:
        raise ValueError("decay_epochs must be positive")

    def schedule(step, steps_per_epoch):
        return round_hparam(
            initial_lr * max(0.0, 1 - step / (decay_epochs * steps_per_epoch))
        )

    schedule.config = dict(type="linear", initial_lr=initial_lr, decay_epochs=decay_epochs)
    return schedule


def hparam_line(start_step, end_step, start, end):
    """A line includes both endpoint steps; adjacent lines may jump in value."""
    if end_step < start_step:
        raise ValueError("A hyperparameter line must end at or after its start")
    return dict(start_step=start_step, end_step=end_step,
                start=round_hparam(start), end=round_hparam(end))


def hparam_at_step(lines, step):
    """Interpolate a piecewise linear schedule, rounding each applied value."""
    if not lines:
        raise ValueError("A hyperparameter schedule needs at least one line")
    for line in lines:
        if line["start_step"] <= step <= line["end_step"]:
            width = line["end_step"] - line["start_step"]
            # A one-step segment uses its end value (zero for a one-step decay).
            if width == 0 or step == line["end_step"]:
                return round_hparam(line["end"])
            if line["start"] == line["end"]:
                return round_hparam(line["start"])
            fraction = (step - line["start_step"]) / width
            return round_hparam(line["start"] * (1 - fraction) + line["end"] * fraction)
    if step < lines[0]["start_step"]:
        return round_hparam(lines[0]["start"])
    if step > lines[-1]["end_step"]:
        return round_hparam(lines[-1]["end"])
    raise ValueError(f"No hyperparameter line covers step {step}")


def configured_hparam_schedules(param_groups, steps_per_epoch, total_steps):
    """Convert existing config schedulers and momenta to lists of lines."""
    schedules = {}
    for name, group in param_groups.items():
        scheduler = group["lr_scheduler"].config
        initial_lr = scheduler["initial_lr"]
        if scheduler["type"] == "linear":
            # Preserve the existing scheduler's zero point and hold zero afterward.
            decay_steps = scheduler["decay_epochs"] * steps_per_epoch
            lines = [hparam_line(0, decay_steps, initial_lr, 0.0)]
            if decay_steps < total_steps - 1:
                lines.append(hparam_line(decay_steps, total_steps - 1, 0.0, 0.0))
        elif scheduler["type"] == "constant":
            lines = [hparam_line(0, total_steps - 1, initial_lr, initial_lr)]
        else:
            raise ValueError(f"Unknown scheduler type: {scheduler['type']!r}")
        schedules[f"{name}.initial_lr"] = lines
        schedules[f"{name}.momentum"] = [
            hparam_line(0, total_steps - 1, group["momentum"], group["momentum"])]
    return schedules


def segment_hparam_schedules(base_schedules, values, start_step, steps, linear_decay=False):
    """Bind searched values to linked endpoints, or to starts with LR ends fixed at zero."""
    schedules = copy.deepcopy(base_schedules)
    for path, lines in schedules.items():
        if path in values:
            start = values[path]
            end = 0.0 if linear_decay and path.endswith(".initial_lr") else start
            schedules[path] = [hparam_line(start_step, start_step + steps - 1, start, end)]
    return schedules


def apply_hparam_schedules(optimizer, schedules, step):
    for group in optimizer.param_groups:
        name = group["name"]
        group["lr"] = hparam_at_step(schedules[f"{name}.initial_lr"], step)
        group["momentum"] = hparam_at_step(schedules[f"{name}.momentum"], step)


# Set hparam_tuning to, for example:
# dict(algorithm="grid", metric="tta_val_acc", params={
#     "conv.initial_lr": dict(initial=0.04, choices=[0.04, 0.06, 0.08]),
#     "conv.momentum": dict(initial=0.6, choices=[0.6, 0.7, 0.8]),
# })
# Use algorithm="coordinate" to tune parameters in order, revisiting them
# whenever another parameter changes. Selection defaults to tta_val_acc.
# None runs the config once without tuning. Batch sizes are kept exact.
# For online search, use:
# dict(algorithm="interval", interval_steps=40, cooldown_steps=40, params={
#     "conv.initial_lr": dict(initial=1.0, choices=None, mult=0.8),
#     "conv.momentum": dict(initial=0.6, choices=[0.0, 0.1, 0.3, 0.6, 0.9, 0.95, 0.99]),
# })
# Each params entry contains a tuning-only initial value and its choices.
# Omitting initial uses the baseline value. Grid evaluates choices exhaustively;
# Coordinate searches start at initial, even when it is not a listed choice.
# LR mult defaults to 0.6; interval grids use round2(1.0 * mult**k) per parameter.
# Multiplicative LR starts snap to k = round(log(initial) / log(mult)).
# Explicit choices take precedence over mult. Legacy lr_factor remains a fallback.
# Interval search holds searched LRs constant within each segment; unsearched
# groups keep their configured schedules. Lists also work for interval LR choices.
# Use algorithm="interval_linear" with the same params mapping for one
# full-run interval: searched LRs decay to zero, searched momenta stay constant.
# Unsearched parameters always retain their configured schedules in every algorithm.
# It ignores interval_steps/cooldown_steps and skips the initial LR margin search.
# Both variants train from schedules of [{start_step, end_step, start, end}, ...].
run_type = "interval_linear"  # "baseline", "interval", or "interval_linear"

BASE_RUN_CONFIGS = [
    dict(
        batch_size=125,
        num_epochs=8,
